{
  "name": "asj-portal-v2",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "serve": "node server.cjs",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "typecheck:indexer": "tsc -p tsconfig.indexer.json --noEmit",
    "idx:build": "tsc -p tsconfig.indexer.json",
    "idx": "npm run idx:build && node indexer/dist/indexer/src/cli.js",
    "icons": "node scripts/build-icon-sprite.mjs",
    "depcruise": "depcruise netlify/functions --config .dependency-cruiser.cjs --output-type err",
    "boundary": "npm run idx:build && node indexer/dist/indexer/src/cli.js violations",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/test-public.mjs",
    "typecheck:ratchet": "node scripts/ci/typecheck-ratchet.mjs",
    "typecheck:baseline": "node scripts/ci/typecheck-ratchet.mjs --update-baseline",
    "verify:env": "node scripts/ci/verify-env.mjs",
    "verify:db": "node scripts/ci/verify-migrations.mjs",
    "verify:db:warn": "node scripts/ci/verify-migrations.mjs --warn-only",
    "verify:binding": "node scripts/ci/surface-binding.mjs",
    "verify:io": "node scripts/ci/io-boundary.mjs",
    "verify:aliases": "node scripts/ci/verify-aliases.mjs",
    "bundle:size": "node scripts/ci/bundle-size.mjs",
    "bundle:baseline": "node scripts/ci/bundle-size.mjs --update-baseline",
    "smoke": "node scripts/ci/smoke-test.mjs",
    "ci:quality": "npm run typecheck:ratchet && npm run typecheck:indexer && npm run boundary && npm run verify:binding && npm run verify:io && npm run bundle:size && npm run test && npm run idx:gate",
    "ci:predeploy": "npm run verify:env && npm run verify:db && npm run verify:binding && npm run verify:io && npm run bundle:size",
    "migrate": "node scripts/migrate.mjs status",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:baseline": "node scripts/migrate.mjs baseline",
    "idx:impact": "node indexer/dist/indexer/src/cli.js impact",
    "idx:gate": "npm run idx:build && node indexer/scripts/impact-gate.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.5",
    "@astrojs/preact": "4.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.0.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "5.12.0",
    "@fontsource/inter": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "mammoth": "^1.12.2",
    "nanostores": "0.11.0",
    "pdf-parse": "^2.4.5",
    "preact": "10.24.3",
    "react-hook-form": "^7.87.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
