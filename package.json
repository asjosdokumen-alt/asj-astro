{
  "name": "asj-portal-v2",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/build-sw-manifest.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "serve": "node server.cjs",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "typecheck:indexer": "tsc -p tsconfig.indexer.json --noEmit",
    "idx:build": "tsc -p tsconfig.indexer.json",
    "idx": "npm run idx:build && node indexer/dist/indexer/src/cli.js",
    "icons": "node scripts/build-icon-sprite.mjs",
    "depcruise": "depcruise netlify/functions --config .dependency-cruiser.cjs --output-type err",
    "boundary": "npm run idx:build && node indexer/dist/indexer/src/cli.js violations",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run e2e:public && npm run e2e:loker-layout && npm run e2e:headings && npm run e2e:dialog && npm run e2e:drawer && npm run e2e:labels",
    "e2e:public": "node e2e/test-public.mjs",
    "e2e:loker-layout": "node e2e/test-loker-layout.mjs",
    "e2e:headings": "node e2e/test-headings.mjs",
    "e2e:dialog": "node e2e/test-dialog.mjs",
    "e2e:drawer": "node e2e/test-drawer.mjs",
    "e2e:labels": "node e2e/test-labels.mjs",
    "typecheck:ratchet": "node scripts/ci/typecheck-ratchet.mjs",
    "typecheck:baseline": "node scripts/ci/typecheck-ratchet.mjs --update-baseline",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint-ratchet": "node scripts/ci/lint-ratchet.mjs",
    "lint:baseline": "node scripts/ci/lint-ratchet.mjs --update-baseline",
    "review:gate": "node scripts/ci/review-gate.mjs",
    "review:gate:full": "node scripts/ci/review-gate.mjs --full",
    "verify:batteries": "node scripts/ci/run-batteries.mjs",
    "verify:batteries:list": "node scripts/ci/run-batteries.mjs --list",
    "verify:review-manifest": "node scripts/ci/verify-review-manifest.mjs",
    "verify:env": "node scripts/ci/verify-env.mjs",
    "verify:env:local": "node scripts/ci/env-audit.local.mjs",
    "verify:env:resolve": "node --experimental-strip-types scripts/ci/env-resolve.local.mjs",
    "verify:env:validate": "node --experimental-strip-types scripts/ci/env-validate.local.mjs",
    "verify:db": "node scripts/ci/verify-migrations.mjs",
    "verify:db:warn": "node scripts/ci/verify-migrations.mjs --warn-only",
    "verify:schema": "node scripts/ci/gen-schema.mjs --check",
    "db:schema": "node scripts/ci/gen-schema.mjs",
    "verify:projections": "node scripts/ci/verify-projections.mjs",
    "verify:rls": "node scripts/ci/verify-rls.mjs",
    "verify:binding": "node scripts/ci/surface-binding.mjs",
    "verify:io": "node scripts/ci/io-boundary.mjs",
    "verify:validation": "node scripts/ci/verify-validation-coverage.mjs",
    "verify:md": "node scripts/ci/check-md-tables.mjs",
    "verify:classes": "node scripts/ci/verify-classes.mjs",
    "cold:start": "node scripts/ci/cold-start-gate.mjs",
    "verify:aliases": "node scripts/ci/verify-aliases.mjs",
    "verify:env:local:all": "npm run verify:env:local && npm run verify:env:resolve && npm run verify:env:validate",
    "bundle:size": "node scripts/ci/bundle-size.mjs",
    "bundle:baseline": "node scripts/ci/bundle-size.mjs --update-baseline",
    "smoke": "node scripts/ci/smoke-test.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ci:quality": "npm run typecheck:ratchet && npm run typecheck:indexer && npm run boundary && npm run lint-ratchet && npm run verify:binding && npm run verify:entries && npm run verify:io && npm run verify:validation && npm run verify:md && npm run verify:classes && npm run verify:projections && npm run verify:review-manifest && npm run bundle:size && npm run cold:start && npm run test && npm run idx:gate",
    "ci:predeploy:local": "npm run verify:env -- --profile build && npm run verify:db && npm run verify:schema && npm run verify:rls && npm run verify:binding && npm run verify:io && npm run verify:projections && npm run bundle:size && npm run verify:pwa",
    "migrate": "node scripts/migrate.mjs status",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:baseline": "node scripts/migrate.mjs baseline",
    "idx:impact": "node indexer/dist/indexer/src/cli.js impact",
    "idx:gate": "npm run idx:build && node indexer/scripts/impact-gate.mjs",
    "icons:pwa": "node scripts/build-pwa-icons.mjs",
    "verify:pwa": "node scripts/ci/verify-pwa.mjs",
    "verify:entries": "node scripts/ci/verify-function-entries.mjs",
    "verify:env:budget": "node scripts/ci/verify-env.mjs --profile production --budget",
    "verify:settings-limit": "vitest run netlify/functions/_lib/db/settings-limit.test.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.5",
    "@astrojs/preact": "4.0.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.0.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "5.12.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "mammoth": "^1.12.2",
    "nanostores": "0.11.0",
    "pdf-parse": "^2.4.5",
    "preact": "10.24.3",
    "react-hook-form": "^7.87.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "dependency-cruiser": "^18.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
