# ─── Environment template — SHAPE ONLY, never real values ────────────────────
#
# Copy to `.env.local` (preferred) or `.env.lokal` and fill in real values.
# Both of those are gitignored; THIS file is committed, so it must never hold a
# secret. Adding a new env var? It belongs here AND in scripts/ci/verify-env.mjs
# (see .github/PULL_REQUEST_TEMPLATE.md).
#
# Precedence, highest first (see scripts/lib/load-env.mjs):
#   process.env  >  .env.local  >  .env.lokal  >  .env
#
# Local checks:
#   npm run verify:env -- --profile build    # must pass on a dev machine
#   npm run verify:env:local:all             # key presence, resolution, shape
#   npm run verify:db                        # DB contract (needs service_role)

# ── ⚠️ TRAP 1: a space in a key name makes the line UNPARSEABLE ──────────────
# Both loaders match /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=/ — no
# spaces, no dashes. So a line like `service_role secret=…` is SILENTLY SKIPPED:
# the value is unreachable by any lookup and still leaks in any line dump.
#
# Found in this repo's real env files on 2026-09-12: two space-named keys plus 18
# bare value lines, none of them visible to the runtime loader. Cleaned up.
#
# The ONE alias that legitimately works is case-insensitive and deliberate:
#     Direct_Connection_DB  ->  the Postgres connection string
# `lookupEnv()` lower-cases both sides and DB_URL_ALIASES lists it, so any casing
# resolves. New files should prefer the canonical SUPABASE_DB_URL form.
#
# `repo921` also appears in the old env files. It is referenced NOWHERE in the
# codebase and is not whitelisted by the runtime loader — treat it as dead.
#
# ── ⚠️ TRAP 2: bare value lines with no `KEY=` ───────────────────────────────
# Leftovers from pasting the Netlify env table. Never `source` those files, and
# never redact them with `sed 's/=.*/…/'` — it produces unreadable output.

# ─── Supabase (Client-side — PUBLIC_ prefix for Astro) ──
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase (Server-side — Netlify Functions) ──────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── Postgres connection — DB SCRIPTS ONLY, not the function runtime ─────────
# The function runtime never opens a Postgres connection (all access is HTTPS ->
# PostgREST), so this is needed only by migrate.mjs / db-baseline.mjs / verify:db.
#
# Use the Supavisor POOLER on port 6543. The direct host
# `db.<ref>.supabase.co:5432` has no A record and fails with ENOTFOUND; the
# loader upgrades a direct URL to the pooler automatically, but pasting the
# pooler form directly saves confusion.
#
# Prefer this canonical name. The legacy `Direct_Connection_DB` spelling also
# resolves (case-insensitively) and is still present in older env files.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# The raw DB password on its own. Nothing reads it — the connection string above
# carries it — but it is listed so a paste that loses the key name has an obvious
# home rather than becoming an unreachable bare value line.
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# ─── Netlify (for CLI deploy) ────────────────────────
# CI/deploy only — deliberately absent from the env files, which is why
# `verify:env --profile production --strict` cannot pass on a dev machine.
NETLIFY_AUTH_TOKEN=your-netlify-token-here
NETLIFY_SITE_ID=your-netlify-site-id-here
GEMINI_API_KEY=your-gemini-api-key-here
ADMIN_MASTER_PIN=your-admin-pin-here
ADMIN_NUMBERS=628123456789,628987654321

# ─── Session Signing (REQUIRED in production) ────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-char-hex-secret-here

# ─── AI providers ────────────────────────────────────
XAI_API_KEY=your-xai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

FONNTE_TOKEN=your-fonnte-token-here
NETLIFY_SITE_URL=https://your-site.netlify.app/
SUPABASE_STORAGE_BUCKET=your-storage-bucket

# ─── Admin PINs ──────────────────────────────────────
# Keys must not contain spaces: `PIN MASTER=123456` is not a valid environment
# variable name — dotenv parsers either skip it or treat `PIN` as the name.
# This template previously shipped a real-looking 6-digit master PIN; if 123456
# was ever used on a live account, rotate it.
PIN_MASTER=your-pin-here
PIN_SACHOU=your-pin-here
PIN_AYOK=your-pin-here
PIN_KHOLIS=your-pin-here
PIN_KHOCI=your-pin-here

# ─── Cloudinary ──────────────────────────────────────
# Uploads are UNSIGNED and browser-side, so neither value is read by a module
# today — they are whitelisted in verify-env.mjs for completeness. New uploads
# go to Cloudinary; the legacy Supabase bucket is deliberately not migrated, so
# old files keep rendering.
CLOUDINARY_URL=cloudinary://your-api-key@your-cloud-name
CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/your-cloud-name/upload

# ─── Firebase (push notifications) ───────────────────
# Production reads the whole service account from this single JSON value.
# Locally you may instead drop the key at
# netlify/functions/secrets/firebase-service-account.json — resolution is
# FILE FIRST, env second, and a file whose client_email/private_key are merely
# non-empty WINS over this variable. A placeholder there silently breaks push.
# Prove a key by exchanging a JWT at oauth2.googleapis.com/token (expect 200),
# never by its byte length. Shape: netlify/functions/secrets/README.md
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"}
# Legacy, effectively unused — kept so the name is not reused for something else.
# FIREBASE_SERVICE_TOKEN=

# ─── Security / Allow-lists ──────────────────────────
ALLOWED_DOCUMENT_HOSTS=res.cloudinary.com,storage.googleapis.com

# ─── Phase C observability (all optional) ────────────
# health.js answers 503 — never 200 — when HEALTH_TOKEN is unconfigured: fail
# closed on purpose. See docs/PHASE_C_SINK_SETUP.md.
HEALTH_TOKEN=your-health-probe-token-here
# Destination 1: your own receiver. It receives the repo's own payload shape
# (counters/histograms/gauges) — see §1 of PHASE_C_SINK_SETUP.md.
METRICS_SINK_URL=
METRICS_SINK_TOKEN=
METRICS_RECEIVER_TOKEN=
METRICS_NOTIFY_URL=
# Destination 2: Grafana Cloud, over OTLP. Independent of the sink above —
# setting one, the other, both, or neither are all valid.
#   GRAFANA_CLOUD_OTLP_ENDPOINT is the gateway base, e.g.
#     https://otlp-gateway-prod-ap-southeast-2.grafana.net/otlp
#     (the exporter appends /v1/metrics itself)
#   GRAFANA_CLOUD_BASIC_AUTH_HEADER is the WHOLE header value, e.g.
#     Basic <base64 of "1828153:<grafana.com API key>">
#   Build it with:
#     printf '%s' '<instanceID>:<api-key>' | base64
#   It is a credential: set it in the Netlify UI, never commit it. A literal
#   "Basic base64(...)" placeholder is detected and refused at runtime rather
#   than sent as a 401 that looks like a revoked key.
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_BASIC_AUTH_HEADER=
