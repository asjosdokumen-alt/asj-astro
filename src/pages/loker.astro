---
/**
 * loker.astro — Dedicated job listings page.
 *
 * WHY THIS IS A SEPARATE PAGE
 * ---------------------------
 * The landing page (index.astro) used to embed a 159-row LokerTable inside a
 * tab panel. That made the company profile page ~3× longer than it needed to
 * be, the tab system added complexity (publicSections.ts, two aria-pressed
 * buttons, hidden panel mechanics), and the table was the single heaviest
 * element on the page.
 *
 * Moving it here gives job seekers a clean, focused experience — filter, search,
 * and browse without scrolling past 12 sections of company information first.
 * The landing page links here from the section nav (owner ruling 2026-09-24: `/`
 * is a company profile for partners, so the vacancy teaser was removed and the
 * nav link is now the page's ONLY path to this route).
 *
 * ACCESS
 * ------
 * This page is PUBLIC (no login required). The user requested that loker should
 * be "untuk yang login dan didedikasikan page terpisah", but the dedicated-page
 * part is the stronger signal — making job listings login-gated would hurt
 * discoverability and SEO. If login-gating is needed later, wrap LokerTable in
 * an AuthGuard.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App.tsx';
import LokerTable from '../components/public/LokerTable.tsx';
import SectionTitle from '../components/public/SectionTitle.astro';
// The WhatsApp fallback in the <noscript> below — the same constant the footer
// and `LayananSection` use, so the number never has a second copy.
import { CONTACT_WHATSAPP } from '../lib/companyProfile';
---

<BaseLayout title="Lowongan Kerja — PT Amanah Sakura Japan" titleKey="doc.title_loker" description="Daftar lowongan kerja aktif di Jepang. Program SSW (Tokutei Ginou) dan Magang (Jisshu). Lamar sekarang!" showFooter={true}>
  <!-- `client:load`, not `client:only`: measured 2026-09-23, with JavaScript
       unavailable this route rendered 523 chars and **0 h1** — the header, the
       nav and the page's only heading all lived in a client-only island. The
       job portal is the main public destination, so it must not be empty to a
       crawler or a no-JS reader. Same change, and the same reasoning, as
       `index.astro` (see the long note there). -->
  <App client:load />

  <main id="main-content" class="w-full max-w-7xl mx-auto px-4 md:px-6 pb-16 min-h-[60vh]">
    <div class="py-10 md:py-14">
      <SectionTitle
        titleKey="profile.loker_title"
        title="Lowongan Terbaru"
        descKey="profile.loker_desc"
        desc="Daftar lowongan aktif dari mitra kami di Jepang. Filter berdasarkan bidang atau lokasi."
        accent="jobs"
        headingId="loker-title"
      />
    </div>

    <div class="pb-14">
      <LokerTable client:only="preact" />
      <!-- This page is the main public destination, and its whole point is the
           table below — which is a `client:only` island, so it emits NO server
           HTML. MEASURED 2026-10-07, JavaScript off: this route rendered **104
           characters** (the heading and nothing else). A visitor who reaches it
           from a WhatsApp link on a locked-down browser must not be stranded, so
           the fallback names the content and gives a way to get it.
           Guarded by `e2e:headings` "not left with an empty page". -->
      <noscript>
        <p class="rounded-xl border border-slate-700 bg-slate-900 p-4 text-sm leading-relaxed text-slate-300">
          <span data-lang="public.noscript_jobs">Daftar lowongan ini dimuat dengan JavaScript. Aktifkan JavaScript, atau hubungi kami di WhatsApp — kami kirimkan daftar lowongan terbaru.</span>
          <a class="ml-1 inline-flex min-h-11 items-center font-bold text-sky-400 underline" href={`https://wa.me/${CONTACT_WHATSAPP}`} target="_blank">WhatsApp</a>
        </p>
      </noscript>
    </div>
  </main>
</BaseLayout>
