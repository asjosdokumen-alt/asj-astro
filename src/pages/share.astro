---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareView from '../components/forms/ShareView.tsx';
import FormToolbar from "../components/forms/FormToolbar";
import App from '../components/App.tsx';
---

<BaseLayout title="ASJ - Candidate Viewer" description="View candidates for ASJ job">
  <App showHeader={false} client:only="preact" />

  <FormToolbar client:only="preact" titleKey="toolbar.share" />
  <main id="main-content" class="w-full min-h-[50vh] pb-16 pt-[42px]">
    <ShareView client:only="preact" />
  </main>
</BaseLayout>
