---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiswaBaruForm from '../components/forms/SiswaBaruForm.tsx';
import App from '../components/App.tsx';
import FormToolbar from "../components/forms/FormToolbar";
---

<BaseLayout title="ASJ - Pendaftaran Siswa (AI Assistant)" titleKey="doc.title_siswa_baru" description="Form pendaftaran siswa baru LPK ASJ dengan AI Assistant Qween Jeklin">
  <App showHeader={false} client:only="preact" />

  <FormToolbar client:only="preact" titleKey="toolbar.siswa" asHeading={false} />
  <main id="main-content" class="w-full min-h-[50vh] pb-16 pt-[var(--u-toolbar-h)]">
    <div class="max-w-3xl mx-auto px-4">
      {/* ⚠ PENGANTAR DIPANGKAS 2026-11-10, sama seperti /apply: h1 `text-xl` +
          SATU baris `text-[12px]`, tanpa daftar langkah. Pemilik: "pedekin,
          hilangin kata-kata yang tidak berguna di HP, cukup tulis yang penting
          buat SEO, semua halaman".
          Pola ini sudah dipakai tujuh halaman tes (/tes-iq, /kotoba,
          /matematika, /arcade, /wawancara, /tes-mbti, /tes-mata) — jadi ini
          menyeragamkan, bukan gaya baru.
          h1 TIDAK boleh hilang: `FormToolbar` di sini `asHeading={false}`, jadi
          h1 server satu-satunya ada di blok ini dan `e2e:headings` menuntut
          tepat satu. */}
      <section class="mb-4">
        <h1 class="text-xl md:text-2xl font-bold text-fg mb-1" data-lang="siswa.intro_h1">Pendaftaran Siswa Baru LPK ASJ</h1>
        <p class="text-fg-muted text-[12px] leading-snug" data-lang="siswa.intro_desc">Kelas N5 sampai persiapan kerja, dengan asrama dan bimbingan visa.</p>
      </section>
      <SiswaBaruForm client:only="preact" />
    </div>
  </main>
</BaseLayout>
