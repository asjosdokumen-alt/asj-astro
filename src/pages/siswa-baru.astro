---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiswaBaruForm from '../components/forms/SiswaBaruForm.tsx';
import App from '../components/App.tsx';
import FormToolbar from "../components/forms/FormToolbar";
---

<BaseLayout title="ASJ - Pendaftaran Siswa (AI Assistant)" titleKey="doc.title_siswa_baru" description="Form pendaftaran siswa baru LPK ASJ dengan AI Assistant Qween Jeklin">
  <App showHeader={false} client:only="preact" />

  <FormToolbar client:only="preact" titleKey="toolbar.siswa" />
  <main id="main-content" class="w-full min-h-[50vh] pb-16 pt-[var(--u-toolbar-h)]">
    <div class="max-w-3xl mx-auto px-4">
      <section class="mb-8">
        <h1 class="text-2xl font-bold text-fg mb-2" data-lang="siswa.intro_h1">Pendaftaran Siswa Baru LPK ASJ</h1>
        <p class="text-fg-muted leading-relaxed" data-lang="siswa.intro_desc">Daftar program pelatihan bahasa Jepang intensif. Kami menyediakan kelas dari N5 hingga persiapan kerja, dengan fasilitas asrama dan bimbingan visa.</p>
        <ol class="mt-4 space-y-2 text-sm text-fg-muted list-decimal list-inside">
          <li data-lang="siswa.intro_step1">Isi formulir pendaftaran & pilih program</li>
          <li data-lang="siswa.intro_step2">Tunggu jadwal tes masuk & wawancara</li>
          <li data-lang="siswa.intro_step3">Lakukan pembayaran biaya pendaftaran</li>
          <li data-lang="siswa.intro_step4">Mulai pelatihan sesuai jadwal kelas</li>
        </ol>
      </section>
      <SiswaBaruForm client:only="preact" />
    </div>
  </main>
</BaseLayout>
