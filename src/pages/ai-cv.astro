---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiCvForm from '../components/forms/AiCvForm.tsx';
import App from '../components/App.tsx';
import FormToolbar from "../components/forms/FormToolbar";
---

<BaseLayout title="AI CV Assistant — Buat CV Kerja Jepang" titleKey="doc.title_ai_cv" description="Buat CV kerja ke Jepang dengan AI Assistant Qween Jeklin. Gratis, cepat, dan sesuai format agensi Jepang.">
  <App showHeader={false} client:only="preact" />

  {/*
    H1 HALAMAN ADA DI TOOLBAR (`asHeading` dibiarkan default: true).

    Dulu halaman ini punya blok pengantar sendiri — judul "Buat CV Kerja Jepang
    dengan AI", satu paragraf, dan empat langkah bernomor. Pemilik 2026-11-01:
    "tolong hilangkan tulisan atas ini, bikin habis ruang saja". Blok itu
    dihapus; karena `<h1>`-nya ikut hilang, identitas halaman dipindahkan ke
    toolbar — bukan dibiarkan kosong. `e2e:headings` menuntut tepat satu h1 per
    rute, jadi menghapus blok tanpa memindahkan h1 akan membuat rute ini nol h1.

    `backTo="dashboard"`: kandidat yang membuka halaman ini kembali ke
    dasbornya, bukan ke portal (lihat catatan di FormToolbar).
  */}
  <FormToolbar client:only="preact" titleKey="toolbar.ai_cv" backTo="dashboard" />
  <main id="main-content" class="w-full min-h-[50vh] pt-[var(--u-toolbar-h)]">
    <div class="max-w-3xl mx-auto px-4">
      <noscript data-lang="doc.needs_js" class="block mb-4 rounded-card border border-amber-400 bg-amber-100 px-4 py-3 text-sm font-bold text-amber-900">Halaman ini memerlukan JavaScript. Aktifkan JavaScript, lalu muat ulang halaman ini.</noscript>
    </div>
    <AiCvForm client:only="preact" />
  </main>
</BaseLayout>
