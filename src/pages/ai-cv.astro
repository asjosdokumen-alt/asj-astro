---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiCvForm from '../components/forms/AiCvForm.tsx';
import App from '../components/App.tsx';
import FormToolbar from "../components/forms/FormToolbar";
---

<BaseLayout title="AI CV Assistant — Buat CV Kerja Jepang" titleKey="doc.title_ai_cv" description="Buat CV kerja ke Jepang dengan AI Assistant Qween Jeklin. Gratis, cepat, dan sesuai format agensi Jepang.">
  <App showHeader={false} client:only="preact" />

  <FormToolbar client:only="preact" titleKey="toolbar.ai_cv" />
  <main id="main-content" class="w-full min-h-[50vh] pb-16 pt-[42px]">
    <div class="max-w-3xl mx-auto px-4">
      <section class="mb-8">
        <h1 class="text-2xl font-bold text-fg mb-2">Buat CV Kerja Jepang dengan AI</h1>
        <p class="text-fg-muted leading-relaxed">AI Assistant Qween Jeklin membantu menyusun CV profesional dalam format yang diterima agensi penempatan kerja Jepang. Gratis dan hanya membutuhkan 5 menit.</p>
        <ol class="mt-4 space-y-2 text-sm text-fg-muted list-decimal list-inside">
          <li>Jawab beberapa pertanyaan singkat tentang diri Anda</li>
          <li>AI menyusun CV otomatis sesuai format Jepang</li>
          <li>Preview & edit langsung sebelum download</li>
          <li>Download CV dalam format PDF siap kirim</li>
        </ol>
      </section>
      <noscript data-lang="doc.needs_js" class="block mb-4 rounded-card border border-amber-400 bg-amber-100 px-4 py-3 text-sm font-bold text-amber-900">Halaman ini memerlukan JavaScript. Aktifkan JavaScript, lalu muat ulang halaman ini.</noscript>
      <AiCvForm client:only="preact" />
    </div>
  </main>
</BaseLayout>
