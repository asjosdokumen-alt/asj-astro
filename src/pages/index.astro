        >
          <Icon name="location-arrow" />
          <span data-lang="profile.review_open_maps">Lihat di Google Maps</span>
        </a>
      </div>
      <div class="mt-6">
        <ReviewGrid reviews={REVIEWS} />
      </div>
      {/* Catatan kejujuran, bukan hiasan: keempat kutipan itu SALINAN dari
          listing, dan yang tampil di listing adalah terjemahan otomatis Google
          dari ulasan berbahasa Indonesia. Menampilkannya tanpa catatan berarti
