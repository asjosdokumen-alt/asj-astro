    .pm-stats div {
      display: flex;
      flex-direction: column-reverse;
      gap: 0.1rem;
    }
    .pm-stats dd {
      margin: 0;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 900;
      line-height: 1;
      /* Token tema, bukan pink panggung: baris ini sekarang di atas latar
         HALAMAN (terang di tema terang), bukan di atas peta gelap — pink 300
         di atas putih terukur ~1,7:1, praktis hilang. */
      color: var(--color-fg);
      font-variant-numeric: tabular-nums;
    }
    .pm-stats dt {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-fg-muted);
    }

    /* Daftar lengkap yang selalu ada di DOM (lihat catatan di markup). */
    .pm-all {
      margin-top: 1.25rem;
      border-top: 1px solid var(--color-line);
      padding-top: 0.9rem;
