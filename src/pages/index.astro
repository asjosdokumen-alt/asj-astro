---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App.tsx';
import LayananSection from '../components/public/LayananSection.astro';
import ClosingBand from '../components/public/ClosingBand.astro';
import JapanTexture from '../components/public/JapanTexture.astro';
import SiteNav from '../components/public/SiteNav.astro';
import Section from '../components/public/Section.astro';
import SectionTitle from '../components/public/SectionTitle.astro';
import Card from '../components/public/Card.astro';
import IconTileGrid from '../components/public/IconTileGrid.tsx';
import PersonGrid from '../components/public/PersonGrid.tsx';
import HistoryTimeline from '../components/public/HistoryTimeline.tsx';
import ContactForm from '../components/public/ContactForm.tsx';
import GalleryGrid from '../components/public/GalleryGrid.tsx';
import FactList from '../components/public/FactList.tsx';
import StepList from '../components/public/StepList.tsx';
import CheckList from '../components/public/CheckList.tsx';
import PrincessMascot from '../components/public/PrincessMascot.astro';
import Icon from '../components/ui/Icon';
import {
  ABOUT_PARAGRAPHS,
  ABOUT_WELCOME,
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_LOCATION,
  CONTACT_PHONES,
  FACILITIES,
  FLOW_STEPS,
  HISTORY,
  LEGAL_FACTS,
  MISSIONS,
  PLACEMENTS,
  PROGRAMS,
  PROGRAM_INCLUDES,
  PROGRAM_PAYMENT,
  PROGRAM_PRICE,
  REQUIREMENTS,
  REQUIREMENT_DOCS,
  TEAM,
  VISION,
  WHY_JAPAN,
  WHY_JAPAN_TIP,
} from '../lib/companyProfile';
import { GALLERY } from '../lib/gallery';

/* WHY THE SECTIONS ARE COMPOSED HERE AND NOT EACH IN THEIR OWN FILE.
   Six of the blocks below are the same three elements — a Section, a SectionTitle
   and one primitive — with different data. A file per composition would add six
   files that contain no logic and no encapsulation, and each one would move the
   indexer's frozen inventory for no gain. The primitives ARE the reusable part and
   they are separate files; what is left here is page composition, which is what a
   page file is for.

   WHY THERE IS NO `.map()` IN THIS FILE. Iterating inside an `.astro` TEMPLATE
   breaks a hard invariant of this repo: `indexer/src/build.test.ts:428` requires
   zero unresolved references originating outside a test file, and the indexer
   resolves template interpolations against the FRONTMATTER MODULE SCOPE only — so a
   `.map()` callback parameter in a template is reported as an unresolved global
   (measured: 21 entries, every one a callback parameter). Every list on this page
   therefore lives in a `.tsx` primitive, where callbacks bind correctly. That is why
   CheckList exists at all: four of these blocks were inline maps before it did. */
---

<BaseLayout title="PT Amanah Sakura Japan — Job Portal" description="Lowongan kerja Jepang, penerimaan siswa baru, pengurusan visa, pendaftaran ujian JFT & SSW" showFooter={true}>
  <!-- `hero` turns the header band into the landing page's hero. It also moves
       the page's single h1 into the hero, so the company name in the header
       steps down to a div — see the note in App.tsx. Every OTHER route mounts
       the header without this flag and keeps the header h1, because for those
       routes it is the only one.

       WHY `client:load` AND NOT `client:only="preact"` — measured 2026-09-23.
       `client:only` renders NO server HTML, so with JavaScript unavailable this
       page had **0 h1** and no header at all: the hero headline and the entire
       nav existed only after hydration. On a landing page that is the one
       heading a search engine and a no-JS reader need.

       `client:load` server-renders the island and then hydrates it. Measured in
       a real browser against a real server (390px, `server.cjs`):
         · JS ON  — 1 h1, 13 header/nav links, 0 console errors, 0 page errors
         · JS OFF — 1 h1 ("Karier ke Jepang, dimulai dari sini."), 13 links
       Before the change the JS-OFF column read 0 h1 and 0 links.

       THE HYDRATION MISMATCH THIS COULD HAVE CAUSED, AND WHY IT DOES NOT.
       `langStore` is a `persistentAtom`, so a visitor with `asj_lang = "jp"`
       stored would render Japanese on the client against the server's default
       Indonesian. That is why the language is read through the store rather than
       inlined into the markup: the text is IDENTICAL in both renders for any
       visitor who has not switched, and for one who has, Preact patches the
       text on hydration. The measurement above is the check — 0 page errors on
       the default path, which is the path almost every visitor takes.

       The gated routes (admin/candidate/apply/ai-cv/share/siswa-baru) keep
       `client:only`: they are session-dependent SPAs that cannot function
       without JavaScript, so server-rendering them would add weight and expose
       gate markup for no reader's benefit. -->
  <App client:load hero />

  <!-- Global Announcement Marquee (public page only) -->
<div id="global-announcement" hidden class="max-w-7xl mx-auto px-4 mt-4">
  <div class="bg-rose-700 rounded-2xl p-2.5 flex items-center shadow-[0_0_20px_rgba(225,29,72,0.3)] border border-rose-500/60 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 bg-red-800 w-12 flex items-center justify-center z-10 rounded-l-2xl border-r border-red-600/60 shadow-md">
      <Icon name="bullhorn" class="text-white animate-bounce text-lg" />
    </div>
    <!-- Two copies: the track animates to translate3d(-50%), i.e. exactly
         one copy, which makes the loop seamless at any text length. The
         duplicate is aria-hidden so screen readers read it once. -->
    <div class="marquee-track ml-12 mr-2">
      <div class="marquee-content text-white text-sm font-bold tracking-wide">
        <span class="marquee-item" data-marquee></span>
        <span class="marquee-item" data-marquee aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

  <!-- Live vacancy count.
       WHY IT IS HERE AND NOT INSIDE THE HERO. It is a real number read from the
       jobs payload, and the hero is a Preact island while this is static markup —
       putting it here lets one script fill it without adding a fetch to the
       island that every route mounts. Research on 30 recruitment sites in 2026
       found only 3 of 30 published their live vacancy count anywhere on the home
       page, which makes this the cheapest trust signal available.

       The placeholder is an em dash, NOT a zero: if the payload never arrives the
       page must say "unknown", not claim there are no vacancies. -->
  <div class="max-w-7xl mx-auto px-4 mt-4">
    <div class="flex flex-wrap items-center gap-3 rounded-card bg-surface border border-line px-5 py-3">
      <Icon name="briefcase" class="text-accent-sky" />
      <p class="text-body-sm text-fg-muted">
        <span id="live-job-count" class="font-black text-fg">—</span>
        <span data-lang="profile.hero_jobs_live">lowongan aktif</span>
      </p>
      <!-- NO "lihat semua lowongan" LINK HERE. Owner ruling 2026-09-24: `/` is a
           company profile for MoU/business partners, not a job board, so the
           only path to the vacancy list is the section nav. The live count
           stays: it is a real number read from the jobs payload, and a trust
           signal, not a call to apply. -->
    </div>
  </div>

<script>
  import { getPublicData } from "../lib/publicData";
  getPublicData().then(function(d){
    if(!d.success) return;
    if(d.pengumuman){
      var el=document.getElementById("global-announcement");
      var txt=document.querySelectorAll("[data-marquee]");
      // The `hidden` ATTRIBUTE, not a class swap: Tailwind 4.3.3 preflight ships
      // `[hidden] { display: none !important }`, so the attribute is strictly
      // stronger than any display utility and cannot be defeated by a stray one.
      if(el && txt.length && d.pengumuman.trim()){ txt.forEach(function(n){ n.textContent=d.pengumuman; }); el.hidden=false; }
    }
    var count=document.getElementById("live-job-count");
    if(count && d.jobs){ count.textContent=String(d.jobs.length); }
  }).catch(function(){});
</script>

  <!-- Desktop section nav. Rendered AFTER the hero band so it does not cover the
       artwork, and `sticky top-0` takes over once the visitor scrolls past it.
       Desktop only (`hidden lg:block`); the drawer still covers mobile. -->
  <SiteNav />

  <!-- ═══ THE MASCOT RAIL — she travels with the scroll ══════════════════════

       THE OWNER'S REQUEST, verbatim:
         "mascot itu bukan model gitu maunya ikut sesuai scroll mau ke sesi
          terus jadi pindah ikutin bagian dan posenya beda beda tergantung
          tempat baik mimik wajah maupun motionnya."

       HOW SHE TRAVELS WITH NO SCROLL LISTENER. This rail is a GRID COLUMN that
       spans the full height of <main>, and she is `position: sticky` inside it.
       The browser then moves her during COMPOSITING — off the main thread,
       for free. A `scroll` handler that set `transform` per frame would do the
       same work on the main thread and fight the compositor doing it already.

       WHY A GRID AND NOT `position: fixed`. A fixed mascot is pinned to the
       viewport, so she would still be on screen while the visitor reads the
       FOOTER and the closing CTA — neither of which has a pose, so she would
       sit there in whatever state the last section left her, which reads as
       stuck rather than as present. Sticky inside a column that ends with
       <main> means she leaves when the sections do.

       WHY `hidden xl:block`. Below that width there is no column to spare: the
       page's content already uses the full width, and a rail would either push
       the content narrow or overlap it. She is decoration, and decoration that
       costs a reader 200px of line length is not worth having. The in-section
       mascot in the Tentang band still renders at every width, so she is not
       missing from the page on mobile — only from the rail.

       ⚠ `w-0` ON THE RAIL ITSELF AT EVERY OTHER BREAKPOINT, and the reason is
       the grid, not the mascot. A grid column that is `display: none` is not
       laid out at all, so the grid would have ONE column below xl and TWO at
       xl — which is fine, because `grid-cols-[1fr]` and `grid-cols-[1fr_auto]`
       are separate media-query states. What must not happen is a column that
       exists and is EMPTY, which would reserve its track width and pull the
       content off-centre at exactly the widths where space is tightest. -->
  <div class="w-full max-w-[100rem] mx-auto grid grid-cols-1 xl:grid-cols-[1fr_15rem] gap-0">
  <!-- `overflow-x-clip` IS LOAD-BEARING — measured 2026-09-23, do not remove it.

       The two HORIZONTAL entrance kinds (`enter="slide-left"` / `"slide-right"`
       on #kenapa-jepang, #layanan, #fasilitas, #penempatan) park an un-revealed
       band at `translate3d(±2 × --enter-shift, 0, 0)` — 48px at the current
       `--enter-shift: 24px` (motion.css §9b). A band is FULL WIDTH, so while it
       is un-revealed it sticks 48px past the viewport and widens the document:

         measured at 390px on `/` — html.scrollWidth 423 vs clientWidth 390,
         i.e. **33px of horizontal scroll** (48px shift minus the 15px scrollbar).
         The offenders were `#layanan` and `#penempatan`, both 375px wide with
         `transform: matrix(1,0,0,1,48,0)`. After the reveal the same page
         measures scrollWidth 375 — the overflow exists ONLY pre-reveal.

       Two consequences, which is why this is a fix and not a nitpick:
         · A visitor can scroll the landing page sideways by 33px before the
           reveal runs. The bands below the fold never enter at load, so this is
           the state the page is in for everyone.
         · `e2e/test-headings.mjs` asserts "no horizontal overflow" and was RED
           on this, which made `e2e/test-headings.mutations.sh` and
           `test-headings-public.mutations.sh` ABORT on their baseline check —
           a red gate disarmed both proofs. That is the defect behind the defect.

       `clip` and not `hidden`: `overflow: hidden` on one axis creates a scroll
       container, which would break the mascot rail (`position: sticky` inside
       this <main>, see the note further down). `overflow: clip` does not create
       one, so sticky is unaffected — and nothing overflows horizontally once the
       bands are revealed (measured: 375 = 375), so this clips only the transient
       pre-reveal offset. Visually the bands now slide in from the edge instead
       of pushing the whole page sideways, which is what the motion was for. -->
  <main id="main-content" class="w-full pb-16 min-h-[50vh] xl:col-start-1 overflow-x-clip">
    <!-- Section: Kenapa Jepang? (page 2 of the company profile) -->
    <Section id="kenapa-jepang" labelledBy="kenapa-jepang-title" enter="slide-left" pose="princess-peace" motionName="sway">
      <SectionTitle
        titleKey="profile.why_title"
        title="Kenapa Jepang?"
        descKey="profile.why_desc"
        desc="Tiga alasan yang paling sering disebut kandidat."
        accent="jobs"
        headingId="kenapa-jepang-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={WHY_JAPAN} />
      </div>
      <p data-lang="profile.why_tip" class="mt-6 max-w-[70ch] text-body-sm text-fg-muted">
        {WHY_JAPAN_TIP.text}
      </p>
    </Section>

    <!-- Section: Layanan — now a direct section instead of a hidden tab panel.
         The tab system (Loker vs Layanan) was removed because the LokerTable
         moved to its own page (/loker). This makes Layanan visible by default,
         which is better for SEO and for visitors who scroll the profile. -->
    <Section id="layanan" labelledBy="layanan-title" class="section-alt" enter="slide-right" pose="princess-side" motionName="lean">
      <SectionTitle
        titleKey="profile.layanan_title"
        title="Program & Layanan ASJ"
        accent="program"
        headingId="layanan-title"
      />
      <div class="mt-8">
        <LayananSection />
      </div>
    </Section>

    <!-- Section: Program ASJ (pages 3 and 4). The price and its four inclusions
         ship together on purpose: a price without its inclusions is what makes a
         candidate assume there are hidden costs. -->
    <Section id="program" labelledBy="program-title" enter="grow" pose="princess-still" motionName="sway">
      <SectionTitle
        titleKey="profile.prog_title"
        title="Program ASJ"
        descKey="profile.prog_desc"
        desc="Dua jalur resmi ke Jepang, plus pelatihan bahasanya."
        accent="program"
        headingId="program-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={PROGRAMS} />
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 md:gap-6">
        <Card class="flex flex-col gap-2">
          <span data-lang="profile.prog_price_label" class="text-caption uppercase font-bold text-accent-emerald">
            Biaya program
          </span>
          <span class="text-section font-black text-fg">{PROGRAM_PRICE}</span>
          <span data-lang="profile.prog_payment" class="text-body-sm text-fg-muted">
            {PROGRAM_PAYMENT.text}
          </span>
        </Card>
        <Card class="flex flex-col gap-3">
          <span data-lang="profile.prog_includes_title" class="text-caption uppercase font-bold text-accent-emerald">
            Sudah termasuk
          </span>
          <CheckList items={PROGRAM_INCLUDES} accent="program" />
        </Card>
      </div>
    </Section>

    <!-- Section: Alur & Persyaratan (pages 3 and 4) -->
    <Section id="alur" labelledBy="alur-title" class="section-alt border border-line/30 rounded-panel" enter="curtain" pose="princess-head" motionName="look">
      <SectionTitle
        titleKey="profile.step_title"
        title="Bagaimana Prosesnya?"
        descKey="profile.step_desc"
        desc="Enam langkah dari pendaftaran sampai berangkat."
        accent="exam"
        headingId="alur-title"
      />
      <div class="mt-8">
        <StepList steps={FLOW_STEPS} />
      </div>

      <div class="mt-12">
        <h3 data-lang="profile.req_title" class="text-card-title font-bold text-fg">
          Persyaratan &amp; Dokumen
        </h3>
        <p data-lang="profile.req_desc" class="mt-1 text-body-sm text-fg-muted">
          Pastikan semuanya siap sebelum mendaftar.
        </p>
      </div>
      <div class="mt-5 grid gap-6 lg:grid-cols-2">
        <CheckList items={REQUIREMENTS} accent="exam" />
        <div>
          <h4 data-lang="profile.req_docs_title" class="text-caption uppercase font-bold text-accent-amber mb-3">
            Berkas yang disiapkan
          </h4>
          <CheckList items={REQUIREMENT_DOCS} icon="file-alt" accent="exam" />
        </div>
      </div>
    </Section>

    <!-- Section: Visi & Misi (pages 2 and 5). Editorial, not bento: a vision is one
         long sentence and a mission is four short points, so they are not two
         comparable cards and giving them equal heights would inflate one of them. -->
    <Section id="visi-misi" labelledBy="visi-misi-title" enter="drop" pose="princess-still" motionName="lean">
      <SectionTitle
        titleKey="profile.vision_title"
        title="Visi & Misi"
        accent="identity"
        headingId="visi-misi-title"
      />
      <div class="mt-8 grid gap-4 lg:grid-cols-2 lg:gap-6">
        <Card radius="panel" padding="lg">
          <h3 data-lang="profile.vision_heading" class="text-card-title font-bold text-accent">
            Visi
          </h3>
          <p data-lang="profile.vision_body" class="mt-3 text-body-sm text-fg-muted">
            {VISION.text}
          </p>
        </Card>
        <Card radius="panel" padding="lg">
          <h3 data-lang="profile.mission_heading" class="text-card-title font-bold text-accent">
            Misi
          </h3>
          <div class="mt-3">
            <CheckList items={MISSIONS} as="ol" accent="identity" />
          </div>
        </Card>
      </div>
    </Section>

    <!-- Section: Legalitas (pages 6 and 7). A list, not a grid: a licence register
         has hierarchy and nothing to compare. Every value is a literal — a
         registration number is not translated. -->
    <Section id="legalitas" labelledBy="legalitas-title" class="section-alt border border-line/30 rounded-panel" enter="focus" pose="princess-head" motionName="sway">
      <SectionTitle
        titleKey="profile.legal_title"
        title="Legalitas & Izin Resmi"
        descKey="profile.legal_desc"
        desc="Badan hukum dan nomor pendaftaran yang bisa diperiksa."
        accent="legal"
        headingId="legalitas-title"
      />
      <div class="mt-8">
        <FactList facts={LEGAL_FACTS} accent="legal" />
      </div>
    </Section>

    <!-- Section: Fasilitas (pages 11-15 plus the price inclusions on page 3) -->
    <Section id="fasilitas" labelledBy="fasilitas-title" enter="slide-left" pose="princess-peace" motionName="bounce">
      <SectionTitle
        titleKey="profile.fac_title"
        title="Fasilitas & Dukungan"
        descKey="profile.fac_desc"
        desc="Yang kandidat dapatkan selama pelatihan."
        accent="program"
        headingId="fasilitas-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={FACILITIES} />
      </div>
    </Section>

    <!-- Section: Galeri Kegiatan (R3).
         WHY IT SITS DIRECTLY AFTER #fasilitas. The tile grid above makes claims
         ("Kelas Bahasa Jepang", "Ruang Kantor", "Ruang Tamu") and this section is
         the evidence for them — a claim followed immediately by the photograph of
         the thing it claims. Separation would weaken both.

         WHY ONLY NINE OF THE TWENTY-SIX AVAILABLE PHOTOGRAPHS. Four are excluded
         on purpose and the reasons are recorded in src/lib/gallery.ts rather than
         here, so the next person finds them before "completing" the grid: two are
         scans carrying a third party's signature and NIP, one is a CCTV frame with
         a burned-in timestamp and a surveillance angle, and one is a recruitment
         flyer whose price is baked into pixels. `gallery.test.ts` fails if any of
         them is re-added, and it also fails on a `src` that is not on disk — which
         is the exact hole the note at #tentang below used to describe.

         NO LIGHTBOX — see the note in GalleryGrid.tsx: one dialog contract. -->
    <Section id="galeri" labelledBy="galeri-title" class="section-alt border border-line/30 rounded-panel" enter="grow" pose="princess-wave" motionName="look">
      <SectionTitle
        titleKey="profile.gallery_title"
        title="Galeri Kegiatan"
        descKey="profile.gallery_desc"
        desc="Suasana pelatihan, kantor, dan keberangkatan peserta."
        accent="identity"
        headingId="galeri-title"
      />
      <div class="mt-8">
        <GalleryGrid items={GALLERY} />
      </div>
    </Section>

    <!-- Section: Penempatan Kami (R4, pages 13 and 14).
         WHY THIS REPLACES TESTIMONIALS. The mockup put quotes in this slot; the
         company profile contains none. It does contain something more useful —
         four prefectures with dated interview banners behind them — so the slot
         shows provable evidence instead of invented praise.

         The list comes from PLACEMENTS, and the UI does not restate the
         prefecture NAMES anywhere: it renders the `value` columns as written, so
         adding a fifth placement is a one-line edit to companyProfile.ts and there
         is no second copy of the list to forget. (The hero's count is derived from
         the same module via PLACEMENT_PREFECTURES.) -->
    <!-- Section: Lowongan Ringkas (R2) WAS HERE and is deliberately gone.
         Owner ruling 2026-09-24: `/` is a company profile for MoU/business
         partners, not a job board, so a vacancy teaser does not belong on it.
         The vacancy list is still reachable from the section nav; the page
         keeps exactly ONE link to it. Do not restore this section — the
         supporting data (`profile.mini_*` keys, `JobMiniList.tsx`) was removed
         with it. -->

    <Section id="penempatan" labelledBy="penempatan-title" class="section-alt border border-line/30 rounded-panel" enter="slide-right" pose="princess-peace" motionName="bounce">
      <SectionTitle
        titleKey="profile.place_title"
        title="Penempatan Kami"
        descKey="profile.place_desc"
        desc="Bidang dan prefektur tujuan yang tercatat pada dokumen perusahaan."
        accent="identity"
        headingId="penempatan-title"
      />
      <div class="mt-8">
        <FactList facts={PLACEMENTS} accent="identity" />
      </div>
      <p data-lang="profile.place_note" class="mt-6 max-w-[70ch] text-body-sm text-fg-muted">
        Nama prefektur ditulis dalam huruf Latin, sesuai dokumen resmi.
      </p>
    </Section>

    <!-- Section: Tentang Kami (S7, page 2).
         3 paragraphs of prose, and research places long text blocks as the case
         where a bento grid loses — forcing a paragraph into a card cuts a
         sequential argument into pieces that cannot be read in order.

         THE IMAGE GAP IS NOW CLOSED, and the note that used to sit here is kept
         in shortened form because its reasoning was right and its premise expired:
         it said the spec called for `fasilitas-gedung.webp` while `public/` held
         only icons and the logo, and that rendering an <img> at a path that does
         not exist would show a broken image, so the gap was recorded rather than
         filled with a placeholder. That was the correct call. The asset now exists
         (`public/assets/fasilitas-gedung.webp`, 1600x1066) along with 25 others, so
         the block ships with the photograph — and `gallery.test.ts` now fails on a
         `src` that is not on disk, so the failure mode that note was protecting
         against cannot come back silently.

         WHY THE PHOTO SITS BESIDE THE PROSE, NOT ABOVE IT. Three paragraphs of
         sequential argument should not be interrupted, and a full-width image
         would push the last paragraph below the fold on a laptop. The text column
         is capped at 68ch, which is the measure the paragraphs were already set
         to; the photo takes the remaining third. -->
    <Section id="tentang" labelledBy="tentang-title" enter="curtain" pose="princess-still" motionName="lean">
      <SectionTitle
        titleKey="profile.about_title"
        title="Tentang Kami"
        descKey="profile.about_desc"
        desc="Lembaga pelatihan dan penempatan kerja di Ponorogo."
        accent="identity"
        headingId="tentang-title"
      />
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,68ch)_1fr] lg:items-start">
      <div class="flex flex-col gap-4">
        <p data-lang="profile.about_welcome" class="text-body font-medium text-fg border-l-2 border-accent pl-4">
          {ABOUT_WELCOME.text}
        </p>

        <!-- The princess mascot, beside the opening paragraph.
             WHY HERE AND NOT IN THE HERO. `docs/ILLUSTRATION_SPEC.md` §6.0
             measured the rule that decides this: the landing page has NO data
             about a visitor, so any progress/XP/badge placed here would be
             invented — §6.2 forbids exactly that. A mascot is the safe half of
             "gamefeel": she carries no state, no score and no rank, so she is
             honest at every scroll position. The mockup places her where the
             page explains who the company is, which is where a companion
             figure reads as a guide rather than as an advertisement.

             WHY SHE SITS IN A PINK PANEL RATHER THAN BARE ON THE PAGE.
             The renders have TRANSPARENT backgrounds (deliberately — that is
             what makes them reusable over any surface). On the near-white
             `--color-canvas` a white-dressed character with pale skin has
             almost no edge contrast, and the first capture showed her reading
             as a cut-out floating over the copy rather than as part of the
             page. The `surface-raised` panel gives her a defined ground and
             matches the mockup, where she sits on a tinted card.

             `decorative` IS LEFT AT ITS DEFAULT (true). The paragraphs beside
             her already say everything she could: she adds warmth, not
             information, so a screen reader should skip her rather than
             announce a cartoon between a heading and its first sentence. -->
        <div class="mx-auto flex w-full max-w-[240px] items-end justify-center rounded-panel bg-surface-raised px-4 pt-6">
          <PrincessMascot pose="princess-wave" size={200} class="w-full" />
        </div>
        <p data-lang="profile.about_p1" class="text-body text-fg-muted">
          {ABOUT_PARAGRAPHS[0].text}
        </p>
        <p data-lang="profile.about_p2" class="text-body text-fg-muted">
          {ABOUT_PARAGRAPHS[1].text}
        </p>
        <a
          href="#program"
          class="mt-2 inline-flex items-center gap-2 text-body-sm font-bold text-accent hover:underline"
        >
          <span data-lang="profile.about_cta">Tentang Program Kami</span>
          <Icon name="arrow-right" />
        </a>

        <!-- Sejarah — the brief for "Tentang Kami" asks for visi, misi, SEJARAH and
             tim, and the page had the other three but not this one: it said what
             the company does and never when it was founded or on whose authority.
             Three milestones, each carrying its own document reference so the entry
             is checkable rather than merely plausible.

             WHY A DEFINITION LIST RATHER THAN Card COMPONENTS. These are a sequence
             in time, not three comparable alternatives — `docs/LANDING_PAGE_ROADMAP`
             §L3 makes the same call for Visi & Misi, which are editorial rather than
             bento for exactly this reason. A <dl> also keeps the heading level below
             the section's h2, which the single-h1 rule on `/` requires.

             WHY EVERY VALUE FAILS THE BANNED-FIGURE TEST IF TYPED WRONG. The mockup
             claimed "Berdiri Sejak 2015", and companyProfile.test.ts bans 2015 from
             every export. So these dates cannot regress to the mockup's number
             without a red gate — the dates are guarded, not merely stated. -->
        <div class="mt-6 border-t border-line pt-6">
          <HistoryTimeline milestones={HISTORY} />
        </div>
      </div>
        <figure class="flex flex-col">
          <!-- THE DECLARATION NOW MATCHES THE FILE. This block used to call the
               picture "Gedung kantor ... di Ponorogo" and give it
               `alt="Gedung kantor PT Amanah Sakura Japan"`. The photograph is
               not a building portrait — it is about twenty people in batik
               standing in front of the office, which is the same subject
               `fasilitas-grup-staf.webp` shows from a different angle. The
               dimensions were right (1600x1066) and the file existed, so
               `gallery.test.ts` and `verify:assets` both passed: neither gate
               reads the picture. Corrected 2026-09-20 — see
               docs/ASSET_AUDIT_2026-09-20.md.

               WHY THE PHOTOGRAPH STAYS. A company profile that shows only
               rooms and logos and never shows a person is the weaker page, and
               `src/lib/gallery.ts` already argues this in prose: these are the
               company's own staff and participants, photographing their own
               office. What had to change was the claim, not the picture. -->
          <img
            src="/assets/fasilitas-gedung.webp"
            alt="Peserta dan staf LPK Amanah Sakura Japan berfoto bersama di depan kantor, mengenakan seragam batik lembaga."
            width="1600"
            height="1066"
            loading="lazy"
            decoding="async"
            class="w-full rounded-card border border-line object-cover"
          />
          <figcaption data-lang="profile.about_caption" class="mt-3 text-caption text-fg-muted">
            Peserta dan staf di kantor LPK Amanah Sakura Japan — Ponorogo, Jawa Timur
          </figcaption>
        </figure>
      </div>
    </Section>

    <!-- Section: Tim & Kredensial (S10, pages 8 and 10). The credential card is
         the point of this section: an N1 holder is a checkable fact, which is
         stronger evidence than the word "professional" in prose. -->
    <Section id="tim" labelledBy="tim-title" class="section-alt border border-line/30 rounded-panel" enter="focus" pose="princess-head" motionName="look">
      <SectionTitle
        titleKey="profile.team_title"
        title="Tim & Kredensial"
        descKey="profile.team_desc"
        desc="Struktur organisasi dan kualifikasi pengajar kami."
        accent="legal"
        headingId="tim-title"
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <Card class="flex flex-col gap-1">
          <span data-lang="profile.cred_title" class="text-caption uppercase font-bold text-accent">
            Kredensial pengajar
          </span>
          <span class="text-section font-black text-fg">JLPT N1</span>
          <span class="text-body-sm text-fg-muted">N1A225127J</span>
        </Card>
      </div>
      <div class="mt-6">
        <PersonGrid people={TEAM} />
      </div>
    </Section>

    <!-- Section: Kontak (R1, pages 5, 8 and 9).

         WHY THE SUBTITLE DOES NOT REFERENCE OFFICE HOURS. The hours are P-4 —
         never supplied by the owner, with the fallback recorded as "baris jam
         dihilangkan" in `LANDING_PAGE_SPEC.md:659`. The subtitle used to tell
         visitors to get in touch during working hours, which is a schedule this
         page never states, so it pointed them at something they had no way to
         look up. It now names the three channels that do exist. When the owner
         supplies the hours, add the ROW and a subtitle that can reference it —
         do not restore the old sentence on its own.

         This comment is deliberately written WITHOUT quoting the retired
         sentence, because Astro ships HTML comments to the browser: a literal
         copy of it here would keep a text search of the built page non-empty
         and read as "the old copy is still on the page". -->
    <Section id="kontak" labelledBy="kontak-title" enter="drop" pose="princess-wave" motionName="wave">
      <SectionTitle
        titleKey="profile.contact_title"
        title="Informasi Kontak"
        descKey="profile.contact_desc"
        desc="Silakan hubungi kami melalui telepon, surel, atau formulir."
        accent="identity"
        headingId="kontak-title"
      />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <Card class="flex flex-col gap-3">
          <span data-lang="profile.contact_address" class="text-caption uppercase font-bold text-accent">
            Alamat
          </span>
          <span class="text-body-sm text-fg-muted">{CONTACT_ADDRESS}</span>
        </Card>
        <Card class="flex flex-col gap-3">
          <span data-lang="profile.contact_phone" class="text-caption uppercase font-bold text-accent">
            Telepon
          </span>
          <span class="text-body-sm text-fg-muted">{CONTACT_PHONES[0]}</span>
          <span class="text-body-sm text-fg-muted">{CONTACT_PHONES[1]}</span>
          <div class="flex flex-col gap-1 pt-2 border-t border-line">
            <span data-lang="profile.contact_email" class="text-caption uppercase font-bold text-accent">
              Surel
            </span>
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-body-sm text-fg-muted hover:underline">
              {CONTACT_EMAIL}
            </a>
          </div>
        </Card>
      </div>

      {/* ── Formulir kontak ────────────────────────────────────────────────
           THE ONE INTERACTIVE ISLAND IN THIS SECTION, and the reason it is an
           island at all: the submission is the only unauthenticated WRITE in
           the deployment, so it needs client state (sending / sent / error) that
           static HTML cannot express. Everything above it stays server-rendered.

           `client:visible` rather than `client:load` on purpose. This section is
           near the bottom of a long page, so shipping the component's JavaScript
           on first paint would spend the landing page's main-thread budget on a
           form most visitors scroll past — the exact cost the L-series work
           measured (docs/LANDING_PAGE_ROADMAP.md, perf rows). It hydrates when
           it scrolls into view, which is before anyone can type into it.

           The heading is an <h3> UNDER the section's existing <h2>, not a second
           <h2>: `e2e/test-headings.mjs` asserts `/` has exactly one <h1> and one
           heading per visible section, and a peer heading here would make the
           contact section report two. */}
      <div class="mt-8 rounded-panel border border-line/30 bg-surface p-5 sm:p-6">
        <h3 class="text-card-title font-bold text-fg" data-lang="contact.title">
          Kirim Pesan
        </h3>
        <p class="mt-1 mb-5 text-body-sm text-fg-muted" data-lang="contact.desc">
          Sampaikan pertanyaan Anda melalui formulir di bawah ini.
        </p>
        <ContactForm client:visible />
      </div>
    </Section>

    <!-- Section: Lokasi (R5, page 5). The map banner was MOVED here from
         LayananSection.astro (spec §3, S5 row 2 and roadmap L3.8) — the page had
         one map, in the wrong section, and duplicating it would mean two copies of
         one address to keep in sync. What moved is the banner itself, address and
         link together, so the "Buka Google Maps" button is the same element the
         visitor could already reach inside the services panel. -->
    <Section id="lokasi" labelledBy="lokasi-title" class="section-alt border border-line/30 rounded-panel" enter="rise" pose="princess-side" motionName="sway">
      <SectionTitle
        titleKey="profile.loc_title"
        title="Lokasi Kami"
        descKey="profile.loc_desc"
        desc="Kantor kami di Kabupaten Ponorogo, Jawa Timur."
        accent="jobs"
        headingId="lokasi-title"
      />
      {/* Location banner illustration. Decorative, so `alt=""` + aria-hidden:
          the section already states the location in its h2 and its address, and
          the drawing is a skyline band with no unique information in it.

          `aspect-[2/1]` matches the file's 1200x600 exactly, so the ratio is
          reserved before load and the section does not jump. Rounding is on the
          wrapper (`rounded-panel overflow-hidden`) so the corners clip the
          image, rather than relying on the image's own corners.

          `loading="lazy"` here — unlike the hero, this band is far below the
          fold and is never the LCP element. */}
      <picture class="block mt-6 rounded-panel overflow-hidden border border-line/30">
        <source
          type="image/avif"
          srcset="/assets/ilustrasi/lokasi-banner.avif 1x, /assets/ilustrasi/lokasi-banner@2x.avif 2x"
        />
        <source
          type="image/webp"
          srcset="/assets/ilustrasi/lokasi-banner.webp 1x, /assets/ilustrasi/lokasi-banner@2x.webp 2x"
        />
        <img
          src="/assets/ilustrasi/lokasi-banner.webp"
          alt=""
          aria-hidden="true"
          width="1200"
          height="600"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[2/1] object-cover"
        />
      </picture>
      <div class="mt-8 bg-slate-800 border border-slate-700 rounded-panel p-5 flex flex-col sm:flex-row justify-between items-center gap-5 text-center sm:text-left shadow-lg">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-red-900/30 rounded-full flex items-center justify-center shrink-0">
            <Icon name="map-marker-alt" class="text-red-500 text-xl" />
          </div>
          <div>
            <p class="text-white font-bold text-body-sm mb-1" data-lang="landing.maps_title">
              Kunjungi LPK Amanah Sakura Japan
            </p>
            <p class="text-body-sm text-fg-muted max-w-xl">
              {CONTACT_ADDRESS}
            </p>
          </div>
        </div>
        <a
          id="maps-lpk-link"
          href="https://maps.app.goo.gl/rXZ1YZAtT9JUNn6q6?g_st=ic"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-control bg-slate-700 hover:bg-slate-600 text-white text-body-sm font-bold border border-slate-500 transition whitespace-nowrap"
        >
          <Icon name="location-arrow" />
          <span data-lang="profile.loc_open_maps">Buka di Google Maps</span>
        </a>
      </div>
    </Section>
  </main>

  <!-- The rail. `sticky top-0` + `h-screen` is what makes her track the scroll:
       the rail is as tall as <main>, so a sticky child with a full-viewport
       height stays in the viewport for the whole of it. `self-start` stops the
       grid from stretching her to the rail's full height (grid items stretch by
       default), which would give the sticky box nothing to stick within.
       `pointer-events-none` because she must never intercept a click meant for
       the content beside her — `aria-hidden` is set on the image itself. -->
  <aside
    class="hidden xl:block xl:col-start-2 xl:row-start-1 self-start sticky top-0 h-screen pointer-events-none"
    aria-hidden="true"
  >
    <div class="flex h-full items-center justify-center pr-6">
      <div class="w-full max-w-[15rem] rounded-panel bg-surface-raised px-4 pt-6">
        <PrincessMascot size={200} class="w-full" motion="wave" track />
      </div>
    </div>
  </aside>
  </div>

  <!-- ─── Pita dekoratif Jepang (asanoha) ──────────────────────────────
       The ONE landingside gamefeel element that needs no visitor state.

       WHY THIS IS A BARE BAND AND NOT A LAYER INSIDE A Section. `Section`
       renders `py-14 md:py-20` with no `relative`, so an absolutely-positioned
       child would escape its box and paint over the section above it. A band
       with its own `relative` + `overflow-hidden` is self-contained: it cannot
       bleed, and it cannot cover content it does not own.

       WHY IT CARRIES NO TEXT AND NO HEADING. `e2e/test-headings.mjs` asserts
       `/` has EXACTLY ONE h1, and the L2 work already had to move that h1 into
       the hero. A decorative band that also announced itself would be the
       second heading on the page. `JapanTexture` renders none, and its suite
       fails if that changes.

       WHY NOTHING IS SCORED HERE. A visitor has no account, so any number on
       this page would be invented — docs/ILLUSTRATION_SPEC.md §6.0 calls that
       out as reading as surveillance rather than game. There are no numbers,
       no levels and no badges in this band, deliberately. -->
  <!-- Gradient accent divider — replaces the asanoha texture band.
       The old JapanTexture band was purely decorative and loaded a complex SVG
       pattern. The gradient accent line is simpler, theme-responsive (via
       --accent-line in theme.css), and echoes the footer's top divider for
       visual consistency. -->
  <div class="max-w-7xl mx-auto px-4 my-8">
    <div class="accent-line w-full rounded-full"></div>
  </div>

  <ClosingBand />
</BaseLayout>
