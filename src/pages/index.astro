---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App.tsx';
import LayananSection from '../components/public/LayananSection.astro';
import ClosingBand from '../components/public/ClosingBand.astro';
import JapanTexture from '../components/public/JapanTexture.astro';
import Section from '../components/public/Section.astro';
import SectionTitle from '../components/public/SectionTitle.astro';
import Card from '../components/public/Card.astro';
import IconTileGrid from '../components/public/IconTileGrid.tsx';
import PersonGrid from '../components/public/PersonGrid.tsx';
import PartnerGrid from '../components/public/PartnerGrid.tsx';
import ReviewGrid from '../components/public/ReviewGrid.tsx';
import FaqList from '../components/public/FaqList.tsx';
import HistoryTimeline from '../components/public/HistoryTimeline.tsx';
import ContactForm from '../components/public/ContactForm.tsx';
import GalleryGrid from '../components/public/GalleryGrid.tsx';
import FactList from '../components/public/FactList.tsx';
import StepList from '../components/public/StepList.tsx';
import CheckList from '../components/public/CheckList.tsx';
import Icon from '../components/ui/Icon';
import {
  ABOUT_PARAGRAPHS,
  ABOUT_WELCOME,
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_HOURS,
  CONTACT_HOURS_NOTE,
  CONTACT_INSTAGRAM,
  CONTACT_LOCATION,
  CONTACT_MAPS_URL,
  CONTACT_PHONES,
  CONTACT_TIKTOK,
  CONTACT_WHATSAPP,
  FACILITIES,
  FLOW_STEPS,
  HISTORY,
  LEGAL_FACTS,
  MISSIONS,
  PLACEMENTS,
  PROGRAMS,
  PROGRAM_INCLUDES,
  PROGRAM_PAYMENT,
  PROGRAM_PRICE,
  REQUIREMENTS,
  REQUIREMENT_DOCS,
  TEAM,
  VISION,
  WHY_JAPAN,
  WHY_JAPAN_TIP,
} from '../lib/companyProfile';
import { PARTNERS } from '../lib/partners';
import { REVIEWS, REVIEW_SOURCE } from '../lib/testimonials';
import { FAQ } from '../lib/faq';
import { GALLERY } from '../lib/gallery';

/* WHY THE SECTIONS ARE COMPOSED HERE AND NOT EACH IN THEIR OWN FILE.
   Six of the blocks below are the same three elements — a Section, a SectionTitle
   and one primitive — with different data. A file per composition would add six
   files that contain no logic and no encapsulation, and each one would move the
   indexer's frozen inventory for no gain. The primitives ARE the reusable part and
   they are separate files; what is left here is page composition, which is what a
   page file is for.

   WHY THERE IS NO `.map()` IN THIS FILE. Iterating inside an `.astro` TEMPLATE
   breaks a hard invariant of this repo: `indexer/src/build.test.ts:428` requires
   zero unresolved references originating outside a test file, and the indexer
   resolves template interpolations against the FRONTMATTER MODULE SCOPE only — so a
   `.map()` callback parameter in a template is reported as an unresolved global
   (measured: 21 entries, every one a callback parameter). Every list on this page
   therefore lives in a `.tsx` primitive, where callbacks bind correctly. That is why
   CheckList exists at all: four of these blocks were inline maps before it did. */
---

<BaseLayout title="PT Amanah Sakura Japan — Job Portal" titleKey="doc.title_home" description="Lowongan kerja Jepang, penerimaan siswa baru, pengurusan visa, pendaftaran ujian JFT & SSW" showFooter={true}>
  <!-- `hero` turns the header band into the landing page's hero. It also moves
       the page's single h1 into the hero, so the company name in the header
       steps down to a div — see the note in App.tsx. Every OTHER route mounts
       the header without this flag and keeps the header h1, because for those
       routes it is the only one.

       WHY `client:load` AND NOT `client:only="preact"` — measured 2026-09-23.
       `client:only` renders NO server HTML, so with JavaScript unavailable this
       page had **0 h1** and no header at all: the hero headline and the entire
       nav existed only after hydration. On a landing page that is the one
       heading a search engine and a no-JS reader need.

       `client:load` server-renders the island and then hydrates it. Measured in
       a real browser against a real server (390px, `server.cjs`):
         · JS ON  — 1 h1, 13 header/nav links, 0 console errors, 0 page errors
         · JS OFF — 1 h1 ("Karier ke Jepang, dimulai dari sini."), 13 links
       Before the change the JS-OFF column read 0 h1 and 0 links.

       THE HYDRATION MISMATCH THIS COULD HAVE CAUSED, AND WHY IT DOES NOT.
       `langStore` is a `persistentAtom`, so a visitor with `asj_lang = "jp"`
       stored would render Japanese on the client against the server's default
       Indonesian. That is why the language is read through the store rather than
       inlined into the markup: the text is IDENTICAL in both renders for any
       visitor who has not switched, and for one who has, Preact patches the
       text on hydration. The measurement above is the check — 0 page errors on
       the default path, which is the path almost every visitor takes.

       The gated routes (admin/candidate/apply/ai-cv/share/siswa-baru) keep
       `client:only`: they are session-dependent SPAs that cannot function
       without JavaScript, so server-rendering them would add weight and expose
       gate markup for no reader's benefit. -->
  <App client:load hero />

  <!-- THE BAND THAT USED TO SIT HERE IS GONE, AND ITS THREE PARTS WENT TOGETHER.
       Owner ruling 2026-09-25, verbatim: "ini kok masih ada bukannya saya suruh
       hapus kemarin", with the count strip AND the section bar circled in the
       screenshot, and then "Hapus marquee juga" for the announcement strip.

       What was removed, in document order:
         1. `#global-announcement` — the rose marquee, ON THIS PAGE ONLY. The
            same band still exists on `/public` (`public.astro:25`), so the
            `marquee-*` rules in `motion.css` and `e2e/measure-marquee.mjs`
            stay valid and must NOT be deleted with it.
         2. the live-vacancy count strip (`#live-job-count`) — the only consumer
            of the `profile.hero_jobs_*` "lowongan aktif" key and of the
            `getPublicData()` call on this page. ⚠ THE KEY IS DELETED FROM BOTH
            DICTIONARIES, so do not spell it here: `i18n.keys.test.ts` scans
            source files for key-like strings and counts a key named in a
            COMMENT as "used", which is why writing it out made that gate red
            with "missing from the id dictionary" after the key was gone. Name
            the prefix, never the key.
         3. the SiteNav component — the desktop section bar (`sticky top-0
            z-sticky`). The component file is deleted, not merely unmounted;
            leaving an unused `.astro` behind would keep four frozen indexer
            counters and one e2e gate describing a bar no page renders.
       The `<script>` block that fed 1 and 2 is gone with them, so `index.astro`
       no longer imports `../lib/publicData` at all.

       ⚠ THIS COMMENT MUST NOT SPELL THE DELETED TAG. The indexer parses `.astro`
       COMMENTS as if they were markup, so writing the removed component's tag
       here re-creates the exact unresolved `template-component` reference the
       deletion was supposed to remove — measured 2026-09-25: the first draft of
       this comment did that and took `graph.unresolved` from 2 to 3 and the
       row-8 Renders-edge assertion from 0 to 1. Name the file, never the tag.
       (`Section.astro` carries the same warning for capitalised tag names.)

       ⚠ THE LINK TO `/loker` MOVED — IT WAS NOT DROPPED. That bar's "Lowongan"
       item was the ONLY `href="/loker"` in the entire site (measured
       2026-09-25: every other hit in `src/**` is prose; `Footer.astro` links only
       four fragments). Deleting the bar would have left `/` with ZERO paths to
       the vacancy list, and `e2e/test-landing.mjs`'s `LOKER_ROUTE` rule asserts
       that path exists. The single link now lives in the drawer
       (`App.tsx`, the always-visible block) because the owner's answer was
       "lahkan ada dari menu hamburger" — the drawer is the one navigation every
       visitor has, logged in or not. `LOKER_ROUTE` follows it there.

       DO NOT RESTORE THE BAR. The hero is the page's opening statement and the
       next thing a visitor sees should be `#kenapa-jepang`. -->

  <!-- The mascot rail stood here — a sticky grid column beside <main> that
       carried the princess down the page. Owner ruling 2026-09-24 removed her
       from the site entirely, so the rail, its grid column and the sticky
       `position` it needed are gone. <main> is a plain full-width block again;
       no empty track is reserved beside it. Do not restore the rail — the
       component, her renders and the scroll-tracking script were deleted with
       it. -->
  <!-- `overflow-x-clip` IS LOAD-BEARING — measured 2026-09-23, do not remove it.

       The two HORIZONTAL entrance kinds (`enter="slide-left"` / `"slide-right"`
       on #kenapa-jepang, #layanan, #fasilitas, #penempatan) park an un-revealed
       band at `translate3d(±2 × --enter-shift, 0, 0)` — 48px at the current
       `--enter-shift: 24px` (motion.css §9b). A band is FULL WIDTH, so while it
       is un-revealed it sticks 48px past the viewport and widens the document:

         measured at 390px on `/` — html.scrollWidth 423 vs clientWidth 390,
         i.e. **33px of horizontal scroll** (48px shift minus the 15px scrollbar).
         The offenders were `#layanan` and `#penempatan`, both 375px wide with
         `transform: matrix(1,0,0,1,48,0)`. After the reveal the same page
         measures scrollWidth 375 — the overflow exists ONLY pre-reveal.

       Two consequences, which is why this is a fix and not a nitpick:
         · A visitor can scroll the landing page sideways by 33px before the
           reveal runs. The bands below the fold never enter at load, so this is
           the state the page is in for everyone.
         · `e2e/test-headings.mjs` asserts "no horizontal overflow" and was RED
           on this, which made `e2e/test-headings.mutations.sh` and
           `test-headings-public.mutations.sh` ABORT on their baseline check —
           a red gate disarmed both proofs. That is the defect behind the defect.

       `clip` and not `hidden`: this distinction used to be load-bearing because
       `overflow: hidden` on one axis creates a scroll container, which would
       have broken the mascot rail's `position: sticky`. The rail is gone (owner
       ruling 2026-09-24), so either would work today — but `clip` is kept
       because it is still the accurate tool: it clips the transient pre-reveal
       offset without creating a scroll container, and nothing overflows
       horizontally once the bands are revealed (measured: 375 = 375). Visually
       the bands slide in from the edge instead of pushing the whole page
       sideways, which is what the motion was for. -->
  <main id="main-content" class="w-full max-w-[100rem] mx-auto pb-16 min-h-[50vh] overflow-x-clip">
    <!-- Section: Kenapa Jepang? (page 2 of the company profile) -->
    <Section id="kenapa-jepang" labelledBy="kenapa-jepang-title" enter="slide-left">
      <SectionTitle
        titleKey="profile.why_title"
        title="Kenapa Jepang?"
        descKey="profile.why_desc"
        desc="Tiga alasan yang paling sering disebut kandidat."
        accent="jobs"
        headingId="kenapa-jepang-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={WHY_JAPAN} />
      </div>
      <p data-lang="profile.why_tip" class="mt-6 max-w-[70ch] text-body-sm text-fg-muted">
        {WHY_JAPAN_TIP.text}
      </p>
    </Section>

    <!-- Section: Layanan — now a direct section instead of a hidden tab panel.
         The tab system (Loker vs Layanan) was removed because the LokerTable
         moved to its own page (/loker). This makes Layanan visible by default,
         which is better for SEO and for visitors who scroll the profile. -->
    <Section id="layanan" labelledBy="layanan-title" class="section-alt" enter="slide-right">
      <SectionTitle
        titleKey="profile.layanan_title"
        title="Program & Layanan ASJ"
        accent="program"
        headingId="layanan-title"
      />
      <div class="mt-8">
        <LayananSection />
      </div>
    </Section>

    <!-- Section: Program ASJ (pages 3 and 4). The price and its four inclusions
         ship together on purpose: a price without its inclusions is what makes a
         candidate assume there are hidden costs. -->
    <Section id="program" labelledBy="program-title" enter="grow">
      <SectionTitle
        titleKey="profile.prog_title"
        title="Program ASJ"
        descKey="profile.prog_desc"
        desc="Dua jalur resmi ke Jepang, plus pelatihan bahasanya."
        accent="program"
        headingId="program-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={PROGRAMS} />
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 md:gap-6">
        <Card class="flex flex-col gap-2">
          <span data-lang="profile.prog_price_label" class="text-caption uppercase font-bold text-accent-emerald">
            Biaya program
          </span>
          <span data-lang={PROGRAM_PRICE.key} class="text-section font-black text-fg">{PROGRAM_PRICE.text}</span>
          <span data-lang="profile.prog_payment" class="text-body-sm text-fg-muted">
            {PROGRAM_PAYMENT.text}
          </span>
        </Card>
        <Card class="flex flex-col gap-3">
          <span data-lang="profile.prog_includes_title" class="text-caption uppercase font-bold text-accent-emerald">
            Sudah termasuk
          </span>
          <CheckList items={PROGRAM_INCLUDES} accent="program" />
        </Card>
      </div>
    </Section>

    <!-- Section: Alur & Persyaratan (pages 3 and 4) -->
    <Section id="alur" labelledBy="alur-title" class="section-alt border border-line/30 rounded-panel" enter="curtain">
      <SectionTitle
        titleKey="profile.step_title"
        title="Bagaimana Prosesnya?"
        descKey="profile.step_desc"
        desc="Enam langkah dari pendaftaran sampai berangkat."
        accent="exam"
        headingId="alur-title"
      />
      <div class="mt-8">
        <StepList steps={FLOW_STEPS} />
      </div>

      <div class="mt-12">
        <h3 data-lang="profile.req_title" class="text-card-title font-bold text-fg">
          Persyaratan &amp; Dokumen
        </h3>
        <p data-lang="profile.req_desc" class="mt-1 text-body-sm text-fg-muted">
          Pastikan semuanya siap sebelum mendaftar.
        </p>
      </div>
      <div class="mt-5 grid gap-6 lg:grid-cols-2">
        <CheckList items={REQUIREMENTS} accent="exam" />
        <div>
          <h4 data-lang="profile.req_docs_title" class="text-caption uppercase font-bold text-accent-amber mb-3">
            Berkas yang disiapkan
          </h4>
          <CheckList items={REQUIREMENT_DOCS} icon="file-alt" accent="exam" />
        </div>
      </div>
    </Section>

    <!-- Section: Visi & Misi (pages 2 and 5). Editorial, not bento: a vision is one
         long sentence and a mission is four short points, so they are not two
         comparable cards and giving them equal heights would inflate one of them. -->
    <Section id="visi-misi" labelledBy="visi-misi-title" enter="drop">
      <SectionTitle
        titleKey="profile.vision_title"
        title="Visi & Misi"
        accent="identity"
        headingId="visi-misi-title"
      />
      <div class="mt-8 grid gap-4 lg:grid-cols-2 lg:gap-6">
        <Card radius="panel" padding="lg">
          <h3 data-lang="profile.vision_heading" class="text-card-title font-bold text-accent">
            Visi
          </h3>
          <p data-lang="profile.vision_body" class="mt-3 text-body-sm text-fg-muted">
            {VISION.text}
          </p>
        </Card>
        <Card radius="panel" padding="lg">
          <h3 data-lang="profile.mission_heading" class="text-card-title font-bold text-accent">
            Misi
          </h3>
          <div class="mt-3">
            <CheckList items={MISSIONS} as="ol" accent="identity" />
          </div>
        </Card>
      </div>
    </Section>

    <!-- Section: Legalitas (pages 6 and 7). A list, not a grid: a licence register
         has hierarchy and nothing to compare. Every value is a literal — a
         registration number is not translated. -->
    <Section id="legalitas" labelledBy="legalitas-title" class="section-alt border border-line/30 rounded-panel" enter="focus">
      <SectionTitle
        titleKey="profile.legal_title"
        title="Legalitas & Izin Resmi"
        descKey="profile.legal_desc"
        desc="Badan hukum dan nomor pendaftaran yang bisa diperiksa."
        accent="legal"
        headingId="legalitas-title"
      />
      <div class="mt-8">
        <FactList facts={LEGAL_FACTS} accent="legal" />
      </div>
    </Section>

    <!-- Section: Fasilitas (pages 11-15 plus the price inclusions on page 3) -->
    <Section id="fasilitas" labelledBy="fasilitas-title" enter="slide-left">
      <SectionTitle
        titleKey="profile.fac_title"
        title="Fasilitas & Dukungan"
        descKey="profile.fac_desc"
        desc="Yang kandidat dapatkan selama pelatihan."
        accent="program"
        headingId="fasilitas-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={FACILITIES} />
      </div>
    </Section>

    <!-- Section: Galeri Kegiatan (R3).
         WHY IT SITS DIRECTLY AFTER #fasilitas. The tile grid above makes claims
         ("Kelas Bahasa Jepang", "Ruang Kantor", "Ruang Tamu") and this section is
         the evidence for them — a claim followed immediately by the photograph of
         the thing it claims. Separation would weaken both.

         WHY ONLY NINE OF THE TWENTY-SIX AVAILABLE PHOTOGRAPHS. Four are excluded
         on purpose and the reasons are recorded in src/lib/gallery.ts rather than
         here, so the next person finds them before "completing" the grid: two are
         scans carrying a third party's signature and NIP, one is a CCTV frame with
         a burned-in timestamp and a surveillance angle, and one is a recruitment
         flyer whose price is baked into pixels. `gallery.test.ts` fails if any of
         them is re-added, and it also fails on a `src` that is not on disk — which
         is the exact hole the note at #tentang below used to describe.

         NO LIGHTBOX — see the note in GalleryGrid.tsx: one dialog contract. -->
    <Section id="galeri" labelledBy="galeri-title" class="section-alt border border-line/30 rounded-panel" enter="grow">
      <SectionTitle
        titleKey="profile.gallery_title"
        title="Galeri Kegiatan"
        descKey="profile.gallery_desc"
        desc="Suasana pelatihan, kantor, dan keberangkatan peserta."
        accent="identity"
        headingId="galeri-title"
      />
      <div class="mt-8">
        <GalleryGrid items={GALLERY} />
      </div>
    </Section>

    <!-- Section: Penempatan Kami (R4, pages 13 and 14).
         WHY THIS REPLACES TESTIMONIALS. The mockup put quotes in this slot; the
         company profile contains none. It does contain something more useful —
         four prefectures with dated interview banners behind them — so the slot
         shows provable evidence instead of invented praise.

         The list comes from PLACEMENTS, and the UI does not restate the
         prefecture NAMES anywhere: it renders the `value` columns as written, so
         adding a fifth placement is a one-line edit to companyProfile.ts and there
         is no second copy of the list to forget. (The hero's count is derived from
         the same module via PLACEMENT_PREFECTURES.) -->
    <!-- Section: Lowongan Ringkas (R2) WAS HERE and is deliberately gone.
         Owner ruling 2026-09-24: `/` is a company profile for MoU/business
         partners, not a job board, so a vacancy teaser does not belong on it.
         The vacancy list is still reachable from the section nav; the page
         keeps exactly ONE link to it. Do not restore this section — the
         supporting data (`profile.mini_*` keys, `JobMiniList.tsx`) was removed
         with it. -->

    <Section id="penempatan" labelledBy="penempatan-title" class="section-alt border border-line/30 rounded-panel" enter="slide-right">
      <SectionTitle
        titleKey="profile.place_title"
        title="Penempatan Kami"
        descKey="profile.place_desc"
        desc="Bidang dan prefektur tujuan yang tercatat pada dokumen perusahaan."
        accent="identity"
        headingId="penempatan-title"
      />
      {/* Placement scenery band — the section had only a FactList and no image.
          It copies the `#lokasi` banner's shape exactly (picture + avif/webp
          sources + a 1x/2x srcset), for the same reason: the ratio is reserved
          before load so the section does not jump, and the rounding lives on the
          wrapper so the corners clip the image.

          DECORATIVE, so `alt=""` + `aria-hidden`. The section already names the
          four prefectures in its FactList and states what it is in its h2; the
          band carries no information those two do not, which is the same test
          the `#lokasi` note applies to its own skyline.

          ARTWORK REPLACED 2026-09-28. This slot used to hold a photograph of Mt
          Fuji across a lake, chosen because it was exactly 3:2 and contained no
          people. The owner supplied a generated map of Japan instead and asked
          for it here, so both of those properties moved, and neither move is
          cosmetic:

            - the ratio is now 4:3, the source's own shape. It is read from the
              file rather than kept at 3:2, because a 3:2 box over a 4:3 picture
              makes `object-cover` discard a quarter of the map's height — and
              on a map the missing band is Kyushu or Hokkaido;
            - it is an ILLUSTRATION, not a photograph, so it sits in the asset
              gate's ILLUSTRATIONS set for the stronger of that set's two
              reasons: there is no subject who could consent or refuse, so
              §11.2's consent requirement has nothing to attach to.

          The declared 1200x900 is the real size of the 1x file. */}
      <picture class="u-drift-frame block mt-6 aspect-[4/3] overflow-clip rounded-panel border border-line/30">
        <source
          type="image/avif"
          srcset="/assets/ilustrasi/penempatan-banner.avif 1x, /assets/ilustrasi/penempatan-banner@2x.avif 2x"
        />
        <source
          type="image/webp"
          srcset="/assets/ilustrasi/penempatan-banner.webp 1x, /assets/ilustrasi/penempatan-banner@2x.webp 2x"
        />
        <img
          src="/assets/ilustrasi/penempatan-banner.webp"
          alt=""
          aria-hidden="true"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="u-drift"
        />
      </picture>
      <div class="mt-8">
        <FactList facts={PLACEMENTS} accent="identity" />
      </div>
      <p data-lang="profile.place_note" class="mt-6 max-w-[70ch] text-body-sm text-fg-muted">
        Nama prefektur ditulis dalam huruf Latin, sesuai dokumen resmi.
      </p>
    </Section>

    <!-- Section: Tentang Kami (S7, page 2).
         3 paragraphs of prose, and research places long text blocks as the case
         where a bento grid loses — forcing a paragraph into a card cuts a
         sequential argument into pieces that cannot be read in order.

         THE IMAGE GAP IS NOW CLOSED, and the note that used to sit here is kept
         in shortened form because its reasoning was right and its premise expired:
         it said the spec called for `fasilitas-gedung.webp` while `public/` held
         only icons and the logo, and that rendering an <img> at a path that does
         not exist would show a broken image, so the gap was recorded rather than
         filled with a placeholder. That was the correct call. The asset now exists
         (`public/assets/fasilitas-gedung.webp`, 1600x1066) along with 25 others, so
         the block ships with the photograph — and `gallery.test.ts` now fails on a
         `src` that is not on disk, so the failure mode that note was protecting
         against cannot come back silently.

         WHY THE PHOTO SITS BESIDE THE PROSE, NOT ABOVE IT. Three paragraphs of
         sequential argument should not be interrupted, and a full-width image
         would push the last paragraph below the fold on a laptop. The text column
         is capped at 68ch, which is the measure the paragraphs were already set
         to; the photo takes the remaining third. -->
    <Section id="tentang" labelledBy="tentang-title" enter="curtain">
      <SectionTitle
        titleKey="profile.about_title"
        title="Tentang Kami"
        descKey="profile.about_desc"
        desc="Lembaga pelatihan dan penempatan kerja di Ponorogo."
        accent="identity"
        headingId="tentang-title"
      />
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,68ch)_1fr] lg:items-start">
      <div class="flex flex-col gap-4">
        <p data-lang="profile.about_welcome" class="text-body font-semibold text-fg border-l-2 border-accent pl-4">
          {ABOUT_WELCOME.text}
        </p>

        <!-- The princess mascot stood here, beside the opening paragraph.
             Owner ruling 2026-09-24: the mascot is removed from the site
             entirely, so she and her `surface-raised` panel are gone. The
             paragraphs below carry the section on their own — she added warmth,
             not information, which is exactly why she could leave without a
             replacement. Do not restore her: the component and her renders were
             deleted with this block. -->
        <p data-lang="profile.about_p1" class="text-body text-fg-muted">
          {ABOUT_PARAGRAPHS[0].text}
        </p>
        <p data-lang="profile.about_p2" class="text-body text-fg-muted">
          {ABOUT_PARAGRAPHS[1].text}
        </p>

        <!-- ── Status SO — stated plainly, and high up ────────────────────────
             Owner ruling 2026-09-27: the page must not read as "ASJ sends
             workers to Japan". ASJ is a small LPK WITHOUT SO (Sending
             Organization) status, so it is not authorised to depart a worker
             directly; the departure is executed by the MoU partner LPKs/PTs
             (SOs). That fact is now in about_p2, but a paragraph is easy to
             skim past — and this is the one claim a candidate or a prospective
             partner most needs to read correctly.

