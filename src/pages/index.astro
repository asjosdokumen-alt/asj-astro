    .pm-inset rect {
      fill: rgb(8 14 26 / 0.85);
      stroke: rgb(148 163 184 / 0.35);
      stroke-width: 1;
      stroke-dasharray: 4 4;
    }
    .pm-inset text {
      fill: rgb(148 163 184 / 0.75);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.18em;
    }

    /* Angka besar di atas peta — satu-satunya klaim di panggung ini, dan
       keduanya datang dari daftar yang sama dengan panel. */
    /* Angka-angka ini DULU menempel di pojok kiri-bawah panggung, dan di sana
       ia bertabrakan dengan inset Okinawa — terukur di 1440 px: label
       "PREFECTUR" menimpa pulau-pulau inset. Sekarang ia baris biasa di atas
       tombol wilayah: tidak bisa menumpuk apa pun di lebar mana pun, dan di
       ponsel ia muncul tepat setelah peta. */
    .pm-stats {
      display: flex;
      gap: 1.75rem;
      margin: 0 0 1.1rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--color-line);
