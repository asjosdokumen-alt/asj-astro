    /* Pulau-pulau inset itu KECIL — beberapa hanya 2-3 unit di kanvas 1000.
       Garis 0,9 px yang sama dengan prefektur daratan membuatnya praktis tidak
       terlihat (terukur: kotak inset tampak kosong). Di sini ia dapat isi dan
       garis sendiri, lebih tebal, karena skalanya memang lain. */
    .pm-prefs path[data-inset] {
      fill: rgb(148 163 184 / 0.45);
      stroke: rgb(255 255 255 / 0.65);
      stroke-width: 1.8;
    }
    .pm-prefs path[data-inset].is-lit {
