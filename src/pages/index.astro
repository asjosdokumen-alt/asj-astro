      />
      <div class="mt-8">
        <IconTileGrid tiles={WHY_JAPAN} />
      </div>
      <p data-lang="profile.why_tip" class="mt-6 max-w-[70ch] text-body-sm text-fg-muted">
        {WHY_JAPAN_TIP.text}
      </p>
    </Section>

    <!-- Section: Layanan — now a direct section instead of a hidden tab panel.
         The tab system (Loker vs Layanan) was removed because the LokerTable
         moved to its own page (/loker). This makes Layanan visible by default,
         which is better for SEO and for visitors who scroll the profile. -->
    <Section id="layanan" labelledBy="layanan-title" class="section-alt" enter="slide-right">
      <SectionTitle
        titleKey="profile.layanan_title"
        title="Program & Layanan ASJ"
        accent="program"
        headingId="layanan-title"
      />
      <div class="mt-8">
        <LayananSection />
      </div>
    </Section>

    <!-- Section: Program ASJ (pages 3 and 4). The price and its four inclusions
         ship together on purpose: a price without its inclusions is what makes a
         candidate assume there are hidden costs.

         CONTACT SHEET, BUKAN TIGA KARTU (2026-11-11). Arah B: seksi ini jadi
         babak kedua yang punya gambar sendiri. Yang berubah cuma pembungkusnya —
         data, kunci i18n, dan `alt` tetap milik `PROGRAMS` — karena tiga kartu
         berbingkai di tengah rangkaian film terbaca sebagai brosur yang ditempel.
         Tiga plat berjajar, garis rambut di antaranya, keterangan di bawah tiap
         plat, lalu satu baris credit untuk harga dan isi program.

         RESOLUSI: draf sesi sebelumnya mencatat plate program hanya 600x400 dan
         meminta tinggi strip dibatasi supaya tidak upscale 1,6x. Premis itu tidak
         lengkap — varian `@2x` ADA dan berukuran 1200x800 (diukur 2026-11-11),
         jadi tiga kolom pada 1440 px (459 px CSS) tetap tajam di layar 2x dan
         tidak perlu kompromi tinggi. `srcset` 1x/2x yang sudah dipakai komponen
         ini yang membuatnya benar. -->
    <Section id="program" labelledBy="program-title" enter="grow">
      <SectionTitle
        titleKey="profile.prog_title"
        title="Program ASJ"
        descKey="profile.prog_desc"
        desc="Dua jalur resmi ke Jepang, plus pelatihan bahasanya."
        accent="program"
        headingId="program-title"
      />
      <div class="mt-8">
        <IconTileGrid tiles={PROGRAMS} presentation="sheet" />
      </div>
      {/* Baris credit, bukan dua kartu. Garis rambut di atas memisahkannya dari
          contact sheet; label kecil ber-tracking, angka besar, lalu isi program
          sebagai daftar bertanda. Bentuk yang sama dengan `.dossier-*` di
