    /* ── LAMPU STUDIO: kelopak sakura padam selama film diputar ────────────
       `#sakura-particles` (BaseLayout) adalah lapisan `position: fixed` yang
       hanya hidup di tema terang. Di atas panggung gelap kelopak itu terbaca
       sebagai debu di lensa — terukur pada tangkapan 1440x900: titik pink
       melayang di atas plat paspor. Yang diubah di sini hanya opasitas, bukan
       `display`, supaya animasi 30 kelopak tidak dibuat ulang tiap kali
       panggung keluar-masuk viewport. Statusnya ditulis oleh
       IntersectionObserver band (lihat `petals` di skrip `#alur`). */
    #sakura-particles {
      transition: opacity 0.7s ease;
    }

    /* ── PONSEL: PANGGUNG YANG SAMA, BUKAN TUMPUKAN (2026-11-11) ───────────
       Owner: "scrollnya di bikin tumpuk ke bawah gini? gak jadi 1 gitu".
       Sebelum ini, di <=860 px band film DIBONGKAR menjadi daftar tujuh babak:
       track setinggi 7,1 layar, tiap babak plat 26rem berbingkai oval + judul +
       badan, lalu babak berikutnya. Terukur di 390 px: `#alur` = 5.986 px
       (7,1 layar) dan halaman 30.331 px. Itu bukan film, itu daftar.

       Sekarang STRUKTUR desktop dipakai apa adanya di ponsel — track 7 x 72svh
       + 100svh, panggung sticky, babak absolut yang saling menutup — dan yang
       disesuaikan hanya hal-hal yang memang soal layar potret:
         · plat penuh (bukan kotak 26rem) dan `object-position` dinaikkan supaya
           kepala tidak terpotong di frame 2:3;
         · scrim dibalik jadi DARI BAWAH, karena teksnya pindah ke bawah;
         · teks menempel bawah, satu kolom;
         · klip POTRET yang dipakai (`--p`), bukan yang lanskap.

       ⚠ `prefers-reduced-motion` TIDAK ikut aturan ini. Di blok berikutnya ia
       tetap membongkar band menjadi daftar: pengguna yang meminta gerak
       dikurangi tidak boleh mendapat tujuh babak yang menutupi satu sama lain
       tanpa cara mencapainya. Dua audiens, dua tata letak — bukan satu kompromi
       untuk keduanya. */
    @media (max-width: 860px) {
      .film-img,
      .film-vid {
        /* 42%, bukan 50%: subjek plat potret duduk di sepertiga atas; di 50%
           dagunya terpotong oleh bilah teks bawah. */
        object-position: 50% 42%;
      }
      .film-vid--p {
        display: block;
      }
      .film-vid--w {
        display: none;
      }
      .film-scrim {
        background:
          linear-gradient(
            to top,
            rgb(4 6 10 / 0.94) 0%,
            rgb(4 6 10 / 0.72) 28%,
            rgb(4 6 10 / 0.18) 58%,
            rgb(4 6 10 / 0) 78%
          ),
          radial-gradient(130% 100% at 50% 38%, transparent 52%, rgb(4 6 10 / 0.55) 100%);
      }
      .film-copy {
        left: 0;
        right: 0;
        top: auto;
        bottom: 0;
        height: auto;
        width: auto;
        justify-content: flex-end;
        padding: 0 1.25rem 2.4rem;
        text-shadow: 0 2px 26px rgb(4 6 10 / 0.85);
      }
      .film-copy h3 {
        font-size: clamp(1.9rem, 8.2vw, 2.6rem);
      }
      .film-body {
        max-width: 34ch;
      }
      /* Coda dipusatkan lewat `translateX(-50%)` di desktop; di sini kolomnya
         sudah selebar layar, jadi transform itu harus dilepas atau teksnya
         keluar setengah lebar. */
      .film-copy-coda {
        left: 0;
        right: 0;
        transform: none;
        width: auto;
        max-width: none;
        padding: 0 1.25rem 2.4rem;
      }
      .film-coda-t {
        font-size: clamp(1.5rem, 6.4vw, 2.1rem);
      }
      .film-coda-b {
        max-width: 30ch;
      }
      /* Chrome panggung (braket, rel, kaki, progres) mengukur sesuatu yang di
         390 px tidak ada ruangnya. */
      .film-hud,
      .film-rail,
      .film-foot,
      .film-progress {
        display: none;
      }
    }

    /* Ponsel-lama DAN reduced-motion dulu memakai bentuk yang sama. Sejak
       2026-11-11 hanya reduced-motion: daftar bertumpuk, tanpa sticky dan tanpa
       babak tersembunyi. Kalau pengguna ini tetap diberi panggung, isi band
       menjadi tidak terjangkau. */
    @media (prefers-reduced-motion: reduce) {
      .film-track {
        height: auto;
      }
      .film-stage {
        position: static;
        height: auto;
        display: flex;
        flex-direction: column;
        padding: 0.5rem 0 1.25rem;
      }
      .film-ch {
        position: relative;
        inset: auto;
        opacity: 1;
        display: grid;
        gap: 1.1rem;
        padding: 1.25rem 1.25rem 2.25rem;
      }
      .film-plate {
        position: relative;
        inset: auto;
        aspect-ratio: 1024 / 1464;
        width: 100%;
        max-width: min(26rem, 78vw);
        margin: 0 auto;
      }
      .film-img,
      .film-vid {
        border-radius: 18px;
        /* Radius HARUS 50%: tepi elemen jatuh tepat di ujung gradien. Dengan
           62%/66% tepi atas gambar masih ~20% opaque dan terbaca sebagai garis
           lurus keras — jebakan yang sama dengan versi story-3d. */
        -webkit-mask-image: radial-gradient(
          ellipse 50% 50% at 50% 46%,
          #000 32%,
          rgb(0 0 0 / 0.9) 54%,
          rgb(0 0 0 / 0.42) 72%,
          transparent 90%
        );
        mask-image: radial-gradient(
          ellipse 50% 50% at 50% 46%,
          #000 32%,
          rgb(0 0 0 / 0.9) 54%,
          rgb(0 0 0 / 0.42) 72%,
          transparent 90%
        );
      }
      .film-vid--p {
        display: block;
      }
      .film-vid--w {
        display: none;
      }
      .film-ch.is-on .film-vid {
        opacity: 1;
      }
      .film-scrim {
        display: none;
      }
      .film-copy {
        position: relative;
        inset: auto;
        width: auto;
        height: auto;
        max-width: min(30rem, 90vw);
        margin: 0 auto;
        padding: 0;
      }
      /* Coda memakai `translateX(-50%)` untuk memusatkan dirinya di panggung.
         Di tata letak bertumpuk ia sudah dipusatkan oleh `margin: 0 auto`, jadi
         transform itu HARUS dilepas — kalau tidak, teksnya bergeser setengah
         lebar keluar layar. */
      .film-copy-coda {
        left: auto;
        transform: none;
        width: auto;
        max-width: min(30rem, 90vw);
      }
      .film-coda-t {
        font-size: clamp(1.5rem, 6.4vw, 2.1rem);
      }
      .film-coda-b {
        max-width: 30ch;
      }
      .film-copy h3 {
        font-size: clamp(1.9rem, 8.2vw, 2.6rem);
        text-shadow: none;
      }
      .film-body {
        opacity: 1;
        transform: none;
        border-top-color: rgb(255 255 255 / 0.16);
      }
      /* Chrome panggung tidak punya arti di daftar bertumpuk: braket, rel,
         kaki, dan garis progres semuanya mengukur sesuatu yang tidak ada.
         Sebelum perbaikan ini aturannya rusak (deklarasinya `letter-spacing`
         milik `.film-brand`, bukan `display: none`), jadi di ponsel keempatnya
         tetap tergambar menumpuk di atas daftar. */
      .film-hud,
      .film-rail,
      .film-foot,
      .film-progress {
        display: none;
      }
    }
  </style>

  <script is:inline>
    /* Penggerak band "Satu Jalan". Ditulis inline supaya tidak menambah satu
       entry bundle lagi — halaman ini sudah punya anggaran bundle sendiri, dan
       empat puluh baris di sini tidak sepadan dengan satu chunk baru.

       Tiga hal yang dijaga di sini, semuanya pernah salah di versi sebelumnya:
       1. `maxScroll` TIDAK diukur sekali di awal. Tinggi dokumen berubah setelah
          font dan gambar masuk, dan target yang tidak pernah sampai membuat
          semua teks tertangkap di tengah fade-in (tampak abu-abu).
       2. Loop berhenti saat band keluar layar. Tanpa itu, enam belas write
          transform per frame terus jalan di seluruh halaman.
       3. Tata letak bertumpuk (ponsel / reduced-motion) membersihkan SEMUA gaya
          inline. Kalau tidak, `opacity:0` dari desktop tertinggal dan babak yang
          seharusnya terlihat jadi hilang setelah rotasi layar. */
    (() => {
      const band = document.querySelector('[data-film]');
      if (!band) return;
      const track = band.querySelector('[data-film-track]');
      const chs = [...band.querySelectorAll('[data-film-ch]')];
      const dots = [...band.querySelectorAll('[data-film-dot]')];
      /* Dua elemen video per babak (lanskap untuk desktop, potret untuk tata
         letak bertumpuk). Keduanya `preload="none"`, jadi yang tidak dipakai
         tidak pernah mengunduh satu byte pun — dan hanya satu yang `display`,
         sehingga tetap satu decoder yang berjalan. */
      const vids = chs.map((c) => ({
        p: c.querySelector('video[data-vid="p"]'),
        w: c.querySelector('video[data-vid="w"]'),
      }));
      const plates = chs.map((c) => c.querySelector('.film-plate'));
      const bar = band.querySelector('[data-film-progress]');
      const coord = band.querySelector('[data-film-coord]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const N = chs.length;
      /* Empat babak pertama masih di Ponorogo; keberangkatan dan kedatangan
         memakai label perjalanan, bukan koordinat karangan. Entri KETUJUH milik
         coda: koordinatnya kembali ke titik awal, karena itulah yang dikatakan
         frame penutupnya — peserta berikutnya mulai dari Ponorogo lagi. Chrome
         ikut bercerita, bukan cuma menghias. */
      const COORD = [
        'PONOROGO · 7.86°S 111.46°E',
        'PONOROGO · 7.86°S 111.46°E',
        'PONOROGO · 7.86°S 111.46°E',
        'PONOROGO · 7.86°S 111.46°E',
        'PONOROGO · 7.86°S 111.46°E',
        'JEPANG · 35.68°N 139.69°E',
        'PONOROGO · 7.86°S 111.46°E',
      ];

      let raf = 0;
      let active = -1;
      let inView = false;
      let stacked = false;
      /* Varian klip yang sedang TAMPIL, dibaca dari CSS — bukan dari lebar
         jendela. Sejak 2026-11-11 ponsel memakai penggerak scroll yang sama
         dengan desktop, jadi `stacked` tidak lagi menandakan tata letak, dan
         memilih klip dari flag itu berarti memutar elemen `display:none`:
         terukur di 390 px sesudah perubahan pertama — klip potret berhenti di
         t=0 sementara klip lanskap yang tak terlihat "diputar". */
      let portrait = false;

      const clamp = (v) => Math.min(1, Math.max(0, v));

      function stackedNow() {
        /* HANYA reduced-motion sejak 2026-11-11. Ponsel tidak lagi membongkar
           band menjadi daftar (lihat blok `@media (max-width: 860px)` di atas),
           jadi ia memakai penggerak scroll yang sama dengan desktop — termasuk
           pemilihan varian klip, yang ditentukan oleh `display` di CSS. */
        return reduce.matches;
      }

      /* Tata letak bertumpuk: semua babak terlihat, tanpa transform sisa. */
      function flatten() {
        chs.forEach((c) => {
          c.classList.add('is-on');
          c.classList.add('beat');
          c.style.opacity = '';
        });
        plates.forEach((p) => {
          p.style.transform = '';
        });
        if (bar) bar.style.width = '0';
      }

      function paint(p) {
        const seg = 1 / N;
        let best = 0;
        let bestD = 9;

        for (let i = 0; i < N; i++) {
          const local = (p - i * seg) / seg;
          const ch = chs[i];
          /* Babak i terlihat penuh dari local 0 sampai 1; babak i+1 menutupnya
             lewat fade 12% pertama. Jadi tidak ada lubang hitam di batas —
             kesalahan yang membuat versi pertama berkedip. */
          const op = local <= -0.02 || local >= 1.14 ? 0 : i === 0 ? 1 : clamp(local / 0.12);
          ch.style.opacity = op.toFixed(3);

          if (op > 0) {
            /* Kamera tidak pernah diam: dorong 6% + geser 2,4% sepanjang babak.
               Ini yang membuatnya terasa rekaman, bukan foto yang di-slide.

               Arahnya BERGANTIAN per babak — ganjil mendorong masuk, genap
               menarik keluar. Dua shot berurutan yang mendorong ke arah sama
               terbaca sebagai satu gerakan yang tersendat; bergantian membuat
               tiap potongan terasa keputusan. Skala tidak pernah turun di bawah
               1,06, jadi tepi plat tidak pernah terbuka. */
            const l = clamp(local);
            const dir = i % 2 === 0 ? 1 : -1;
            const sc = dir > 0 ? 1.06 + 0.07 * l : 1.13 - 0.07 * l;
            plates[i].style.transform =
              'translate3d(' +
              ((-1.2 + 2.4 * l) * dir).toFixed(2) +
              '%,' +
              ((1.4 - 2.8 * l) * dir).toFixed(2) +
              '%,0) scale(' +
              sc.toFixed(4) +
              ')';
          }

          /* Ketukan kedua: badan menyusul di 38% babak. */
          const beat = local > 0.38;
          if (ch.classList.contains('beat') !== beat) ch.classList.toggle('beat', beat);

          const d = Math.abs(local - 0.5);
          if (d < bestD) {
            bestD = d;
            best = i;
          }
        }

        if (bar) {
          /* Progres mencapai 100% tepat di akhir babak 06, lalu MENGOSONGKAN
             DIRI selama coda. Ini satu-satunya tempat di halaman ini di mana
             bar bergerak mundur, dan itu memang maksudnya: siklusnya kembali ke
             awal. Bar yang berhenti penuh di ujung akan mengatakan "selesai",
             padahal frame terakhirnya mengatakan "dimulai lagi". */
          const chaptersEnd = (N - 1) / N;
          const w =
            p <= chaptersEnd
              ? (p / chaptersEnd) * 100
              : (1 - (p - chaptersEnd) / (1 - chaptersEnd)) * 100;
          bar.style.width = Math.max(0, Math.min(100, w)).toFixed(2) + '%';
        }

        if (best !== active) {
          active = best;
          /* Rel hanya punya titik untuk enam babak — coda bukan langkah, jadi
             titik terakhir tetap menyala saat frame penutup tampil. */
          dots.forEach((d, k) => d.classList.toggle('is-on', k === Math.min(best, dots.length - 1)));
          if (coord) coord.textContent = COORD[best];
          chs.forEach((c, k) => c.classList.toggle('is-on', k === best));
          /* Hanya klip babak aktif yang diputar — 3 decoder serentak tidak
             pernah menjadi anggaran halaman ini. Yang diputar adalah varian
             yang sedang `display`: lanskap di desktop, potret di tata letak
             bertumpuk. Varian satunya dipause, bukan dibiarkan jalan diam-diam
             (elemen `display:none` tetap men-decode kalau tidak dipause). */
          vids.forEach((set, k) => {
            const on = portrait ? set.p : set.w;
            const off = portrait ? set.w : set.p;
            if (off && !off.paused) off.pause();
            if (!on) return;
            if (k === best && inView) on.play().catch(() => {});
            else if (!on.paused) on.pause();
          });
        }
      }

      function frame() {
        raf = 0;
        if (stacked) return;
        const box = track.getBoundingClientRect();
        const span = track.offsetHeight - window.innerHeight;
        if (span <= 0) return;
        paint(clamp(-box.top / span));
      }

      function kick() {
        if (!raf) raf = window.requestAnimationFrame(frame);
      }

      const pauseAll = () => {
        vids.forEach((s) => {
          if (s.p && !s.p.paused) s.p.pause();
          if (s.w && !s.w.paused) s.w.pause();
        });
      };

      function sync() {
        stacked = stackedNow();
        /* Sumber kebenaran varian klip adalah CSS yang menyembunyikan salah
           satunya, bukan angka 860 yang ditulis dua kali di dua bahasa. */
        const probe = vids.find((v) => v.p)?.p;
        portrait = probe ? getComputedStyle(probe).display !== 'none' : false;
        if (stacked) {
          if (raf) {
            window.cancelAnimationFrame(raf);
            raf = 0;
          }
          flatten();
          pauseAll();
        } else {
          chs.forEach((c) => c.classList.remove('is-on', 'beat'));
          /* `active` direset supaya `paint()` berikutnya menilai ulang babak
             dan menyalakan varian video yang sekarang `display`. Tanpa ini,
             berpindah 860 px ke atas meninggalkan panggung tanpa klip sampai
             babak berganti. */
          active = -1;
          kick();
        }
      }

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            const was = inView;
            inView = entries[0].isIntersecting;
            /* ── LAMPU STUDIO PADAM saat film mulai ──────────────────────────
               `#sakura-particles` (BaseLayout) adalah lapisan kelopak yang
               `position: fixed` dan hanya hidup di tema terang. Begitu halaman
               punya tema terang lagi, kelopak itu terbang DI ATAS panggung
               gelap — terukur pada tangkapan 1440x900: titik pink melayang di
               atas plat paspor. Di tema gelap tidak pernah terlihat karena
               lapisannya memang disembunyikan.

               Yang benar bukan mematikan kelopaknya, tapi memadamkannya selama
               film diputar: halaman terang = ruangan, panggung film = layar.
               Transisinya di CSS (`#sakura-particles`), di sini cuma status.

               STATUS KELOPAK PINDAH KE SATU PEMILIK (2026-11-11). Dulu blok ini
               satu-satunya penulis `opacity`. Sejak `#penempatan` juga jadi band
               gelap, dua penulis akan saling menimpa: film keluar viewport
               menulis `''` sementara babak still masih di layar. Sekarang satu
               observer di akhir berkas yang memiliki status itu untuk SEMUA
               panggung gelap; blok ini tidak lagi menulisnya. */
            if (inView) {
              /* `active` direset HANYA saat status berubah masuk. Tanpa ini,
                 klip tidak pernah mulai kalau panggung masuk viewport SETELAH
                 babak aktifnya ditetapkan: keputusan play() digantung pada
                 `best !== active`, dan `active` sudah sama. Terukur: delapan
                 video, satu sudah `readyState 4`, nol yang berjalan. */
              if (!was) active = -1;
              kick();
            } else pauseAll();
          },
          /* ── 25% -> 0 (2026-11-14) ──────────────────────────────────────
             `25%` membuat panggung dianggap "masuk" saat ia masih 225 px DI
             BAWAH lipatan, dan `kick()` langsung memutar babak pertama —
             terukur: 202,6 KB mp4 diunduh pada 1,1 s, SEBELUM event `load`,
             untuk klip yang belum terlihat siapa pun. Dengan 0, klip mulai
             saat panggung benar-benar menyentuh viewport; poster tetap
             tampil lebih dulu, jadi tidak ada lubang visual. */
          { rootMargin: '0px' }
        );
        io.observe(track);
      } else {
        inView = true;
      }

      /* Di tata letak bertumpuk, tiap babak terlihat berurutan, jadi "babak
         aktif" tidak ada. Klipnya diputar per-babak saat babaknya masuk layar —
         tanpa ini mp4 hanya menjadi poster yang tidak pernah bergerak, karena
         `paint()` tidak dipanggil sama sekali di mode bertumpuk.

         Yang diputar adalah varian POTRET (`data-vid="p"`), bukan
         `querySelector('video')`: sejak tiap babak punya dua elemen video,
         `querySelector` mengembalikan yang LANSKAP — yang di sini `display:none`
         — dan hasil terukurnya "ponsel memutar klip desktop" sementara klip
         potret tidak pernah jalan. */
      if ('IntersectionObserver' in window) {
        const vio = new IntersectionObserver(
          (entries) => {
            if (!stacked || reduce.matches) return;
            entries.forEach((e) => {
              const v = e.target.querySelector('video[data-vid="p"]');
              if (!v) return;
              if (e.intersectionRatio > 0.4) v.play().catch(() => {});
              else if (!v.paused) v.pause();
            });
          },
          { threshold: [0, 0.4, 1] }
        );
        chs.forEach((c) => c.querySelector('video[data-vid="p"]') && vio.observe(c));
      }

      window.addEventListener('scroll', kick, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      reduce.addEventListener('change', sync);
      sync();
    })();
  </script>

  <script is:inline>
    /* ── LAMPU STUDIO: satu pemilik status kelopak untuk semua band gelap ───
       `#sakura-particles` (BaseLayout) adalah lapisan `position: fixed` yang
       hanya hidup di tema terang. Di atas plat gelap ia terbaca sebagai debu di
       lensa — terukur pada tangkapan 1440x900 sebagai titik pink yang melayang
       di atas paspor, dan lagi di atas plat keberangkatan `#penempatan`.

       Dua penulis status adalah bug yang menunggu giliran: begitu satu band
       keluar viewport ia menulis `opacity: ''` tanpa tahu band lain masih di
       layar. Jadi di sini satu observer menghitung berapa panggung gelap yang
       SEDANG terlihat, dan hanya nol yang menyalakan kelopak lagi.

       Yang diubah opasitasnya, bukan `display`: 30 kelopak beranimasi tidak
       dibuat ulang setiap kali panggung masuk-keluar viewport. */
    (() => {
      const stages = [...document.querySelectorAll('[data-film], .pm-stage')];
      if (!stages.length || !('IntersectionObserver' in window)) return;
      const live = new Set();
      const paint = () => {
        const petals = document.getElementById('sakura-particles');
        if (petals) petals.style.opacity = live.size ? '0' : '';
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) live.add(e.target);
            else live.delete(e.target);
          });
          paint();
        },
        { threshold: 0 }
      );
      stages.forEach((s) => io.observe(s));
    })();
  </script>

  <script is:inline>
    /* ── PETA PENEMPATAN: satu pemilihan, tiga tampilan ────────────────────
       Owner minta peta dan informasi penempatan jadi satu kesatuan. Yang
       menghubungkan keduanya di sini hanya satu keadaan (`selected`): tombol
       wilayah, path prefecture di peta, dan isi panel semuanya membaca keadaan
       itu. Tidak ada teks yang dirakit di sini — semua butir sudah dirender
       sekali dengan `data-region`, jadi `data-lang` tetap bekerja dan tidak ada
       salinan data yang bisa melenceng dari companyProfile.ts.

       Peta itu `role="img"` (satu gambar bagi pembaca layar), jadi kontrol yang
       bisa difokus tetap tombol wilayah di panel — bukan path SVG. Karena itu
       klik pada path hanya jalan untuk penunjuk, dan keyboard memakai tombol
       dengan pola tablist (panah kiri/kanan). */
    (() => {
      const root = document.querySelector('[data-pm]');
      if (!root) return;

      const tabs = [...root.querySelectorAll('.pm-tab')];
      const paths = [...root.querySelectorAll('.pm-prefs path')];
      const regions = [...root.querySelectorAll('.pm-region')];
      const prefs = [...root.querySelectorAll('.pm-prefs li')];
      const fields = [...root.querySelectorAll('.pm-fields li')];
      const empty = root.querySelector('.pm-empty');
      if (!tabs.length) return;

      function select(r) {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.r === r)));
        paths.forEach((p) => p.classList.toggle('is-lit', p.dataset.r === r));
        regions.forEach((el) => {
          el.hidden = el.dataset.region !== r;
        });
        prefs.forEach((li) => {
          li.hidden = li.dataset.region !== r;
        });
        let n = 0;
        fields.forEach((li) => {
          const on = (li.dataset.regions || '').split(' ').includes(r);
          li.hidden = !on;
          if (on) n++;
        });
        if (empty) empty.hidden = n > 0;
      }

      function hover(r, on) {
        paths.forEach((p) => p.classList.toggle('is-hot', on && p.dataset.r === r));
      }

      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.r));
        t.addEventListener('mouseenter', () => hover(t.dataset.r, true));
        t.addEventListener('mouseleave', () => hover(t.dataset.r, false));
        t.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const next = tabs[(i + step + tabs.length) % tabs.length];
          next.focus();
          select(next.dataset.r);
        });
      });

      paths.forEach((p) => {
        p.addEventListener('click', () => select(p.dataset.r));
        p.addEventListener('mouseenter', () => hover(p.dataset.r, true));
        p.addEventListener('mouseleave', () => hover(p.dataset.r, false));
      });

      select('kanto');
    })();
  </script>


  <!-- ═══════════════════════════════════════════════════════════════════
       POLISH HALAMAN PROFIL — scroll, kursor, dan kata (2026-11-13)

       TIGA HAL YANG DIKELUHKAN PEMILIK, dan masing-masing punya satu blok
       di bawah:
         1. "scroll mouse nya kek kaku"  -> Lenis (lerp 0.09)
         2. "interactif cursornya belum maksimal" -> lapis kursor §11
         3. "transisinya kurang"        -> kata bermasker §10 (dipasang di
                                           BaseLayout, bukan di sini)

       MENGAPA LENIS DAN BUKAN GSAP. Skill `cinematic-gsap-lenis-motion-system`
       memakai keduanya, tapi GSAP+ScrollTrigger ~50 KB gz untuk pekerjaan
       yang di repo ini SUDAH dikerjakan: `motion.css` §9/§9b punya sistem
       reveal sendiri (IntersectionObserver + @keyframes) dan band film punya
       penggerak rAF sendiri. Yang benar-benar hilang cuma PEREDAM SCROLL —
       dan itu Lenis saja, ~3 KB gz.

       TERUKUR SEBELUM: satu notch wheel = 2 posisi scroll (1200 -> 1320).
       Tidak ada frame antara; halaman melompat 120 px per notch, dan
       halaman ini 23.302 px di 1440x900 = ~194 lompatan.

       GERBANG. Lenis hanya hidup kalau `prefers-reduced-motion` TIDAK aktif
       dan penunjuknya presisi (mouse/trackpad). Di ponsel ia tidak pernah
       dibuat: `smoothWheel` tidak menyentuh sentuhan, jadi menyalakannya
       hanya menambah satu loop rAF yang tidak melakukan apa-apa.
       ═══════════════════════════════════════════════════════════════════ -->
  <script>
    import Lenis from 'lenis';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    /* ── 1. SCROLL ──────────────────────────────────────────────────────
       `lerp` adalah porsi jarak yang ditempuh per frame, jadi ia menentukan
       LAMA BERHENTI, bukan kehalusan. Rumusnya: sisa = (1 - lerp)^frame.

       TERUKUR 2026-11-14 dengan `lerp: 0.09` (nilai skill): satu notch 100 px
       baru berhenti setelah **979 ms**. Di halaman 23.302 px itu terbaca
       sebagai mengambang, bukan halus — keluhan pemilik: "mouse nya aneh".

       Nilai yang dipakai sekarang diukur, bukan dipilih dari band skill:
         0.09 -> 979 ms   (terlalu berat)
         0.16 -> ~430 ms
         0.20 -> ~340 ms  <- dipakai
       `wheelMultiplier: 1` juga dikembalikan: 0.9 memotong 10% jarak tiap
       notch, dan pada halaman sepanjang ini yang terasa bukan "halus" tapi
       "berat". */
    const SCROLL_LERP = 0.24;
    const WHEEL_MULT = 1;

    /* Jarak maksimum cincin kursor dari titiknya, dalam px. Lihat komentar di
       `loop()`: lerp saja tidak membatasi jarak, dan cincin yang tertinggal
       ratusan px terbaca sebagai kursor yang lepas. 40 px = ~1,4x diameter
       cincin (28 px). */
    const MAX_CURSOR_LAG = 40;
    let lenis: Lenis | null = null;
    let raf = 0;

    const tick = (time: number) => {
      if (!lenis) return;
      lenis.raf(time);
      raf = requestAnimationFrame(tick);
    };

    function startSmooth() {
      if (lenis || reduce.matches || !fine.matches) return;
      lenis = new Lenis({
        lerp: SCROLL_LERP,
        wheelMultiplier: WHEEL_MULT,
        smoothWheel: true,
        anchors: true,
      });
      document.documentElement.classList.add('has-smooth');
      raf = requestAnimationFrame(tick);
    }

    function stopSmooth() {
      if (!lenis) return;
      cancelAnimationFrame(raf);
      lenis.destroy();
      lenis = null;
      document.documentElement.classList.remove('has-smooth');
    }

    /* ── 2. CURSOR ──────────────────────────────────────────────────────
       Satu titik yang menempel persis, satu cincin yang tertinggal. Titik
       memberi tahu "halaman mendengar"; cincin yang membuat gerakannya
       terbaca punya berat.

       `has-cursor` dipasang PALING AKHIR, setelah lapisnya ada di DOM.
       Itulah satu-satunya saklar yang menyembunyikan kursor asli (motion.css
       §11), jadi skrip yang gagal di tengah jalan meninggalkan pengunjung
       dengan kursor yang memang sudah ia punya. */
    let cursorLayer: HTMLElement | null = null;
    let cursorRaf = 0;

    function startCursor() {
      if (cursorLayer || reduce.matches || !fine.matches) return;

      const layer = document.createElement('div');
      layer.className = 'u-cursor';
      layer.setAttribute('aria-hidden', 'true');
      /* TIGA BENTUK, SATU PENUNJUK (2026-11-14).
         Sebelum ini kursornya hanya titik + cincin, dan itu MENGHAPUS
         informasi: kursor asli memberi tahu "ini teks, bisa dipilih" (I-beam)
         dan "ini gambar" tanpa satu pun kata. Pemilik: "cursornya bulat ini
         fungsinya apa kok kek gak cursor mouse biasa".

         Sekarang bentuknya mengikuti apa yang ada di bawahnya:
           teks    -> batang tipis (I-beam), cincin disembunyikan
           gambar  -> cincin melebar jadi bingkai, titik disembunyikan
           kontrol -> cincin membesar (sudah ada)

         `u-cursor-exact` membungkus titik + batang karena keduanya harus
         MENEMPEL PERSIS ke pointer, sedangkan cincin sengaja tertinggal.
         Satu pembungkus = satu penulisan transform per frame, bukan dua. */
      layer.innerHTML =
        '<i class="u-cursor-ring"></i>' +
        '<i class="u-cursor-exact"><i class="u-cursor-dot"></i><i class="u-cursor-bar"></i></i>';
      const exact = layer.querySelector('.u-cursor-exact') as HTMLElement;

      let tx = window.innerWidth / 2;
      let ty = window.innerHeight / 2;
      let rx = tx;
      let ry = ty;
      let moved = false;

      const onMove = (e: PointerEvent) => {
        tx = e.clientX;
        ty = e.clientY;
        /* Lompatan pertama tidak boleh dianimasikan: tanpa ini, kursor
           meluncur dari tengah layar ke tempat pointer muncul.

           DAN baru di sinilah lapis ini boleh terlihat, bersamaan dengan
           disembunyikannya kursor asli. Sebelum pointer bergerak, posisi
           cincin masih di tengah viewport — menampilkannya sejak load berarti
           pengunjung melihat lingkaran mengambang di tengah hero, bukan
           kursor. Lihat catatan di motion.css §11. */
        if (!moved) {
          moved = true;
          rx = tx;
          ry = ty;
          layer.classList.add('is-live');
          document.documentElement.classList.add('has-cursor');
          // Loop baru dijalankan sekarang: tidak ada gunanya menulis
          // transform tiap frame untuk lapis yang belum terlihat.
          cursorRaf = requestAnimationFrame(loop);
        }
      };

      /* Satu listener di dokumen, bukan satu per tautan: halaman ini punya
         ratusan tautan dan tombol, dan memasang/mencabut listener saat
         pointer masuk-keluar adalah pekerjaan yang tidak perlu. */
      /* Urutannya adalah prioritas, bukan kelengkapan: sebuah tautan yang
         berisi <img> harus terbaca sebagai tautan, bukan sebagai gambar. */
      const HOT = 'a, button, [role="button"], summary, label, select, [data-cursor-hot]';
      const MEDIA = 'img, picture, video, figure, [data-cursor-media]';
      const TEXT =
        'p, h1, h2, h3, h4, h5, h6, li, dt, dd, blockquote, td, th, figcaption, span, strong, em, small';
      const onOver = (e: Event) => {
        const el = e.target;
        if (!(el instanceof Element)) return;
        const hot = !!el.closest(HOT);
        const media = !hot && !!el.closest(MEDIA);
        const text = !hot && !media && !!el.closest(TEXT);
        layer.classList.toggle('is-hot', hot);
        layer.classList.toggle('is-media', media);
        layer.classList.toggle('is-text', text);
      };

      const loop = () => {
        if (!layer.isConnected) return;
        /* ── TITIK MENEMPEL PERSIS, CINCIN DIBATASI JARAKNYA ──────────────
           Versi pertama membuat KEDUANYA tertinggal (titik 0.55, cincin 0.2).
           Terukur saat flick cepat 1000 px: titik tertinggal **326 px** dan
           cincin **720 px** dari pointer. Cincin 34 px yang tertinggal 720 px
           bukan lagi "punya berat" — ia sudah lepas dari kursornya, dan itu
           yang membuat mouse terasa aneh: tidak ada satu pun elemen di layar
           yang menunjuk tempat pointer sebenarnya berada.

           Jadi titik tidak di-lerp sama sekali. Ia ADALAH pointer.

           Cincin tetap di-lerp supaya gerakannya punya berat, TAPI lerp saja
           tidak cukup: pada flick keras selisihnya sempat 458 px walau lerp
           sudah dinaikkan ke 0.42 — karena lerp mengukur PERSENTASE, bukan
           jarak, jadi makin cepat pointer makin jauh ia tertinggal. Karena
           itu ada BATAS 40 px: begitu cincin lebih jauh dari itu dari titik,
           ia ditarik kembali ke lingkaran 40 px. Hasilnya terbaca sebagai
           karet yang memberi, bukan sebagai elemen yang lepas. */
        rx += (tx - rx) * 0.35;
        ry += (ty - ry) * 0.35;
        const gx = tx - rx;
        const gy = ty - ry;
        const gap = Math.hypot(gx, gy);
        if (gap > MAX_CURSOR_LAG) {
          rx = tx - (gx / gap) * MAX_CURSOR_LAG;
          ry = ty - (gy / gap) * MAX_CURSOR_LAG;
        }
        layer.style.transform = `translate3d(${rx.toFixed(2)}px, ${ry.toFixed(2)}px, 0)`;
        // Titik adalah ANAK dari lapis yang sudah bergerak bersama cincin,
        // jadi ia hanya perlu menutup selisihnya — dan selisih itu nol
        // begitu cincin sampai.
        exact.style.transform = `translate3d(${(tx - rx).toFixed(2)}px, ${(ty - ry).toFixed(2)}px, 0)`;
        cursorRaf = requestAnimationFrame(loop);
      };

      window.addEventListener('pointermove', onMove, { passive: true });
      document.addEventListener('pointerover', onOver, { passive: true });
      document.body.appendChild(layer);
      cursorLayer = layer;
    }

    function stopCursor() {
      if (!cursorLayer) return;
      cancelAnimationFrame(cursorRaf);
      cursorLayer.remove();
      cursorLayer = null;
      document.documentElement.classList.remove('has-cursor');
    }

    function sync() {
      if (reduce.matches || !fine.matches) {
        stopSmooth();
        stopCursor();
        return;
      }
      startSmooth();
      startCursor();
    }

    sync();
    reduce.addEventListener('change', sync);
    fine.addEventListener('change', sync);
  </script>

  <ClosingBand />
</BaseLayout>
