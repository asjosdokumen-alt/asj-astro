---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App.tsx';
import LokerTable from '../components/public/LokerTable.tsx';
import LayananSection from '../components/public/LayananSection.astro';
import Icon from '../components/ui/Icon';
---

<BaseLayout title="PT Amanah Sakura Japan — Job Portal" description="Lowongan kerja Jepang, penerimaan siswa baru, pengurusan visa, pendaftaran ujian JFT & SSW" showFooter={true}>
  <App client:only="preact" />

  <!-- Global Announcement Marquee (public page only) -->
<div id="global-announcement" class="hidden max-w-7xl mx-auto px-4 mt-4">
  <div class="bg-rose-700 rounded-2xl p-2.5 flex items-center shadow-[0_0_20px_rgba(225,29,72,0.3)] border border-rose-500/60 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 bg-red-800 w-12 flex items-center justify-center z-10 rounded-l-2xl border-r border-red-600/60 shadow-md">
      <Icon name="bullhorn" class="text-white animate-bounce text-lg" />
    </div>
    <!-- Two copies: the track animates to translate3d(-50%), i.e. exactly
         one copy, which makes the loop seamless at any text length. The
         duplicate is aria-hidden so screen readers read it once. -->
    <div class="marquee-track ml-12 mr-2">
      <div class="marquee-content text-white text-sm font-bold tracking-wide">
        <span class="marquee-item" data-marquee></span>
        <span class="marquee-item" data-marquee aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>
<script>
  import { getPublicData } from "../lib/publicData";
  getPublicData().then(function(d){ if(d.success && d.pengumuman){ var el=document.getElementById("global-announcement"); var txt=document.querySelectorAll("[data-marquee]"); if(el && txt.length && d.pengumuman.trim()){ txt.forEach(function(n){ n.textContent=d.pengumuman; }); el.classList.remove("hidden"); } } }).catch(function(){});
</script>

  <main id="main-content" class="w-full max-w-7xl mx-auto px-4 mt-8 pb-16 min-h-[50vh] flex flex-col gap-6">
    <!-- Tab Navigation: Loker vs Layanan (same as legacy) -->
    <div class="flex justify-center mb-8 relative z-10">
      <div id="tab-pub-wrap" class="inline-flex bg-slate-900 border-slate-700 rounded-full p-1 shadow-2xl border transition-colors">
        <button id="tab-pub-loker" class="px-6 py-3 rounded-full text-sm font-bold transition-colors bg-sky-600 text-white shadow-md">
          <Icon name="briefcase" class="mr-2" /> <span data-lang="ui.tab_loker">Lowongan Loker</span>
        </button>
        <button id="tab-pub-layanan" class="px-6 py-3 rounded-full text-sm font-bold transition-colors bg-transparent text-slate-400 hover:text-white">
          <Icon name="handshake" class="mr-2" /> <span data-lang="ui.tab_layanan">Program &amp; Layanan ASJ</span>
        </button>
      </div>
    </div>

    <!-- Section: Loker -->
    <div id="public-loker-section" class="block animate-fade-in">
      <LokerTable client:only="preact" />
    </div>

    <!-- Section: Layanan -->
    <div id="public-layanan-section" class="hidden animate-fade-in space-y-8">
      <LayananSection />
    </div>
  </main>

  <script is:inline>
    (function() {
      var secLoker = document.getElementById('public-loker-section');
      var secLayanan = document.getElementById('public-layanan-section');
      var btnLoker = document.getElementById('tab-pub-loker');
      var btnLayanan = document.getElementById('tab-pub-layanan');
      if (!secLoker || !secLayanan || !btnLoker || !btnLayanan) return;

      function switchTab(tab) {
        if (tab === 'layanan') {
          secLoker.classList.add('hidden');
          secLoker.classList.remove('block');
          secLayanan.classList.remove('hidden');
          secLayanan.classList.add('block');
          btnLoker.classList.remove('bg-sky-600', 'text-white', 'shadow-md');
          btnLoker.classList.add('bg-transparent', 'text-slate-400');
          btnLayanan.classList.add('bg-sky-600', 'text-white', 'shadow-md');
          btnLayanan.classList.remove('bg-transparent', 'text-slate-400');
        } else {
          secLayanan.classList.add('hidden');
          secLayanan.classList.remove('block');
          secLoker.classList.remove('hidden');
          secLoker.classList.add('block');
          btnLayanan.classList.remove('bg-sky-600', 'text-white', 'shadow-md');
          btnLayanan.classList.add('bg-transparent', 'text-slate-400');
          btnLoker.classList.add('bg-sky-600', 'text-white', 'shadow-md');
          btnLoker.classList.remove('bg-transparent', 'text-slate-400');
        }
        if (history.replaceState) history.replaceState(null, '', '#' + tab);
      }

      btnLoker.addEventListener('click', function() { switchTab('loker'); });
      btnLayanan.addEventListener('click', function() { switchTab('layanan'); });

      var hash = window.location.hash.replace('#', '');
      if (hash === 'layanan') switchTab('layanan');
      window.addEventListener('hashchange', function() {
        var h = window.location.hash.replace('#', '');
        switchTab(h === 'layanan' ? 'layanan' : 'loker');
      });
    })();
  </script>
</BaseLayout>
