/**
 * ── NOMOR PENDAFTARAN UNTUK PITA BUKTI DI HERO (2026-11-14) ─────────────────
 *
 * Dibaca dari `LEGAL_FACTS` — sumber yang SAMA dengan yang dirender #legalitas
 * beberapa ribu piksel di bawahnya — lalu dioper ke island sebagai prop.
 *
 * KENAPA PROP DAN BUKAN IMPOR DI App.tsx: `companyProfile.ts` adalah modul
 * data besar, dan App adalah island `client:load` yang diunduh setiap
 * pengunjung anonim. Menyalin nomornya sebagai literal di App.tsx lebih murah
 * tapi membuat salinan KETIGA dari satu nomor izin; itu persis kesalahan yang
 * pernah terjadi pada `CONTACT_MAPS_URL` (tiga salinan, satu terlewat saat
 * diubah). Prop menjaga satu sumber tanpa membebani bundle.
 *
 * `value` di `Fact` boleh `string` (identifier, tidak diterjemahkan) atau
 * `{ key, text }`. Nomor pendaftaran adalah identifier, jadi bentuknya string —
 * tapi penyempitan tetap dilakukan supaya tipe `Fact` boleh berubah tanpa
 * membuat halaman ini gagal render.
 */
const LEGAL_REGNO_FACT = LEGAL_FACTS.find((f) => f.label.key === 'profile.legal_regno');
const legalRegno = typeof LEGAL_REGNO_FACT?.value === 'string' ? LEGAL_REGNO_FACT.value : undefined;

/* WHY THE SECTIONS ARE COMPOSED HERE AND NOT EACH IN THEIR OWN FILE.
   Six of the blocks below are the same three elements — a Section, a SectionTitle
   and one primitive — with different data. A file per composition would add six
   files that contain no logic and no encapsulation, and each one would move the
   indexer's frozen inventory for no gain. The primitives ARE the reusable part and
   they are separate files; what is left here is page composition, which is what a
   page file is for.

   WHY THERE IS NO `.map()` IN THIS FILE. Iterating inside an `.astro` TEMPLATE
   breaks a hard invariant of this repo: `indexer/src/build.test.ts:428` requires
   zero unresolved references originating outside a test file, and the indexer
   resolves template interpolations against the FRONTMATTER MODULE SCOPE only — so a
   `.map()` callback parameter in a template is reported as an unresolved global
   (measured: 21 entries, every one a callback parameter). Every list on this page
   therefore lives in a `.tsx` primitive, where callbacks bind correctly. That is why
   CheckList exists at all: four of these blocks were inline maps before it did. */
---

<!-- `scrollProgress` renders the thin gradient reading-progress bar at the
     top edge (motion.css §9i, driven by the document scroll timeline) —
     the landing page is the one route long enough for it to mean anything. -->
<BaseLayout title="LPK Amanah Sakura Japan — Pelatihan & Penempatan ke Jepang" titleKey="doc.title_home" description="LPK bahasa & budaya kerja Jepang di Ponorogo: magang, Tokutei Ginou, dan penempatan ke seluruh 47 prefektur lewat mitra resmi." ogImage="/og/beranda.jpg" showFooter={true} scrollProgress={true}>
  <!-- `hero` turns the header band into the landing page's hero. It also moves
       the page's single h1 into the hero, so the company name in the header
       steps down to a div — see the note in App.tsx. Every OTHER route mounts
       the header without this flag and keeps the header h1, because for those
       routes it is the only one.

       WHY `client:load` AND NOT `client:only="preact"` — measured 2026-09-23.
       `client:only` renders NO server HTML, so with JavaScript unavailable this
       page had **0 h1** and no header at all: the hero headline and the entire
       nav existed only after hydration. On a landing page that is the one
       heading a search engine and a no-JS reader need.

       `client:load` server-renders the island and then hydrates it. Measured in
       a real browser against a real server (390px, `server.cjs`):
         · JS ON  — 1 h1, 13 header/nav links, 0 console errors, 0 page errors
         · JS OFF — 1 h1 ("Karier ke Jepang, dimulai dari sini."), 13 links
       Before the change the JS-OFF column read 0 h1 and 0 links.

       THE HYDRATION MISMATCH THIS COULD HAVE CAUSED, AND WHY IT DOES NOT.
       `langStore` is a `persistentAtom`, so a visitor with `asj_lang = "jp"`
       stored would render Japanese on the client against the server's default
       Indonesian. That is why the language is read through the store rather than
       inlined into the markup: the text is IDENTICAL in both renders for any
       visitor who has not switched, and for one who has, Preact patches the
       text on hydration. The measurement above is the check — 0 page errors on
       the default path, which is the path almost every visitor takes.

       The gated routes (admin/candidate/apply/ai-cv/share/siswa-baru) keep
       `client:only`: they are session-dependent SPAs that cannot function
       without JavaScript, so server-rendering them would add weight and expose
       gate markup for no reader's benefit. -->
  <App client:load hero proof={{ regno: legalRegno }} />

  <!-- THE BAND THAT USED TO SIT HERE IS GONE, AND ITS THREE PARTS WENT TOGETHER.
       Owner ruling 2026-09-25, verbatim: "ini kok masih ada bukannya saya suruh
       hapus kemarin", with the count strip AND the section bar circled in the
       screenshot, and then "Hapus marquee juga" for the announcement strip.

       What was removed, in document order:
         1. `#global-announcement` — the rose marquee, ON THIS PAGE ONLY. The
            same band still exists on `/public` (`public.astro:25`), so the
            `marquee-*` rules in `motion.css` and `e2e/measure-marquee.mjs`
            stay valid and must NOT be deleted with it.
         2. the live-vacancy count strip (`#live-job-count`) — the only consumer
            of the `profile.hero_jobs_*` "lowongan aktif" key and of the
            `getPublicData()` call on this page. ⚠ THE KEY IS DELETED FROM BOTH
            DICTIONARIES, so do not spell it here: `i18n.keys.test.ts` scans
            source files for key-like strings and counts a key named in a
            COMMENT as "used", which is why writing it out made that gate red
            with "missing from the id dictionary" after the key was gone. Name
            the prefix, never the key.
         3. the SiteNav component — the desktop section bar (`sticky top-0
            z-sticky`). The component file is deleted, not merely unmounted;
            leaving an unused `.astro` behind would keep four frozen indexer
            counters and one e2e gate describing a bar no page renders.
       The `<script>` block that fed 1 and 2 is gone with them, so `index.astro`
       no longer imports `../lib/publicData` at all.

       ⚠ THIS COMMENT MUST NOT SPELL THE DELETED TAG. The indexer parses `.astro`
       COMMENTS as if they were markup, so writing the removed component's tag
       here re-creates the exact unresolved `template-component` reference the
       deletion was supposed to remove — measured 2026-09-25: the first draft of
       this comment did that and took `graph.unresolved` from 2 to 3 and the
       row-8 Renders-edge assertion from 0 to 1. Name the file, never the tag.
       (`Section.astro` carries the same warning for capitalised tag names.)

       ⚠ THE LINK TO `/loker` MOVED — IT WAS NOT DROPPED. That bar's "Lowongan"
       item was the ONLY `href="/loker"` in the entire site (measured
       2026-09-25: every other hit in `src/**` is prose; `Footer.astro` links only
       four fragments). Deleting the bar would have left `/` with ZERO paths to
       the vacancy list, and `e2e/test-landing.mjs`'s `LOKER_ROUTE` rule asserts
       that path exists. The single link now lives in the drawer
       (`App.tsx`, the always-visible block) because the owner's answer was
       "lahkan ada dari menu hamburger" — the drawer is the one navigation every
       visitor has, logged in or not. `LOKER_ROUTE` follows it there.

       DO NOT RESTORE THE BAR. The hero is the page's opening statement and the
       next thing a visitor sees should be `#kenapa-jepang`. -->

  <!-- The mascot rail stood here — a sticky grid column beside <main> that
       carried the princess down the page. Owner ruling 2026-09-24 removed her
       from the site entirely, so the rail, its grid column and the sticky
       `position` it needed are gone. <main> is a plain full-width block again;
       no empty track is reserved beside it. Do not restore the rail — the
       component, her renders and the scroll-tracking script were deleted with
       it. -->
  <!-- `overflow-x-clip` IS LOAD-BEARING — measured 2026-09-23, do not remove it.

       The two HORIZONTAL entrance kinds (`enter="slide-left"` / `"slide-right"`
       on #kenapa-jepang, #layanan, #fasilitas, #penempatan) park an un-revealed
       band at `translate3d(±2 × --enter-shift, 0, 0)` — 48px at the current
       `--enter-shift: 24px` (motion.css §9b). A band is FULL WIDTH, so while it
       is un-revealed it sticks 48px past the viewport and widens the document:

         measured at 390px on `/` — html.scrollWidth 423 vs clientWidth 390,
         i.e. **33px of horizontal scroll** (48px shift minus the 15px scrollbar).
         The offenders were `#layanan` and `#penempatan`, both 375px wide with
         `transform: matrix(1,0,0,1,48,0)`. After the reveal the same page
         measures scrollWidth 375 — the overflow exists ONLY pre-reveal.

       Two consequences, which is why this is a fix and not a nitpick:
         · A visitor can scroll the landing page sideways by 33px before the
           reveal runs. The bands below the fold never enter at load, so this is
           the state the page is in for everyone.
         · `e2e/test-headings.mjs` asserts "no horizontal overflow" and was RED
           on this, which made `e2e/test-headings.mutations.sh` and
           `test-headings-public.mutations.sh` ABORT on their baseline check —
           a red gate disarmed both proofs. That is the defect behind the defect.

       `clip` and not `hidden`: this distinction used to be load-bearing because
       `overflow: hidden` on one axis creates a scroll container, which would
       have broken the mascot rail's `position: sticky`. The rail is gone (owner
       ruling 2026-09-24), so either would work today — but `clip` is kept
       because it is still the accurate tool: it clips the transient pre-reveal
       offset without creating a scroll container, and nothing overflows
       horizontally once the bands are revealed (measured: 375 = 375). Visually
       the bands slide in from the edge instead of pushing the whole page
       sideways, which is what the motion was for.

       ── TANPA BATAS LEBAR SEJAK 2026-11-14 (owner) ─────────────────────────
       Sampai hari ini <main> dipatok `max-w-[100rem]` (1600 px) dan dipusatkan.
       Di monitor 1920 px itu menyisakan 153 px kosong di KIRI dan KANAN, dan
       pada band film — satu-satunya `bleed` di dalam <main> — celah itu terbaca
       sebagai letterbox: videonya seperti tidak mau melebar, padahal
       `.film-stage` memang hanya mendapat 1600 px. Terukur: viewport 1920,
       panggung 1600 di x=153; di 1440 panggungnya 1425 = selebar dokumen, jadi
       gejalanya hanya muncul di layar > 1600 px — persis yang dilaporkan owner
       ("gak bisa kah stretch sesuai window-nya, untuk desktop saja").

       Yang dibuang HANYA patokannya, bukan `overflow-x-clip`-nya. Aman karena
       <main> tidak lagi memuat satu pun band selebar layar selain #alur: semua
       seksi lain memakai `max-w-7xl` (1280 px) dari `Section.astro`, jadi di
       viewport mana pun posisinya tidak berubah. Efek sampingnya cuma
       `section-alt` (tint tembus pandang) kini ikut sampai tepi jendela —
       sebelumnya berhenti di 1600 dan menyisakan tepi vertikal yang terlihat.
       Tidak ada tes yang mengunci angka 1600 ini; yang dijaga
       `e2e/test-headings.mjs` adalah "tidak ada overflow horizontal", dan
       `clip` tetap memenuhinya. -->
  <main id="main-content" class="w-full pb-16 min-h-[50vh] overflow-x-clip">
    <!-- Section: Alur & Persyaratan (pages 3 and 4) — BAND PERTAMA SETELAH HERO.
         Owner 2026-11-11: film ini harus membuka halaman, bukan duduk di tengah
         profil. "kalau taruh bawah gini gak sama kek yg web corn video kan ya" —
         di referensi, filmnya ADALAH halamannya. Jadi section ini pindah ke posisi
         pertama, tepat di bawah hero yang sudah berupa frame film dengan model
         yang sama, dan `#alur { padding-top: 0 }` membuat panggungnya menyambung
         dari tepi bawah hero tanpa pita terang di antaranya.

         JUDUL SEKSI JADI `sr-only`. Judul "Bagaimana Prosesnya?" yang terlihat
         akan menjadi pita terang di antara hero dan film — persis yang membuat
         versi sebelumnya terbaca sebagai "section", bukan sebagai film. Teksnya
         tetap ada di HTML (h2, `alur-title`, dipakai `aria-labelledby`) jadi
         outline dan nama region tidak hilang.

         `drift={false}`: §9f's `scroll-drift-y` men-scale pembungkusnya
         0,982 -> 1,008. Terukur di 1440 px: skala itu menyisakan celah terang
         13 px di tepi kiri plat. Jadi band ini mengambil `data-enter` saja (wipe
         `curtain` tetap jalan, oracle `sectionMotion.ts` tetap cocok) tanpa
         `data-scroll`. `enter` sendiri TIDAK boleh dicabut:
         `e2e/test-landing.mjs:1708` mencocokkan setiap baris tabel dengan elemen
         ber-`data-enter` di halaman. -->
    <Section id="alur" bleed drift={false} labelledBy="alur-title" class="section-alt" enter="curtain">
      <h2 id="alur-title" class="sr-only">Bagaimana Prosesnya?</h2>
      {/* ── Band "Satu Jalan" ───────────────────────────────────────────────
           Menggantikan grid enam kartu StepList. Isi teksnya TIDAK berubah dan
           TIDAK diduplikasi: judul/badan tiap langkah tetap `data-lang` dari
           FLOW_STEPS, jadi toggle ID/EN/JP tetap menjangkaunya tanpa kunci baru.

           Bentuknya sekarang FRAME FILM, bukan dua kolom: plat 3:2 menutup
           seluruh panggung (full-bleed), teks duduk di atas scrim dari kiri, dan
           chrome alat ukur (braket sudut, garis progres, rel babak, koordinat)
           mengapitnya. Itu bahasa yang dibaca dari referensi 58 detik
           `Pioneer corn revolutionized` — lihat deliverables/story-video/DESIGN-STUDY.md.

           CARA KERJANYA: `.film-track` setinggi 7 x 72svh + 100svh, dan
           `.film-stage` menempel (`sticky`) di dalamnya. Tujuh, bukan enam:
           babak terakhir adalah CODA yang mengembalikan frame pertama — di
           referensi, filmnya berakhir dengan loop ke awal. Progres scroll memilih
           babak; babak berikutnya MENUTUP babak sebelumnya (dissolve tanpa
           lubang), dan teksnya punya dua ketukan — judul dulu, badan menyusul di
           38% babak. Itu aturan #4 dari studi: teks berganti DI DALAM shot, bukan
           shot berganti untuk teks.

           KENAPA BAND INI TIDAK IKUT DRIFT SCROLL (§9f).
           `enter` menaruh animasi `transform` pada pembungkus, dan transform pada
           leluhur menggeser hasil lukis anak yang sticky — tidak masalah selama
           geserannya nol. §9f men-scale 0,982 -> 1,008, dan pada band full-bleed
           skala itu terbaca sebagai celah terang 13 px di tepi kiri plat.
           Karena itu Section-nya memakai `drift={false}`: wipe `curtain` tetap
           ada, drift-nya yang dilepas. */}
      <StoryFilm steps={FLOW_STEPS} />

      {/* ── DOSSIER: syarat & berkas sebagai PLAT PENUTUP film ────────────────
           Sebelum ini blok-nya dua daftar telanjang: judul kecil, tujuh centang
           kiri, tujuh centang kanan, tanpa satu pun properti film. Akibatnya
           transisi dari babak coda ke profil isinya terasa seperti pindah situs:
           panggung penuh-bleed berhenti, lalu tiba-tiba bahasa editorial.

           Yang dipakai dari `scroll-cinema` di sini BUKAN panggung kedua —
           band tetap satu-satunya panggung di halaman ini (hukum 1: satu seam;
           dua band berdekatan membuat keduanya berhenti terasa film). Yang
           dipinjam adalah TATA BAHASANYA di skala seksi:
             · tipografi judul sama dengan `.film-copy h3` — kapital, 700,
               line-height .98, tracking -0,02em (bukan baliho serif);
             · garis rambut sebagai pemisah, seperti `.film-body`;
             · angka `tabular-nums` di penanda babak;
             · satu still 4:5 dari plat babak 04 (paspor) sebagai PROP, bukan
               pengulangan adegan: bingkainya sempit, crop-nya vertikal, dan
               nomornya menempel di sudut — pembaca melihat detail, bukan babak
               yang diputar ulang.

           Kenapa di sini, bukan di tempat lain: daftar ini yang menyebut KTP,
           akta, KK, ijazah — dan paspor adalah dokumen yang paling sering
           ditanya. Still-nya menjelaskan daftarnya, bukan menghiasinya.

           Gambarnya `loading="lazy"`: ia berada di bawah panggung 7x72svh, jadi
           tidak pernah berada di viewport pertama. */}
      <div class="dossier">
        <div class="dossier-inner">
          <h3 data-lang="profile.req_title" class="dossier-title">
            Persyaratan &amp; Dokumen
          </h3>
          <p data-lang="profile.req_desc" class="dossier-lead">
            Pastikan semuanya siap sebelum mendaftar.
          </p>

          <div class="dossier-grid">
            <div class="dossier-col">
              <h4 data-lang="profile.req_general_title" class="dossier-label">Syarat umum</h4>
              <CheckList items={REQUIREMENTS} accent="exam" />
            </div>
            <div class="dossier-col">
              <h4 data-lang="profile.req_docs_title" class="dossier-label">Berkas yang disiapkan</h4>
              <CheckList items={REQUIREMENT_DOCS} icon="file-alt" accent="exam" />
            </div>

            <figure class="dossier-still">
              <div class="dossier-frame">
                <img
                  class="dossier-still-img"
                  src="/assets/story/04-paspor-detail.webp"
                  alt="Detail sampul paspor Republik Indonesia: hijau tua, lambang Garuda emas, tulisan REPUBLIK INDONESIA dan PASPOR, dipegang tangan peserta."
                  width="480"
                  height="640"
                  loading="lazy"
                  decoding="async"
                />
                <span class="dossier-num" aria-hidden="true">04</span>
              </div>
            </figure>
          </div>
        </div>
      </div>
    </Section>

    <!-- Section: Kenapa Jepang? (page 2 of the company profile) -->
    <Section id="kenapa-jepang" labelledBy="kenapa-jepang-title" enter="slide-left">
      <SectionTitle
        titleKey="profile.why_title"
        title="Kenapa Jepang?"
        descKey="profile.why_desc"
        desc="Tiga alasan yang paling sering disebut kandidat."
        accent="jobs"
