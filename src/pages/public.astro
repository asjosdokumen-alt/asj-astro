---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayananSection from '../components/public/LayananSection.astro';
import LokerTable from '../components/public/LokerTable.tsx';
import App from '../components/App.tsx';
import Icon from '../components/ui/Icon';
---

<BaseLayout title="Lowongan & Layanan — ASJ Portal" description="Lowongan kerja Jepang, penerimaan siswa baru, pengurusan visa, pendaftaran ujian JFT & SSW" showFooter={true}>
  <App client:only="preact" />

  <main id="main-content" class="w-full max-w-7xl mx-auto px-4 mt-8 min-h-[50vh] flex flex-col gap-6 pb-16">
    <!-- Back button -->
    <a href="/" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white transition">
      <Icon name="arrow-left" /> <span data-lang="button.back_to_portal">Kembali ke Portal</span>
    </a>

    <!-- Global Announcement Marquee -->
    <div id="global-announcement" class="hidden">
       <div class="bg-rose-700 rounded-2xl p-2.5 flex items-center shadow-[0_0_20px_rgba(225,29,72,0.3)] border border-rose-500/60 relative overflow-hidden">
           <div class="absolute left-0 top-0 bottom-0 bg-red-800 w-12 flex items-center justify-center z-10 rounded-l-2xl border-r border-rose-600/60 shadow-md">
               <Icon name="bullhorn" class="text-white animate-bounce text-lg" />
           </div>
           <!-- Two copies: the track animates to translate3d(-50%), i.e. exactly
         one copy, which makes the loop seamless at any text length. The
         duplicate is aria-hidden so screen readers read it once. -->
    <div class="marquee-track ml-12 mr-2">
      <div class="marquee-content text-white text-sm font-bold tracking-wide">
        <span class="marquee-item" data-marquee></span>
        <span class="marquee-item" data-marquee aria-hidden="true"></span>
      </div>
    </div>
       </div>
    </div>

    <!-- Tab Navigation: Loker vs Layanan (with URL hash persistence) -->
    <div class="flex justify-center relative z-10">
      <div class="inline-flex bg-slate-900 border border-slate-700 rounded-full p-1 shadow-2xl transition-colors" id="tab-pub-wrap">
        <button id="tab-pub-loker" class="px-6 py-3 rounded-full text-sm font-bold transition-colors bg-sky-600 text-white shadow-md">
          <Icon name="briefcase" class="mr-2" /> <span data-lang="ui.tab_loker">Lowongan Loker</span>
        </button>
        <button id="tab-pub-layanan" class="px-6 py-3 rounded-full text-sm font-bold transition-colors text-slate-400 hover:text-white">
          <Icon name="handshake" class="mr-2" /> <span data-lang="ui.tab_layanan">Program &amp; Layanan ASJ</span>
        </button>
      </div>
    </div>

    <!-- Section: Loker (Preact island) -->
    <div id="section-loker">
      <LokerTable client:only="preact" />
    </div>

    <!-- Section: Layanan (static Astro) -->
    <div id="section-layanan" class="hidden">
      <LayananSection />
    </div>
  </main>

  <script is:inline>
    // Tab switching with URL hash persistence
    (function() {
      var secLoker = document.getElementById('section-loker');
      var secLayanan = document.getElementById('section-layanan');
      var btnLoker = document.getElementById('tab-pub-loker');
      var btnLayanan = document.getElementById('tab-pub-layanan');

      function switchTab(tab) {
        if (tab === 'layanan') {
          secLoker.classList.add('hidden');
          secLayanan.classList.remove('hidden');
          btnLoker.classList.remove('bg-sky-600', 'text-white', 'shadow-md');
          btnLoker.classList.add('text-slate-400');
          btnLayanan.classList.add('bg-sky-600', 'text-white', 'shadow-md');
          btnLayanan.classList.remove('text-slate-400');
        } else {
          secLayanan.classList.add('hidden');
          secLoker.classList.remove('hidden');
          btnLayanan.classList.remove('bg-sky-600', 'text-white', 'shadow-md');
          btnLayanan.classList.add('text-slate-400');
          btnLoker.classList.add('bg-sky-600', 'text-white', 'shadow-md');
          btnLoker.classList.remove('text-slate-400');
        }
        // Update URL hash without scrolling
        if (history.replaceState) {
          history.replaceState(null, '', '#' + tab);
        }
      }

      btnLoker.addEventListener('click', function() { switchTab('loker'); });
      btnLayanan.addEventListener('click', function() { switchTab('layanan'); });

      // Read initial tab from URL hash
      var hash = window.location.hash.replace('#', '');
      if (hash === 'layanan') {
        switchTab('layanan');
      }

      // Listen for hash changes (back/forward navigation)
      window.addEventListener('hashchange', function() {
        var h = window.location.hash.replace('#', '');
        switchTab(h === 'layanan' ? 'layanan' : 'loker');
      });
    })();
  </script>

  <!-- Marquee data. Uses the shared single-flight loader so this page and
       index.astro cannot drift apart again: both used to hand-roll the same
       POST to get-app-data, and the copy here had already lost the
       `success` guard's shape. `getPublicData` is imported, so this must be a
       processed script — hence separate from the `is:inline` tab logic above,
       which has to run before hydration. -->
  <script>
    import { getPublicData } from '../lib/publicData';
    getPublicData().then(function (d) {
      if (d.success && d.pengumuman) {
        var el = document.getElementById('global-announcement');
        var txt = document.querySelectorAll('[data-marquee]');
        if (el && txt.length && d.pengumuman.trim()) {
          txt.forEach(function (n) { n.textContent = d.pengumuman; });
          el.classList.remove('hidden');
        }
      }
    }).catch(function () {});
  </script>
</BaseLayout>
