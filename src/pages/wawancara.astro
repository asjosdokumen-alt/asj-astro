---
// Aturan cetak TIDAK lagi di sini. `MensetsuForm` juga dirender di overlay
// admin, dan aturan yang hanya menempel di halaman ini tidak ikut ke sana —
// akibatnya tombol Cetak/PDF dari panel admin mencetak seluruh panel admin
// beserta chat. Satu sumber aturan: `styles/layout.css` §5b (`[data-cetak]`).
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App.tsx';
import FormToolbar from '../components/forms/FormToolbar';
import MensetsuForm from '../components/candidate/MensetsuForm.tsx';
---

<BaseLayout
  title="Latihan Wawancara Jepang (Mensetsu) — ASJ"
  titleKey="doc.title_mensetsu"
  description="Latihan mensetsu dengan bank 177 soal dalam 13 tahap: tiap soal punya pertanyaan dan jawaban tiga lapis (bahasa Jepang, cara baca, Bahasa Indonesia). Jawaban Anda tersimpan dan tersambung dengan CV."
>
  <App showHeader={false} client:only="preact" />

  {/* `asHeading={false}`: halaman ini SUDAH punya h1 sendiri ("Latihan
      Wawancara Jepang (Mensetsu)"). Dibiarkan default, toolbar menambah h1
      kedua — terukur 2026-11-01: dua h1 di rute ini. `/wawancara` tidak masuk
      daftar `e2e:headings`, jadi duplikatnya tidak pernah berbunyi.

      `backTo="dashboard"`: kandidat kembali ke dasbornya, bukan ke portal.
      Sama seperti `/ai-cv` — lihat catatan di `FormToolbar`. */}
  <FormToolbar client:only="preact" titleKey="toolbar.mensetsu" asHeading={false} backTo="dashboard" />
  <main id="main-content" class="w-full min-h-[50vh] pb-16 pt-[64px]">
    <div class="max-w-[1400px] mx-auto px-3">
      <section class="mb-3">
        <h1 class="text-xl md:text-2xl font-bold text-fg mb-1">Latihan Wawancara Jepang (Mensetsu)</h1>
        {/* ⚠ DIPANGKAS 2026-11-10, alasan sama seperti /kotoba: paragraf 5 baris di
            HP menghabiskan layar pertama. Satu baris di atas, sisanya di
            `<details>` TERTUTUP — teks tetap di HTML, jadi tetap terbaca mesin
            pencari, tetapi tidak memakan layar. */}
        <p class="cetak-sembunyi text-fg-muted text-[12.5px] leading-relaxed">
          Bank soal mengikuti alur wawancara sebenarnya — dari perkenalan sampai penutup.
        </p>
        <details class="cetak-sembunyi mt-1.5 text-[11px] text-fg-muted">
          <summary class="cursor-pointer font-bold text-accent-sky">Detail latihan</summary>
          <p class="mt-1 leading-relaxed">
            Urutannya: perkenalan, keluarga, pendidikan, pengalaman, bahasa Jepang, kelebihan &amp;
            kekurangan, motivasi, rencana, kehidupan sehari-hari, kesehatan, ibadah, kerja shift,
            sampai penutup. Tombol <b>Isi Jepang otomatis</b> melengkapi huruf Jepang dan cara
            bacanya.
          </p>
        </details>
      </section>
      <noscript class="block mb-3 rounded-card border border-amber-400 bg-amber-100 px-4 py-3 text-sm font-bold text-amber-900">
        Halaman ini memerlukan JavaScript. Aktifkan JavaScript, lalu muat ulang halaman ini.
      </noscript>
      <MensetsuForm client:only="preact" />
    </div>
  </main>
</BaseLayout>
