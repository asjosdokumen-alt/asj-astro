---
import Footer from '../components/Footer.astro';
import VersionBadge from '../components/VersionBadge.astro';
import BottomNav from '../components/BottomNav.tsx';
import Toast from '../components/Toast.tsx';
import HreflangLinks from '../components/public/HreflangLinks.tsx';
import { hreflangAlternates, organizationJsonLd, jsonLdScript, absoluteUrl } from '../lib/siteMeta';
import {
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_PHONES,
  CONTACT_INSTAGRAM,
  CONTACT_TIKTOK,
  CONTACT_MAPS_URL,
  MAPS_LAT,
  MAPS_LNG,
} from '../lib/companyProfile';
import inter400Woff2 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700Woff2 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
// Weight 900 was MISSING while `font-black` was used 64 times across src/ —
// measured 2026-09-19: the only declared faces were 400/600/700
// (`font-weight:` in @fontsource/inter/latin-{400,600,700}.css), so every
// "black" heading resolved to the nearest declared weight (700) and the intended
// 700-vs-900 hierarchy did not exist anywhere in the app. Cost of the fix is
// measured, not guessed: `inter-latin-900-normal.woff2` is 23.3 KB, taking the
// four declared weights from 70.8 KB to 94.1 KB.
//
// Weight 800 (`font-extrabold`, 21 usages) is deliberately NOT added yet: it
// would cost a further 23.8 KB for a tier that reads almost identically to 900.
// The two ways out — add the face, or migrate those 21 usages to `font-black` —
// are recorded in DESIGN.md §3.3 and belong with the typography work in L2/L3,
// not in the foundation phase, because 21 call sites are spread across admin and
// candidate screens and changing them all is a broader visual change than this
// phase should carry.
import '@fontsource/inter/latin-900.css';

// ─── The DISPLAY face — Instrument Serif, latin, weight 400, ONE weight ───
//
// Owner request 2026-09-27: the landing hero becomes a full-screen band with
// an oversized serif display headline, from a reference short. This is the
// repo's second font family and the first time a face has been added for
// anything other than Inter's own weight ladder.
//
// MEASURED COST, the same standard the Inter 900 note above set:
//   instrument-serif-latin-400-normal.woff2   20.5 KB   ← what a browser fetches
//   instrument-serif-latin-400-normal.woff    17.9 KB   ← the @font-face's
//                                                          legacy fallback;
//                                                          never fetched by a
//                                                          browser that supports
//                                                          woff2 (unusually it is
//                                                          the SMALLER file here,
//                                                          so this face costs no
//                                                          more on old engines
//                                                          either)
// That is 2.8 KB LESS than the Inter 900 face (23.3 KB) this file already
// accepted, and it is the family's ONLY weight — there is no second weight to
// justify, because `@fontsource/instrument-serif` ships 400 alone.
//
// WHY A SEPARATE FAMILY AND NOT A HEAVIER INTER. The reference headline is a
// high-contrast editorial serif; Inter has no serif and its 900 weight is a
// grotesque doing a display face's job. Why this face over DM Serif Display
// (24.2 KB) or Fraunces (variable, 1.8 MB package) is recorded in
// `theme.css` next to `--font-display`, which is where the choice lives.
//
// SCOPE: `--font-display` is a DISPLAY utility, applied to exactly one element
// today (the hero h1). Body copy, section titles, cards, forms and tables stay
// Inter — `--font-sans` is unchanged and still feeds preflight.
//
// ⚠ It is imported as `latin-400.css`, NOT `400.css`. The bare entry pulls in
// latin + latin-ext + every other subset, which would add the latin-ext face
// (11.3 KB) and a set of subsets this page's copy never uses. The Inter imports
// above are latin-only for the same reason.
import '@fontsource/instrument-serif/latin-400.css';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  showFooter?: boolean;
  showBottomNav?: boolean;
  /**
   * The i18n key for this page's document title, e.g. `doc.title_loker`.
   *
   * It is passed as an ATTRIBUTE ON <html>, not on <title>, for two reasons:
   * a gate matches `/<title>([\s\S]*?)<\/title>/` and would break if that tag
   * grew an attribute; and `data-*` on <html> is exactly what the rest of this
   * layout's i18n already uses. `applyDocTitle()` reads it and assigns
   * `document.title` after hydration, so the server-rendered Indonesian value
   * (correct for crawlers) stops being the only value a JP reader ever sees.
   */
  titleKey?: string;
  /** Absolute URL (or root-relative path) to an Open Graph image for this page. */
  ogImage?: string;
  /** If true, emit `<meta name="robots" content="noindex">` for gated app pages. */
  noIndex?: boolean;
  /**
   * Render the scroll-progress bar (motion.css §9i): a 3px gradient pinned
   * to the top edge that fills as the page scrolls, driven by the document
   * scroll timeline — no JavaScript, reversible for free. Opt-in per page:
   * the landing page turns it on; short app routes gain nothing from it.
   * Decorative, so it is `aria-hidden` and carries no text.
   */
  scrollProgress?: boolean;
  /**
   * Render `<VersionBadge>` (versi build + "Periksa pembaruan").
   *
   * Default `true` — ia satu-satunya jalan kandidat melihat versi yang sedang
   * dipakai dan memicu pemeriksaan service worker. Dimatikan HANYA pada rute
   * yang tingginya dikunci ke layar (`100dvh`), karena di sana baris ini tidak
   * pernah terlihat tetapi tetap MENAMBAH TINGGI BODY: terukur di /ai-cv,
   * badge ini membuat halaman bisa digulir ~69 px, dan guliran itu menggeser
   * panel form ke atas sampai kepala panel yang melekat masuk ke bawah toolbar
   * tetap. Elemen yang tak terjangkau jari tidak boleh mengubah tata letak.
   */
  showVersionBadge?: boolean;
  /** Extra JSON-LD payload (already serialised) to inject into `<head>`. */
  jsonLd?: string;
}

const { title, description = 'PT Amanah Sakura Japan — Job Portal', lang = 'id', showFooter = false, showBottomNav = false, titleKey, ogImage, noIndex, scrollProgress = false, showVersionBadge = true, themeLock, jsonLd } = Astro.props;

// ─── Discovery metadata (JSON-LD + hreflang) ─────────────────────────────────
// ADDED 2026-09-29. MEASURED that day: this site emitted 0 JSON-LD and 0
// hreflang while 3 of 6 MoU partner sites emit JSON-LD and two emit hreflang.
// We have the fullest bilingual content of the seven, so the missing hreflang
// was discarding a real advantage. See siteMeta.ts for why the origin is an
// env var, and docs/COMPANY_PAGE_ASSESSMENT_2026-09-29.md §3.7.
//
// ⚠ BOTH ARE OPTIONAL BY DESIGN. With no `PUBLIC_SITE_URL` set (every local
// build, every test) `siteOrigin()` returns null and both blocks emit nothing.
// That is deliberate: an absolute URL guessed wrong points crawlers at a FROZEN
// host — this project's host has already moved twice — which is worse than
// emitting none. So a missing block here is a config state, not a bug.
//
// The JP counterpart of each page is the same route with the language switched
// in the browser (`data-lang` + translateDataLang), not a separate path, so the
// alternate points at `?lang=jp`. The path is taken from `Astro.url.pathname`
// so every page gets its own canonical and alternates — the old hard-coded `/`
// made every page claim the homepage as its canonical, which is a serious SEO
// defect (fixed 2026-10-23).
const currentPath = Astro.url.pathname || '/';
const alternates = hreflangAlternates({ id: currentPath, jp: `${currentPath}${currentPath.includes('?') ? '&' : '?'}lang=jp` });
const canonical = absoluteUrl(currentPath);
const ogImageAbsolute = ogImage ? (ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage.startsWith('/') ? ogImage : `/${ogImage}`)) : null;
const orgJsonLd = jsonLdScript(
  organizationJsonLd({
    name: 'PT Amanah Sakura Japan',
    description:
      'LPK (Lembaga Pelatihan Kerja) bahasa Jepang di Ponorogo, Jawa Timur. Pelatihan bahasa dan budaya Jepang, serta persiapan penempatan kerja ke Jepang.',
    streetAddress: CONTACT_ADDRESS.text,
    telephone: CONTACT_PHONES[0],
    email: CONTACT_EMAIL,
    latitude: MAPS_LAT,
    longitude: MAPS_LNG,
    sameAs: [
      `https://www.instagram.com/${CONTACT_INSTAGRAM}`,
      `https://www.tiktok.com/@${CONTACT_TIKTOK}`,
      CONTACT_MAPS_URL,
    ],
  }),
);
---
<!DOCTYPE html>
<html lang={lang} data-title-key={titleKey} data-theme={themeLock} data-theme-lock={themeLock}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <!-- The document title. This was MISSING until 2026-09-17: the `title` prop
       was destructured above and then never rendered, so every page shipped
       with no <title> at all — verified 0 occurrences across all 10 built
       pages. The browser tab showed the URL, search results had no title, and
       screen readers announced the document without one (WCAG 2.4.2 "Page
       Titled" is Level A). Nothing looked wrong, which is why it survived.

       It also made a gate's exemption a false premise: i18n.keys.test.ts
       deliberately skips the title prop passed to this layout, on the grounds
       that it is "the document title: server-rendered SEO metadata that
       translateDataLang() cannot touch". That reasoning was sound and the
       premise was not — those strings were reaching nothing.

       Note for anyone editing this comment: the indexer parses .astro template
       tags including the ones inside HTML comments, so a literal capitalised
       tag written here becomes a phantom unresolved reference and
       indexer/src/build.test.ts fails with "expected [...] to have a length of
       +0 but got 1". That is exactly how this paragraph was caught.

       Server-rendered on purpose: translateDataLang() runs in the browser and
       cannot rewrite a <title> for a crawler or a shared link preview. -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  {/* ─── Open Graph & Twitter Card (added 2026-10-23) ───────────────────────
       Every public page should carry a share preview. `ogImage` is optional;
       when absent the tags still emit og:title and og:description so the
       preview is a text card rather than a broken link. */}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'ja_JP'} />
  {ogImageAbsolute && <meta property="og:image" content={ogImageAbsolute} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImageAbsolute && <meta name="twitter:image" content={ogImageAbsolute} />}

  {/* ─── hreflang + JSON-LD (added 2026-09-29) ──────────────────────────────
       Both render only when PUBLIC_SITE_URL resolves to a real origin; see the
       note in the frontmatter and siteMeta.ts. When it does not, the component
       and the conditional below emit nothing at all, which is the intended
       state on a local build.

       WHY THE ALTERNATES ARE A `.tsx` COMPONENT AND NOT AN INLINE `.map()`:
       iterating in an `.astro` template reports the callback parameter as an
       unresolved global, which `indexer/src/build.test.ts` forbids outside test
       files. This was MEASURED here, not assumed — the inline version produced
       exactly two `global-unknown` refs, both the name `a`. The repo already
       records this rule at src/pages/index.astro:63; see HreflangLinks.tsx for
       the full reasoning. Do not inline it back.

       NOTE FOR ANYONE EDITING THESE COMMENTS: the indexer parses Astro template
       tags INCLUDING the ones inside HTML comments (see the long note above the
       title element). A literal capitalised tag written in a comment here
       becomes a phantom unresolved reference and indexer/src/build.test.ts
       fails. That is why these comments name elements in lower case in prose
       instead of writing them as tags. */}
  {canonical && <link rel="canonical" href={canonical} />}
  <HreflangLinks alternates={alternates} />
  {orgJsonLd && (
    <script type="application/ld+json" set:html={orgJsonLd} />
  )}
  {jsonLd && (
    <script type="application/ld+json" set:html={jsonLd} />
  )}
  <meta name="theme-color" content="#020617" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="PT Amanah Sakura Japan" />
  <meta name="referrer" content="no-referrer" />
  <base target="_top" />
  
  <!-- Icons are served locally (public/icons/). They used to point at a
       Supabase Storage URL, which meant a 404/slow load whenever the storage
       bucket was unreachable and made the PWA un-installable offline.
       They are now the PT Amanah Sakura Japan emblem, rasterised by
       `npm run icons:pwa`. There is deliberately no icon.svg any more: the
       emblem is a raster, and an SVG wrapper could only carry the same PNG
       base64-encoded inside a larger file. -->
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preload" href={inter400Woff2} as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href={inter700Woff2} as="font" type="font/woff2" crossorigin="anonymous" />

  <!-- Icons: external SVG sprite (154 glyphs subsetted from Font Awesome).
       Loaded via <use href="/icons/sprite.svg#id"> to avoid inlining ~83 KB
       of markup into every page. The sprite is also in the SW precache: it is
       the one render-critical file at dist/ root, which the _astro sweep that
       builds the precache list cannot see. -->

  <!-- Inter is self-hosted via @fontsource (see imports above).
       This replaces a render-blocking Google Fonts stylesheet that loaded
       Montserrat — a family the stylesheet never actually referenced. -->

  <style is:global>
    @import '../styles/global.css';
  </style>
<script is:inline>

    // ─── Theme restore (before paint, avoids a flash of the wrong theme) ───
    // Writes `data-theme` (new token system, see styles/theme.css).
    //
    // DEFAULT IS LIGHT as of 2026-09-20 (owner decision — the landing page ships
    // the pink sakura palette). This script MUST stay inline and MUST NOT import
    // `DEFAULT_THEME`: it runs before any module loads, which is the whole point.
    // It is therefore the one place the default is a literal, and it duplicates
    // src/store/theme.ts by necessity. Change both together or the page flashes
    // the wrong theme on every load.
    (function(){
      // `THEME_LOCK` is the landing page's film stage: it has no light variant,
      // so it wins over whatever is stored. See the `themeLock` prop.
      var THEME_LOCK = "dark";
      if (THEME_LOCK) {
        document.documentElement.setAttribute("data-theme", THEME_LOCK);
        return;
      }
      try {
        var t = localStorage.getItem("asjTheme");
        document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();

    // ─── Penanda "JS hidup", SEBELUM paint pertama ───
    // Kenapa harus di sini dan bukan di komponen yang memakainya: CSS perlu
    // tahu apakah JS AKAN mengambil alih SEBELUM tata letak pertama, bukan
    // sesudahnya. `LokerStaticList` memakai ini untuk menyembunyikan tabel
    // statis miliknya saat JS ada; kalau penandanya dipasang belakangan, tabel
    // statis sempat menempati ~3.300px lalu lenyap — persis pergeseran tata
    // letak yang mau dihilangkan.
    //
    // Tanpa JS atribut ini tidak pernah ada, jadi pembaca tanpa JS tetap
    // melihat tabel statisnya. Itu satu-satunya alasan atribut ini ada.
    document.documentElement.setAttribute("data-js", "");

    // ─── Scrollbar gutter width (see styles/global.css + layout.css §3b) ───
    // `html { scrollbar-gutter: stable }` prevents a page shift when a modal
    // toggles `overflow: hidden`, but it also narrows the initial containing
    // block, which made `position: fixed` overlays stop ~15px short of the
    // physical viewport edge on Windows/Linux.
    //
    // The reserved width CANNOT be expressed in CSS — it depends on the
    // platform's scrollbar style (overlay vs classic), which no media query
    // exposes. So it is measured once here and published as a custom
    // property that the overlay rules consume.
    //
    // MEASURED CAREFULLY: `clientWidth` does NOT report this gutter
    // (it read 1280 on a 15px-gutter page, giving a wrong "0px" answer
    // that silently disabled the fix). The reliable signal is the
    // difference between the viewport width and the WIDTH OF THE <html>
    // BOX ITSELF, which is what the gutter actually shrinks. Verified
    // against a bare `position: fixed; right: 0` probe: at innerWidth
    // 1280 that probe landed on 1265, and `offsetWidth`/`getBoundingClientRect`
    // on <html> both read 1265 — so this is the measurement that matches
    // the browser's own positioning maths.
    //
    // 0px on overlay-scrollbar platforms (macOS/iOS/Android), where the
    // correction is a no-op.
    (function(){
      var root = document.documentElement;
      var read = function(){
        try {
          var w = window.innerWidth;
          // getBoundingClientRect().width is unaffected by fractional
          // padding/borders on <html>, unlike clientWidth.
          var box = root.getBoundingClientRect().width;
          var gutter = Math.round(w - box);
          root.style.setProperty("--u-scrollbar-gutter", gutter > 0 ? gutter + "px" : "0px");
        } catch (e) {
          root.style.setProperty("--u-scrollbar-gutter", "0px");
        }
      };
      read();
      // A window can move between overlay and classic scrollbars (docked
      // vs undocked display), and the first read can precede layout on a
      // slow boot, so re-read on both signals.
      window.addEventListener("resize", read, { passive: true });
      window.addEventListener("load", read, { passive: true });
    })();

    // ─── Entrance animations: opt-in flag, set BEFORE FIRST PAINT ──────────
    // See styles/motion.css §9. This does two things and nothing else:
    //
    //   1. Marks the document as JS-capable. The hidden start state in
    //      motion.css is gated behind this class, so with scripting off every
    //      card is plainly visible instead of waiting for an observer that
    //      will never be created.
    //   2. Hands the IntersectionObserver off to a deferred function, so the
    //      observer setup itself does not block the first paint.
    //
    // WHY THE CLASS GOES ON IN THIS SCRIPT AND NOT IN A MODULE
    // There is exactly one frame budget between this line and first paint.
    // Adding the class later — on DOMContentLoaded, from a bundled module —
    // means the browser paints every card VISIBLE first, then this class
    // arrives and hides them, then the observer reveals them again. That
    // flash-then-vanish is a worse artefact than having no animation.
    //
    // The reveal pass runs after `load` because the page's own data (job
    // count, announcement) rewrites parts of the DOM before then, and
    // observing nodes that are about to be replaced would reveal nothing.
    (function(){
      var root = document.documentElement;
      if (!("IntersectionObserver" in window)) return;   // no flag: cards just show
      root.classList.add("js-reveal");

      // A Set, not an array of unique keys: elements are compared by identity.
      var seen = [];
      var MARK = "is-revealed";

      function reveal(el){ el.classList.add(MARK); }

      /**
       * ── WHICH STATE CLASS AN ELEMENT GETS ──────────────────────────────
       * Three attributes, three scales, three markers. This is a FUNCTION
       * rather than an inline ternary because it is asked in two places —
       * the first pass and the observer callback — and on 2026-11-13 those
       * two answers disagreed, which silently hid every section title.
       *
       *   [data-enter]        a whole band   -> is-entered   (§9b)
       *   [data-motion-words] the text in it -> is-visible   (§10)
       *   [data-reveal]       an item inside -> is-revealed  (§9)
       *
       * `data-enter` wins when an element carries both, because that is the
       * animation actually running on the element itself.
       */
      function markFor(el){
        if (el.hasAttribute("data-enter")) return "is-entered";
        if (el.hasAttribute("data-motion-words")) return "is-visible";
        return MARK;
      }

      /**
       * ── WORD MASKS (2026-11-13, motion.css §10) ────────────────────────
       * Wraps every word of `[data-motion-words]` in an overflow mask so it
       * can rise into place one word at a time. Done HERE, next to the other
       * reveal machinery, for the same reason §9b is: one owner for one
       * flag, and the same "already on screen → show now" rule.
       *
       * Text nodes for the spaces are preserved deliberately. A split that
       * emits only `inline-block` spans with no whitespace between them
       * cannot wrap at all — the headline would become one unbreakable line.
       *
       * ES5 style (var, no arrows) because this block is `is:inline` and is
       * NOT transpiled: an arrow function here ships to the browser as-is.
       */
      function splitWords(el){
        // Guard on the RESULT, not on a flag: `translateDataLang()` replaces
        // `textContent` wholesale, which deletes the masks but would leave a
        // `data-words-split="true"` behind — so a flag would report "done"
        // for an element that is plain text again. Measured exactly that.
        if (el.querySelector(".u-word")) return;
        var text = el.textContent || "";
        if (!text.trim()) return;
        var parts = text.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        var n = 0;
        for (var i = 0; i < parts.length; i++) {
          var part = parts[i];
          if (!part || !part.trim()) {
            frag.appendChild(document.createTextNode(part));
            continue;
          }
          var mask = document.createElement("span");
          mask.className = "u-word-mask";
          var word = document.createElement("span");
          word.className = "u-word";
          word.style.setProperty("--word-i", String(n++));
          word.textContent = part;
          mask.appendChild(word);
          frag.appendChild(mask);
        }
        el.textContent = "";
        el.appendChild(frag);
        el.classList.add("u-words");
      }

      /**
       * ── KATA YANG MENGIKUTI SCROLL (motion.css §12) ────────────────────
       * Skill `scroll-scrubbed-word-reveal`, dipakai pada satu paragraf di
       * `#visi-misi`. Beda dengan `splitWords` di atas: itu entrance sekali
       * jalan lewat topeng, ini fungsi dari POSISI scroll — menggulir ke
       * atas memundurkannya.
       *
       * Skrip menulis SATU properti (`--p`) pada elemen induk per frame;
       * tiap kata menghitung porsinya sendiri di CSS lewat `--i`/`--n`.
       * Menulis satu var per kata akan berarti 40 penulisan style per frame
       * di halaman yang sudah punya band film ber-rAF.
       */
      var scrubEls = [];
      var scrubQueued = 0;
      var scrubWired = false;

      function splitScrub(el){
        if (el.querySelector(".u-scrub-w")) return;
        var text = el.textContent || "";
        if (!text.trim()) return;
        var parts = text.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        var n = 0;
        for (var i = 0; i < parts.length; i++) {
          var part = parts[i];
          if (!part || !part.trim()) {
            frag.appendChild(document.createTextNode(part));
            continue;
          }
          var w = document.createElement("span");
          w.className = "u-scrub-w";
          w.style.setProperty("--i", String(n++));
          w.textContent = part;
          frag.appendChild(w);
        }
        el.textContent = "";
        el.appendChild(frag);
        el.style.setProperty("--n", String(n));
        /* Lebar jendela transisi, dalam satuan kata: ~15% jumlah kata, dijepit
           3..12. Diukur: dengan jendela 1 kata, hanya satu kata yang memudar
           pada satu waktu dan batasnya terbaca sebagai garis keras. */
        el.style.setProperty("--w", String(Math.min(12, Math.max(3, Math.round(n * 0.15)))));
        el.classList.add("u-scrub");
      }

      function paintScrub(){
        scrubQueued = 0;
        var vh = window.innerHeight || 0;
        for (var i = 0; i < scrubEls.length; i++) {
          var box = scrubEls[i].getBoundingClientRect();
          /* 0 saat puncak paragraf berada di 80% viewport, 1 setelah 0.9
             viewport gulir berikutnya. Rentang ~0,9vh untuk satu kalimat:
             cukup panjang untuk terbaca sebagai gerakan, cukup pendek untuk
             selesai sebelum paragrafnya sampai tengah layar. */
          var p = (vh * 0.8 - box.top) / (vh * 0.9);
          if (p < 0) p = 0;
          else if (p > 1) p = 1;
          scrubEls[i].style.setProperty("--p", p.toFixed(3));
        }
      }

      function kickScrub(){
        if (scrubQueued) return;
        scrubQueued = window.requestAnimationFrame(paintScrub);
      }

      function initScrub(){
        scrubEls = [];
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var els = document.querySelectorAll("[data-scrub-words]");
        for (var i = 0; i < els.length; i++) {
          try { splitScrub(els[i]); } catch (e) { continue; }
          scrubEls.push(els[i]);
        }
        if (!scrubEls.length) return;
        if (!scrubWired) {
          scrubWired = true;
          window.addEventListener("scroll", kickScrub, { passive: true });
          window.addEventListener("resize", kickScrub, { passive: true });
        }
        // Sinkron, bukan lewat rAF: `--p` harus benar SEBELUM frame pertama,
        // atau kata-katanya sempat tampil penuh lalu meredup.
        paintScrub();
      }

      function pass(){
        // ── TWO ATTRIBUTES, TWO SCALES, ONE OBSERVER ─────────────────────        // `[data-reveal]` marks an ITEM inside a section (a card, a tile, a
        // row) and is staggered — see motion.css §9. `[data-enter]` marks a
        // whole SECTION BAND and runs once, un-staggered — see §9b. They are
        // separate attributes rather than one because the vocabulary differs
        // (a band has an entrance KIND, an item does not) and because an
        // element carrying both would run two animations on itself.
        //
        // `[data-motion-words]` is the third scale: the TEXT inside a heading
        // (motion.css §10). It is split here, before the box is measured, so
        // the measurement describes the element the visitor will see.
        var targets = document.querySelectorAll("[data-reveal], [data-enter], [data-motion-words]");
        if (!targets.length) return;
        var pending = [];
        for (var i = 0; i < targets.length; i++) {
          var el = targets[i];
          if (el.hasAttribute("data-motion-words")) {
            // A splitter that throws must not leave words at 110% (invisible).
            // `is-visible` is therefore added even if the split failed: plain
            // text is the correct fallback, and it is what the visitor sees.
            try { splitWords(el); } catch (e) { el.classList.add("is-visible"); }
          }
          // `data-reveal` uses `is-revealed`; `data-enter` uses `is-entered`;
          // `data-motion-words` uses `is-visible`. Three markers because the
          // CSS state selectors are different shapes
          // (`html.js-reveal [data-enter="rise"].is-entered`), and collapsing
          // them into one class would make a band that carried both attributes
          // mark itself revealed while its entrance had not run.
          var mark = markFor(el);
          if (el.classList.contains(mark)) continue;
          // Anything already on screen at first paint is revealed IMMEDIATELY
          // rather than observed. Observing it would make above-the-fold
          // content wait for the observer's first callback — one frame of
          // blank, on exactly the content the visitor is looking at.
          var box = el.getBoundingClientRect();
          if (box.top < (window.innerHeight || 0) && box.bottom > 0) el.classList.add(mark);
          else pending.push(el);
        }
        if (!pending.length) return;
        var observer = new IntersectionObserver(function(entries){
          for (var j = 0; j < entries.length; j++) {
            if (!entries[j].isIntersecting) continue;
            var t = entries[j].target;
            /* SATU PENENTU, DUA PEMANGGIL (diperbaiki 2026-11-13). Baris ini
               dulu menulis `hasAttribute("data-enter") ? "is-entered" : MARK`,
               yaitu penentu yang SAMA SEKALI LAIN dari yang dipakai di atas —
               jadi judul `[data-motion-words]` yang masuk layar lewat observer
               mendapat `is-revealed`, bukan `is-visible`. Terukur: 16 dari 16
               judul section TIDAK PERNAH tampil (`revealed: 0/16`) sementara
               teksnya ada di DOM — persis kelas kegagalan yang §10 dan §9
               peringatkan. Sekarang keduanya memanggil `markFor`. */
            t.classList.add(markFor(t));
            // Unobserve: these animations run once. Leaving it attached would
            // re-fire them every time the element scrolled back into view,
            // which reads as a flicker rather than an entrance.
            observer.unobserve(t);
          }
        }, {
          // Start the animation slightly BEFORE the element is fully visible,
          // so it has settled by the time it is properly in frame. A card
          // that begins moving as it arrives is still moving when you look
          // at it; a 12% head start fixes that.
          rootMargin: "0px 0px -12% 0px",
          threshold: 0,
        });
        for (var k = 0; k < pending.length; k++) observer.observe(pending[k]);
        seen.push(observer);
      }

      window.__asjReveal = pass;

      /* ── i18n MENGHAPUS MASKERNYA, JADI DIPASANG ULANG ──────────────────
         `translateDataLang()` (store/i18n.ts) menulis `el.textContent = …`
         pada SETIAP `[data-lang]`, dan judul section membawa atribut itu.
         Akibatnya terukur: 16 judul punya penanda "sudah dipecah" tapi nol
         anak — teksnya utuh, animasinya hilang. Itu terjadi di setiap muat
         halaman, bukan hanya saat bahasa diganti, karena pass i18n berjalan
         setelah hidrasi.

         Hanya PEMECAHAN yang diulang di sini, bukan `pass()`: pass membuat
         IntersectionObserver baru, dan memanggilnya per toggle bahasa akan
         menumpuk observer yang tidak pernah dibuang. */
      document.addEventListener("asj:lang-applied", function(){
        var els = document.querySelectorAll("[data-motion-words]");
        for (var i = 0; i < els.length; i++) {
          try { splitWords(els[i]); } catch (e) { els[i].classList.add("is-visible"); }
          /* Yang SEDANG di layar langsung ditandai. Alasannya bukan
             kehati-hatian berlebih: IntersectionObserver hanya memanggil
             ulang saat status persilangan BERUBAH, dan judul yang sudah
             terlihat saat bahasa diganti tidak berubah statusnya — kata-kata
             hasil pemecahan baru akan duduk di 110% selamanya. */
          var box = els[i].getBoundingClientRect();
          if (box.top < (window.innerHeight || 0) && box.bottom > 0) {
            els[i].classList.add("is-visible");
          }
        }
        /* Paragraf §12 juga kehilangan span-nya oleh penulisan `textContent`
           yang sama. `initScrub` memecah ulang HANYA yang belum punya
           `.u-scrub-w`, dan `paintScrub` langsung menulis `--p` supaya kata
           yang sedang di layar tidak sempat redup. */
        initScrub();
      }, { passive: true });
      // ── JANGAN PERNAH MENUNGGU TANPA BATAS (diperbaiki 2026-10-14) ────────
      // Dulu hanya `window.load` yang memanggil `pass()`. Itu KELIRU, dan
      // salahnya terukur: `js-reveal` sudah dipasang di atas (baris ini), jadi
      // setiap `[data-reveal]` ber-`opacity: 0` TANPA observer yang bisa
      // membatalkannya sampai `load` menyala — sementara `load` menunggu
      // SELURUH subresource.
      //
      // Diukur dengan menunda SATU permintaan gambar (`page.route`, 1280px):
      //
      //   tunda  load       gulir pada  elemen reveal di layar
      //     0ms  353ms      804ms       0 dari 3 tersembunyi   ← benar
      //  6000ms  TIDAK     814ms       3 dari 3 TERSEMBUNYI   ← halaman KOSONG
      //
      // Jadi satu aset lambat membuat pengunjung yang menggulir melihat bagian
      // yang benar-benar kosong (`opacity: 0`, `is-revealed: false`) selama
      // seluruh sisa waktu `load`. Di jaringan lambat itu bisa belasan detik —
      // dan itu persis kebalikan dari doktrin di motion.css §9: "konten yang
      // terbaca selalu mengalahkan konten yang beranimasi".
      //
      // `pass()` idempoten (elemen yang sudah bertanda dilewati), jadi
      // memanggilnya lebih awal aman. `load` TETAP dipanggil: data halaman
      // (jumlah lowongan, pengumuman) mengganti sebagian DOM, dan node
      // pengganti itu perlu diambil oleh pass berikutnya. Timer 2,5 detik
      // adalah jaring terakhir untuk `load` yang tidak pernah menyala.
      /* `pass` tetap dipakai apa adanya oleh `window.__asjReveal` dan oleh
         gerbang e2e; `boot` hanya menambahkan pemecah §12 di belakangnya.
         Urutannya penting: `pass()` lebih dulu, karena ia yang memasang
         `js-reveal` dan observer — kalau §12 dijalankan lebih dulu, kata
         yang dipecahnya belum punya apa pun yang mengembalikannya. */
      function boot(){ pass(); initScrub(); }

      if (document.readyState === "complete") boot();
      else {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", boot, { passive: true, once: true });
        } else {
          boot();
        }
        window.addEventListener("load", boot, { passive: true });
        setTimeout(boot, 2500);
      }

    })();
  </script>
</head>
<!-- PERF: the theme swap used to transition for 500ms. `background-color`
     on <body> is a full-viewport paint, so that was ~30 full-screen
     repaints per toggle. 200ms is still smooth (the curve is out-expo,
     which lands early) and cuts the repaint work by 60%. -->
<body id="asj-body" class="bg-canvas text-fg min-h-screen transition-colors duration-200 flow-root" data-theme-lock={themeLock}>
  <!-- #global-loader DIHAPUS 2026-11-09. Ia `display:none !important` secara
       inline dan TIDAK ADA satu pun kode yang menampilkannya (diperiksa:
       hanya tombolnya sendiri yang menyembunyikan diri). Jadi ia bukan gerbang
       apa pun — ia 1,5 KB markup mati di SETIAP halaman, plus dua <use> ke
       sprite yang tidak pernah terlihat.

       JANGAN dikembalikan tanpa alasan yang bisa diukur. Kalau nanti butuh
       penanda "sedang memuat", pakai skeleton di tempat kontennya (pola yang
       sudah dipakai `LokerTable`), bukan lapisan penutup layar: lapisan
       penutup yang muncul terlambat justru menambah CLS, bukan mengurangi. -->
  <div id="sakura-particles" class="fixed inset-0 u-modal-shell overflow-hidden hidden" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link"><span data-lang="ui.skip_to_content">Lewati ke konten utama</span></a>
  {scrollProgress && <div class="u-scroll-progress" aria-hidden="true" />}
  
    <slot />
  
  {showFooter && <Footer />}

  <!-- Versi build + tombol "Periksa pembaruan". Dipasang di layout, bukan di
       Footer, karena Footer hanya dirender 3 dari 11 halaman sementara halaman
       yang paling sering dipakai (admin, kandidat, master) justru tanpa footer.
       Detail alasan: src/components/VersionBadge.astro. -->
  {showVersionBadge && <VersionBadge padBottom={showBottomNav} />}
  <BottomNav client:only="preact" show={showBottomNav} />

  <!-- Mounted here, once, so it can never be forgotten on a new page.
       It was previously duplicated onto 6 of 9 pages, leaving
       showToast() a silent no-op on ai-cv, master and share. -->
  <Toast client:only="preact" />
  
  <script>
    // ─── Fase 3 (Reactive): Auth restore via authReactive.ts ───
    // Nanostores handles cross-tab sync + session expiry automatically.
    // This script only does DOM manipulation for Astro static elements
    // (Header nav modes) that aren't Preact components yet.
    // ─── Auth managed by Nanostores (authReactive.ts) ───
    // ─── Fase 5: Service Worker + Auto-Reload ───
    if ('serviceWorker' in navigator) {
      // ── WHY LOCALHOST UNREGISTERS, AND THE ONE ESCAPE HATCH ─────────────
      // A dev server that keeps a service worker serves yesterday's bundle
      // forever — that is why this branch exists at all.
      //
      // ⚠ BUT THE SW IS ALSO AN INSTALL CRITERION. Chrome only offers "Install
      // app" (and only fires `beforeinstallprompt`) when a service worker with
      // a fetch handler controls the page. So on localhost the PWA is NOT
      // installable by construction, which is exactly what the owner hit on
      // 2026-11-11: the button could only show instructions because the browser
      // never offered anything. `?pwa=1` opts this tab into the real thing —
      // opt-in, so ordinary development stays cache-free.
      const isLocal =
        location.hostname.includes('localhost') || location.hostname.includes('127.0.0.1');
      const wantsPwa = new URLSearchParams(location.search).get('pwa') === '1';
      if (isLocal && !wantsPwa) {
        navigator.serviceWorker.getRegistrations().then(function(regs) {
          regs.forEach(function(r) { r.unregister(); });
          caches.keys().then(function(ks) { ks.forEach(function(k) { caches.delete(k); }); });
        });
      } else {
        navigator.serviceWorker.register('/sw.js').then((reg) => {
          setInterval(() => { reg.update().catch(() => {}); }, 5 * 60 * 1000);
        }).catch(() => {});
        navigator.serviceWorker.addEventListener('message', (e) => {
          if (e.data?.type === 'ASJ_FORCE_RELOAD') {
            console.log('[SW] New version — reloading...');
            window.location.reload();
          }
        });
      }
    }
  </script>
<script>
  import { translateDataLang, preloadJpDict, applyDocTitle } from '../store/i18n';
  // Preload JP dictionary on client boot and run initial DOM translation
  preloadJpDict();
  translateDataLang();
  // The <title> is server-rendered Indonesian (crawlers and link previews need
  // it in the HTML and cannot run JS), so it has to be re-applied here for a
  // reader who chose Japanese. Without this the tab, the bookmark and the
  // history entry stayed Indonesian for ever — measured 2026-09-27: all 7
  // routes had an identical document.title in both languages.
  applyDocTitle();
  // i18n: listen for language changes and translate [data-lang] elements instantly
  window.addEventListener("asj-lang-change", function() {
    translateDataLang();
    applyDocTitle();
  });
  window.addEventListener("storage", function(e) {
    if (e.key === "asj_lang") {
      translateDataLang();
      applyDocTitle();
    }
  });
</script>
<script>
  /* ─── Sakura petals — the falling-leaves layer ───────────────────────
     RESTORED 2026-09-25 (owner request, item 6). The behaviour is
     recovered verbatim from the legacy app:
       js/init/theme.ts:118-160   the generator + the on/off toggle
       src/main.css:1960-2009     the petal CSS + both keyframes
       src/main.css:2118-2131     the reduced-motion override
     so the port and the original cannot drift.

     WHY THIS LIVES IN BaseLayout AND NOT JapanTexture.astro
     ------------------------------------------------------
     `JapanTexture` is an inline-SVG TILE PATTERN — one bounded decorative
     band (64px `asanoha`/`seigaiha`/sakura motif) that a section opts into
     and positions inside its own box; it is used on exactly one route
     (`src/pages/index.astro`). The falling petals are the opposite: a
     FREE-FLOATING, full-viewport, position-fixed layer that must appear
     on every public page (`/`, `/loker`, `/public`). Folding them into the
     tile component would (a) tie a page-wide layer to a component that
     owns no page-wide state, and (b) mean three copies of the generator,
     one per route. BaseLayout is the ONE shell every route shares, and it
     ALREADY renders the container `#sakura-particles` (line ~262) — this
     script is the missing other half that makes that container live.

     STRUCTURE
     ---------
       1. `makePetals()`  — the 30-petal generator (legacy `buatPartikelSakura`).
       2. `apply(mode)`   — legacy `setSakuraParticles(theme === 'SAKURA')`:
                            the layer is visible ONLY on the light theme.
       3. a `themeStore` subscription + a one-shot boot call.

     ⚠ NO ANGLE-BRACKET GENERICS ANYWHERE IN THIS FILE, including in this
     comment — the indexer parses `.astro` template tags out of comments
     too, and a quoted generic becomes a phantom unresolved component that
     fails `indexer/src/build.test.ts`. This file already warns about the
     same trap near the top.

     THE GUARD IS LOAD-BEARING. Legacy used a module-level
     `SAKURA_PETALS_CREATED` boolean so the 30 petals are built ONCE. A
     theme toggle fires the subscription on EVERY change, so without it the
     layer would grow by 30 nodes per toggle — 60, 90, 120 — and the
     animation would visibly thicken until the page bogged down. */
  import { themeStore } from '../store/theme';

  const PETAL_COUNT = 30;
  let petalsCreated = false;

  function box(): HTMLElement | null {
    return document.getElementById('sakura-particles');
  }

  function makePetals(): void {
    const host = box();
    /* `petalsCreated` is checked BEFORE the `host` guard so a very early
       call (before the container is parsed) does not consume the one-shot
       flag and leave the layer permanently empty. */
    if (!host || petalsCreated) return;
    petalsCreated = true;
    for (let i = 0; i < PETAL_COUNT; i++) {
      const p = document.createElement('div');
      p.className = 'sakura-petal';
      /* Three depth layers (legacy `isHero` / `isFar`):
           hero  every 9th  — large, opaque, fast  (reads as near the camera)
           far   every 7th  — small, blurred, slow (reads as depth)
           rest            — mid */
      const isHero = i % 9 === 0;
      const isFar = i % 7 === 0;
      const size = isFar ? 5 + Math.random() * 4 : isHero ? 16 + Math.random() * 8 : 8 + Math.random() * 9;
      p.style.width = size + 'px';
      p.style.height = size * (0.8 + Math.random() * 0.3) + 'px';
      p.style.left = Math.random() * 100 + '%';
      p.style.opacity = (isHero ? 0.5 + Math.random() * 0.25 : 0.15 + Math.random() * 0.35).toFixed(2);
      p.style.animationDuration = (isHero ? 7 + Math.random() * 5 : 6 + Math.random() * 13) + 's';
      /* NEGATIVE delay: each petal starts mid-flight, so the sky is
         populated from the first frame instead of filling up over 24s. */
      p.style.animationDelay = -Math.random() * 24 + 's';
      /* Two fall tracks; the 45% split keeps them from moving in lockstep. */
      p.style.animationName = Math.random() < 0.45 ? 'sakuraFall2' : 'sakuraFall';
      p.style.transform = 'rotate(' + Math.random() * 360 + 'deg)';
      if (isFar) p.style.filter = 'blur(' + (0.4 + Math.random() * 0.8).toFixed(1) + 'px)';
      host.appendChild(p);
    }
  }

  function apply(mode: string | undefined): void {
    const host = box();
    if (!host) return;
    /* Only the light/"SAKURA" theme shows petals. `themeStore` is the
       single source of truth for dark/light (see src/store/theme.ts); the
       banner's SAKURA/TOKYO artwork is a SEPARATE store that the user can
       override independently, so it is deliberately not consulted here. */
    /* A LOCKED route wins over the store, exactly like `applyTheme`. Without
       this line the landing page renders dark while the stored preference is
       still "light", so the sakura layer stays visible — 30 pink petals over a
       near-black film stage, which is the one thing that broke the frame. */
    if (document.documentElement.dataset.themeLock) {
      host.classList.add('hidden');
      return;
    }
    if (mode === 'light') {
      makePetals();
      host.classList.remove('hidden');
    } else {
      host.classList.add('hidden');
    }
  }

  /* Subscribe first, then read the current value: `persistentAtom` has
     already decoded `asjTheme` from localStorage by import time, so the
     one-shot call paints the right state without waiting for a change. */
  themeStore.subscribe((mode) => apply(mode));
  apply(themeStore.get());
</script>
</body>
</html>
