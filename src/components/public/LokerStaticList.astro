---
/**
 * LokerStaticList.astro — Server-rendered job listing fallback.
 *
 * WHY THIS EXISTS
 * ---------------
 * LokerTable.tsx is a `client:only` island, so with JavaScript disabled the
 * /loker and /public pages render an empty shell. This component fetches the
 * same data at BUILD TIME and renders a static HTML table that crawlers and
 * no-JS visitors can read.
 *
 * ── WHERE THE DATA COMES FROM NOW (2026-10-24) ─────────────────────────────
 * It used to query PostgREST directly with the anon key. MEASURED on the live
 * site that day: the query answers `401 42501 permission denied for table
 * job_database` (hint: `GRANT SELECT … TO anon`), the failure is caught by
 * design, and the result was that **neither page had a static table at all** —
 * `<table` count 0 in the shipped HTML. The fallback existed, was tested, and
 * had never once rendered in production.
 *
 * It now reads the function's public payload through `fetchPublicJobs()`, which
 * is the same contract the island uses in the browser: no GRANT, no view, no
 * service-role key in the build, no new public surface. See that function for
 * the trade-off (a build reads the previous deploy's function code) and for why
 * a content-type check sits next to the status check.
 *
 * The static table is styled to match the site tokens; it is NOT interactive
 * (no filter, no search) — that is what the client island is for. The two
 * tables should not clash: the static one is plain HTML, the client one hydrates
 * on top and replaces the visual if JS is available.
 */
import { fetchPublicJobs } from '../../lib/publicData';
import { siteOrigin } from '../../lib/siteMeta';
import LokerStaticTable from './LokerStaticTable';

/** Same ceiling the old PostgREST query had — the static table is a snapshot. */
const STATIC_JOB_LIMIT = 50;

/** Never throws: an empty list is a valid build (see `fetchPublicJobs`). */
const jobs = await fetchPublicJobs(siteOrigin(), STATIC_JOB_LIMIT);
---

{jobs.length > 0 && (
  <div class="loker-static" data-loker-static>
    <p class="loker-static-hint" data-lang="loker_static.hint">
      Daftar lowongan aktif (diperbarui saat build). Untuk filter dan detail lengkap, aktifkan JavaScript.
    </p>
    <div class="loker-static-scroll">
      {/* The rows live in a `.tsx` primitive: the indexer resolves `.astro`
          template interpolations against the frontmatter scope only, so
          `{jobs.map((j) => …)}` here produced 7 unresolved refs. See the
          component's header for the measurement. */}
      <LokerStaticTable jobs={jobs} />
    </div>
  </div>
)}

{/* `is:global` is required, not lazy: the <table> now comes from a child
    component, and Astro's scoped styles only reach elements written in THIS
    file. Every selector below is prefixed by `.loker-static`, which exists only
    here, so the global block cannot leak. */}
<style is:global>
  .loker-static {
    margin-bottom: 1rem;
  }
  .loker-static-hint {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    margin-bottom: 0.5rem;
  }
  .loker-static-scroll {
    overflow-x: auto;
  }
  .loker-static table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .loker-static th,
  .loker-static td {
    border: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
    padding: 0.5rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .loker-static th {
    background: color-mix(in oklab, var(--color-fg) 7%, transparent);
    font-weight: 700;
    white-space: nowrap;
  }
  .loker-static tr:nth-child(even) {
    background: color-mix(in oklab, var(--color-fg) 3%, transparent);
  }

  /* The live table REPLACES this one — but only once it actually has rows.
     `LokerTable` sets this attribute after its fetch resolves with data.

     It used to be an inline script right below the markup that did
     `el.style.display = 'none'` immediately, under a comment claiming it ran
     "once the client island hydrates". It did not: it ran during parsing, so
     the table was gone BEFORE the island had fetched anything. If that fetch
     failed — offline, API down, a JS error in the island — the page kept the
     heading, the hint and an empty gap, with the server-rendered rows sitting
     in the DOM but hidden. The comment was the only thing that said otherwise.
     Hiding on the island's signal means a failed island degrades to the static
     table instead of to nothing. */
  html[data-loker-live] .loker-static {
    display: none;
  }
</style>
