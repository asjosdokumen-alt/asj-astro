# ENV-BARU-NEON.env — daftar env lengkap untuk akun Netlify baru + DB Neon
#
# ⚠ ISIAN, BUKAN BERKAS .env. Values di bawah adalah PLACEHOLDER atau nilai
# non-rahasia. JANGAN taruh berkas bernama `.env` berisi rahasia di repo — repo
# ini PUBLIK. Isi nilainya langsung di UI Netlify / .env.local (yang gitignored).
#
# Sumber daftar: pembacaan kode langsung (grep `process.env.*`, `env('...')`,
# `import.meta.env.*`) pada 2026-10-20, bukan dari tebakan.
#
# Konvensi tanda:
#   [GANTI NILAI]  -> ada di Netlify sekarang, nilainya harus jadi punya Neon
#   [TAMBAH]       -> belum ada, harus dibuat
#   [HAPUS]        -> tidak diperlukan lagi setelah migrasi
#   [PINDAHKAN]    -> ada di Netlify sekarang, pindahkan APA ADANYA ke akun baru

# ─────────────────────────────────────────────────────────────────────────────
# A. DISINI PERUBAHANNYA
# ─────────────────────────────────────────────────────────────────────────────

# [GANTI NILAI] Origin PostgREST. Backend membaca ini sebagai origin HTTP, lalu
# menambahkan "/rest/v1/" sendiri (lihat _lib/db/client.ts). Karena itu TANPA
# "/rest/v1" di belakang. Ini adalah Neon Data API endpoint proyek Anda.
SUPABASE_URL=https://ep-bold-sunset-b3zy6wb1.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb

# [GANTI NILAI] Bearer token untuk Neon Data API, JWT (bukan kunci Supabase).
# Dibuat di Neon Console -> Data API. Nama variabel SENGAJA tetap SUPABASE_*
# supaya 0 berkas kode tersentuh — alasan lengkapnya di RENCANA 2.5.
SUPABASE_SERVICE_ROLE_KEY=<JWT-DARI-NEON-CONSOLE-DATA-API>

# [TAMBAH] Connection string pooler Neon, untuk script lokal, migrasi, dan
# sanity check dari shell. BUKAN untuk Netlify Function — fungsi tetap HTTP.
# Ambil di Neon Console -> Connection Details -> pilih "Pooled connection".
NEON_DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-bold-sunset-b3zy6wb1-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# [HAPUS] Backend tidak pernah memakai anon key (hanya fallback supabaseKey()).
SUPABASE_ANON_KEY=

# [HAPUS] Hanya dipakai _lib/kernel/db.ts untuk memverifikasi JWT Supabase.
# Setelah auth GoTrue dibuang, tidak ada JWT dari luar yang perlu diverifikasi.
# ⚠ Kalau ternyata masih dipakai untuk sesuatu di luar temuan saya, backend akan
# mati — kalau ragu, biarkan nilainya dulu dan uji Fase 1 dulu sebelum dihapus.
SUPABASE_JWT_SECRET=

# [PINDAHKAN — Storage Supabase TETAP DIPAKAI, lihat RENCANA 2.4 opsi A]
# Dipakai _lib/storage.ts untuk 3 jalur uploadBase64() (CV & dokumen admin).
# Bucket default di kode adalah 'asj-files' kalau ini kosong.
SUPABASE_STORAGE_BUCKET=asj-files

# [HAPUS] Keduanya cuma untuk @supabase/supabase-js di sisi browser, dan auth
# GoTrue tidak dipakai untuk login (terverifikasi: tidak ada pemanggil
# supabase.auth.* di UI). Dibiarkan kosong, getFreshToken() langsung pakai
# authStore — aman.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# B. PINDAHKAN APA ADANYA (tidak berubah karena migrasi)
# Kalau satu saja dari ini hilang, fitur terkait mati TANPA pesan error.
# ─────────────────────────────────────────────────────────────────────────────

# -- Sesi & autentikasi admin ------------------------------------------------
SESSION_SECRET=<WAJIB>
ADMIN_MASTER_PIN=<WAJIB>
ADMIN_PIN=
MASTER_PIN=
ASJ_ADMIN_PASSWORD=
ADMIN_PASSWORD=
ADMIN_MASTER_PASSWORD=
ASJ_ADMINS=<daftar nomor/identifier admin>
ADMIN_NUMBERS=<daftar nomor admin>
PIN_KHOCI=<PIN>
PIN_SACHOU=<PIN>
PIN_AYOK=<PIN>
PIN_KHOLIS=<PIN>
PIN_BU_SARI=<PIN>

# -- WhatsApp (Fonnte) --------------------------------------------------------
FONNTE_TOKEN=<WAJIB>
FONNTE_API_KEY=

# -- Cloudinary (berkas kandidat & template CV) ------------------------------
# CLOUDINARY_URL dibaca otomatis oleh paket cloudinary di sisi server.
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
# Kedua PUBLIC_ ini DI-BAKE saat build. Kalau tidak diset DI SEBELUM deploy
# pertama, halaman yang sudah rilis memakai nilai yang tidak ada.
PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud name>
PUBLIC_CLOUDINARY_UPLOAD_PRESET=<unsigned preset>

# -- AI (CV parsing, isian otomatis) -----------------------------------------
GEMINI_API_KEY=<WAJIB>
XAI_API_KEY=
GROQ_API_KEY=

# -- Push notification (FCM) --------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=<JSON service account, SATU BARIS>

# -- URL & asal yang diizinkan -------------------------------------------------
NETLIFY_SITE_URL=https://asjastro.netlify.app
APP_ORIGIN=
SITE_URL=
# Allow-list host dokumen. HARUS memuat res.cloudinary.com dan (kalau Storage
# Supabase dipertahankan) host Storage proyek Supabase. Kalau host Storage
# dibuang tanpa memindah berkas, dokumen lama tidak bisa dibuka.
ALLOWED_DOCUMENT_HOSTS=res.cloudinary.com,<storage-host-supabase-kalau-ada>

# -- Observability -------------------------------------------------------------
HEALTH_TOKEN=<token untuk /health>
LOG_LEVEL=
LOG_DRAIN_TOKEN=
SENTRY_DSN=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_BASIC_AUTH_HEADER=
METRICS_SINK_URL=
METRICS_SINK_TOKEN=
METRICS_RECEIVER_TOKEN=
METRICS_NOTIFY_URL=

# -- build environment (ditetapkan Netlify, bukan rahasia) -------------------
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# C. YANG TIDAK PERLU DI-ENV SAMA SEKALI
# ─────────────────────────────────────────────────────────────────────────────
# Direct_Connection_DB  -> hanya ada di .env.local Anda. Tidak dibaca kode
#                          produksi mana pun (terverifikasi via grep). Termasuk
#                          juga SUPABASE_DB_URL. Untuk akses DB langsung, pakai
#                          NEON_DATABASE_URL di atas.
# NETLIFY_AUTH_TOKEN    -> jangan. Jangan pernah masuk ke env situs.
#                          Token ini sudah pernah ter-commit dan sudah di-revoke
#                          (2026-10-14) — jangan diulang.
